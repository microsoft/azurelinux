<?xml version="1.0" encoding="utf-8"?>
<image>
    <profiles>
        <profile name="OnePPackages" description="Boot-neutral first-party Azure VM packages" import="false">
            <requires profile="VmBasePackages" />
        </profile>
        <profile name="OnePBase" description="Conventional first-party Azure VM composition" import="false">
            <requires profile="VmBaseCore" />
            <requires profile="OnePPackages" />
        </profile>
        <profile name="1p-vm-base-gen1" description="1P VM Base Gen1 Image (BIOS)" import="false">
            <requires profile="PackageManagement" />
            <requires profile="LegacyBoot" />
            <requires profile="OnePBase" />
        </profile>
        <profile name="1p-vm-base-gen1-fips" description="1P VM Base Gen1 FIPS Image (BIOS)" import="false">
            <requires profile="PackageManagement" />
            <requires profile="Fips" />
            <requires profile="LegacyBoot" />
            <requires profile="OnePBase" />
        </profile>
        <profile name="1p-vm-base-gen2-fips" description="1P VM Base Gen2 FIPS Image (UEFI)" import="false">
            <requires profile="PackageManagement" />
            <requires profile="Fips" />
            <requires profile="UefiBoot" />
            <requires profile="OnePBase" />
        </profile>
        <profile name="CvmCore" description="First-party confidential VM boot packages" import="false">
            <requires profile="OnePPackages" />
        </profile>
        <profile name="1p-vm-base-gen2-cvm" description="First-party Gen2 confidential VM image (shim, systemd-boot, UKI)" import="false">
            <requires profile="PackageManagement" />
            <requires profile="UefiFstab" />
            <requires profile="CvmCore" />
        </profile>
    </profiles>
    <preferences arch="x86_64" profiles="1p-vm-base-gen1">
        <version>0.1</version>
        <packagemanager>dnf5</packagemanager>
        <locale>en_US</locale>
        <keytable>us</keytable>
        <timezone>UTC</timezone>
        <release-version>4.0</release-version>
        <type image="oem" format="vhd-fixed" formatoptions="force_size" initrd_system="dracut" filesystem="ext4" fscreateoptions="-m 1" kernelcmdline="console=ttyS0 rd.shell=0" firmware="bios" overlayroot="false" eficsm="false" bootpartition="false" rootfs_label="azurelinux">
            <bootloader name="grub2" bls="true" console="serial" timeout="1" />
            <size unit="G">5</size>
            <oemconfig>
                <oem-resize>false</oem-resize>
            </oemconfig>
        </type>
    </preferences>
