+++ b/glib/tests/hmac-openssl/fixture-api.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <stdint.h>
+
+typedef enum
+{
+  GLIB_TEST_CRYPTO_MODE_SUCCESS = 0,
+  GLIB_TEST_CRYPTO_MODE_FETCH_NULL = 1,
+  GLIB_TEST_CRYPTO_MODE_CTX_NEW_NULL = 2,
+  GLIB_TEST_CRYPTO_MODE_INIT_FAIL = 3,
+  GLIB_TEST_CRYPTO_MODE_INITIAL_SIZE_ZERO = 4,
+  GLIB_TEST_CRYPTO_MODE_INITIAL_SIZE_MISMATCH = 5,
+  GLIB_TEST_CRYPTO_MODE_UPDATE_FAIL = 6,
+  GLIB_TEST_CRYPTO_MODE_DUP_FAIL = 7,
+  GLIB_TEST_CRYPTO_MODE_FINAL_FAIL = 8,
+  GLIB_TEST_CRYPTO_MODE_FINAL_WRONG_SIZE = 9,
+} GlibTestCryptoMode;
+
+typedef struct
+{
+  uint64_t fetch_calls;
+  uint64_t fetch_failures;
+  uint64_t mac_free_calls;
+  uint64_t ctx_new_calls;
+  uint64_t ctx_new_failures;
+  uint64_t ctx_free_calls;
+  uint64_t ctx_dup_calls;
+  uint64_t ctx_dup_failures;
+  uint64_t ctx_get_size_calls;
+  uint64_t init_calls;
+  uint64_t init_failures;
+  uint64_t update_calls;
+  uint64_t update_failures;
+  uint64_t final_calls;
+  uint64_t final_failures;
+  uint64_t final_wrong_size_calls;
+  uint64_t digest_param_ok;
+  uint64_t digest_param_bad;
+  uint64_t empty_key_nonnull;
+  uint64_t empty_key_null;
+  uint64_t key_bytes_seen;
+  uint64_t tls_queue_count;
+  uint64_t err_set_mark_calls;
+  uint64_t err_pop_to_mark_calls;
+  uint64_t err_clear_error_calls;
+  uint64_t live_mac_objects;
+  uint64_t live_ctx_objects;
+} GlibTestCryptoCounters;
+
+const char *glib_test_crypto_identity (void);
+void glib_test_crypto_reset_state (void);
+void glib_test_crypto_set_mode (int mode);
+void glib_test_crypto_set_mark_behavior (int enabled);
+void glib_test_crypto_seed_queue (unsigned count);
+unsigned glib_test_crypto_get_queue_count (void);
+uint64_t glib_test_crypto_get_queue_fingerprint (void);
+void glib_test_crypto_get_counters (GlibTestCryptoCounters *out);
diff --git a/glib/tests/hmac-openssl/missing-symbol/crypto.c b/glib/tests/hmac-openssl/missing-symbol/crypto.c
new file mode 100644
index 0000000000000000000000000000000000000000..b544de34a14c1be10d42440fe1d4dd7f55dc7cc5
--- /dev/null
+++ b/glib/tests/hmac-openssl/missing-symbol/crypto.c
@@ -0,0 +1,161 @@
+#include "../fixture-api.h"
+
+#include <openssl/core_names.h>
+#include <openssl/err.h>
+#include <openssl/evp.h>
+#include <openssl/params.h>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define EXPORT __attribute__((visibility("default")))
+
+typedef struct
+{
+  size_t mac_size;
+  uint64_t total_len;
+} FakeMacCtx;
+
+EXPORT const char *
+glib_test_crypto_identity (void)
+{
+  return "missing-symbol-fixture";
+}
+
+__attribute__((destructor))
+static void
+missing_symbol_destructor (void)
+{
+  static const char marker[] = "GLIB_TEST_FAKE_CRYPTO_MISSING_SYMBOL_DTOR\n";
+  size_t remaining = sizeof (marker) - 1;
+  const char *p = marker;
+
+  while (remaining > 0)
+    {
+      ssize_t n = write (2, p, remaining);
+      if (n <= 0)
+        break;
+      p += (size_t) n;
+      remaining -= (size_t) n;
+    }
+}
+
+EXPORT EVP_MAC *
+EVP_MAC_fetch (OSSL_LIB_CTX *libctx, const char *algorithm, const char *properties)
+{
+  (void) libctx;
+  (void) properties;
+  if (algorithm == NULL || strcmp (algorithm, "HMAC") != 0)
+    return NULL;
+  return (EVP_MAC *) (uintptr_t) 0x1;
+}
+
+EXPORT void
+EVP_MAC_free (EVP_MAC *mac)
+{
+  (void) mac;
+}
+
+EXPORT EVP_MAC_CTX *
+EVP_MAC_CTX_new (EVP_MAC *mac)
+{
+  FakeMacCtx *ctx;
+  (void) mac;
+
+  ctx = calloc (1, sizeof (*ctx));
+  if (ctx == NULL)
+    return NULL;
+  ctx->mac_size = 32;
+  return (EVP_MAC_CTX *) ctx;
+}
+
+EXPORT void
+EVP_MAC_CTX_free (EVP_MAC_CTX *ctx)
+{
+  free ((FakeMacCtx *) ctx);
+}
+
+EXPORT EVP_MAC_CTX *
+EVP_MAC_CTX_dup (const EVP_MAC_CTX *src)
+{
+  const FakeMacCtx *src_ctx = (const FakeMacCtx *) src;
+  FakeMacCtx *copy = calloc (1, sizeof (*copy));
+  if (copy == NULL)
+    return NULL;
+  *copy = *src_ctx;
+  return (EVP_MAC_CTX *) copy;
+}
+
+EXPORT size_t
+EVP_MAC_CTX_get_mac_size (EVP_MAC_CTX *ctx)
+{
+  return ((FakeMacCtx *) ctx)->mac_size;
+}
+
+EXPORT int
+EVP_MAC_init (EVP_MAC_CTX         *ctx,
+              const unsigned char *key,
+              size_t               keylen,
+              const OSSL_PARAM     params[])
+{
+  FakeMacCtx *fake_ctx = (FakeMacCtx *) ctx;
+  const OSSL_PARAM *param;
+  const char *digest_name = "SHA256";
+
+  (void) key;
+  (void) keylen;
+
+  for (param = params; param != NULL && param->key != NULL; param++)
+    {
+      if (strcmp (param->key, OSSL_MAC_PARAM_DIGEST) == 0 && param->data != NULL)
+        {
+          digest_name = (const char *) param->data;
+          break;
+        }
+    }
+
+  if (strcmp (digest_name, "SHA512") == 0)
+    fake_ctx->mac_size = 64;
+  else if (strcmp (digest_name, "SHA384") == 0)
+    fake_ctx->mac_size = 48;
+  else if (strcmp (digest_name, "SHA1") == 0)
+    fake_ctx->mac_size = 20;
+  else if (strcmp (digest_name, "MD5") == 0)
+    fake_ctx->mac_size = 16;
+  else
+    fake_ctx->mac_size = 32;
+
+  fake_ctx->total_len = 0;
+  return 1;
+}
+
+EXPORT int
+EVP_MAC_update (EVP_MAC_CTX *ctx, const unsigned char *data, size_t datalen)
+{
+  FakeMacCtx *fake_ctx = (FakeMacCtx *) ctx;
+  if (data != NULL || datalen == 0)
+    fake_ctx->total_len += datalen;
+  return 1;
+}
+
+/* Intentionally omit EVP_MAC_final to force late-symbol resolution failure. */
+
+EXPORT int
+ERR_set_mark (void)
+{
+  return 1;
+}
+
+EXPORT int
+ERR_pop_to_mark (void)
+{
+  return 1;
+}
+
+EXPORT void
+ERR_clear_error (void)
+{
+}
