+typedef struct
+{
+  GMutex lock;
+  GCond ready_cond;
+  GCond start_cond;
+  gint ready_count;
+  gboolean start;
+  gint null_results;
+  gint thread_failures;
+  gint warning_count;
+  gint reentrant_handler_invoked;
+  gint reentrant_construct_seen_null;
+} ConcurrentWarningContext;
+
+static ConcurrentWarningContext *current_warning_context = NULL;
+
+static gboolean
+is_expected_loader_warning (const gchar    *message,
+                            GLogLevelFlags  log_level)
+{
+  return (log_level & G_LOG_LEVEL_WARNING) != 0 &&
+         message != NULL &&
+         g_str_has_prefix (message, "Cannot use GHmac: failed to resolve EVP_MAC_final");
+}
+
+static gboolean
+reentrant_warning_not_fatal (const gchar    *log_domain,
+                             GLogLevelFlags  log_level,
+                             const gchar    *message,
+                             gpointer        user_data)
+{
+  GHmac *tmp = NULL;
+  (void) log_domain;
+  (void) user_data;
+
+  if (current_warning_context != NULL &&
+      is_expected_loader_warning (message, log_level))
+    {
+      g_atomic_int_inc (&current_warning_context->warning_count);
+      if (g_atomic_int_compare_and_exchange (&current_warning_context->reentrant_handler_invoked, 0, 1))
+        {
+          tmp = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+          if (tmp == NULL)
+            g_atomic_int_set (&current_warning_context->reentrant_construct_seen_null, 1);
+          else
+            {
+              g_atomic_int_set (&current_warning_context->reentrant_construct_seen_null, -1);
+              g_hmac_unref (tmp);
+            }
+        }
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+typedef struct
+{
+  ConcurrentWarningContext *ctx;
+} ConcurrentWarningWorkerArg;
+
+static gpointer
+concurrent_warning_worker (gpointer data)
+{
+  ConcurrentWarningWorkerArg *arg = data;
+  ConcurrentWarningContext *ctx = arg->ctx;
+  GHmac *hmac;
+
+  g_mutex_lock (&ctx->lock);
+  ctx->ready_count++;
+  g_cond_signal (&ctx->ready_cond);
+  while (!ctx->start)
+    g_cond_wait (&ctx->start_cond, &ctx->lock);
+  g_mutex_unlock (&ctx->lock);
+
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  if (hmac == NULL)
+    g_atomic_int_inc (&ctx->null_results);
+  else
+    {
+      g_atomic_int_inc (&ctx->thread_failures);
+      g_hmac_unref (hmac);
+    }
+
+  return NULL;
+}
+
+static void
+run_reentrant_concurrent_warning_child (void)
+{
+  static const guint n_threads = 8;
+  ConcurrentWarningContext ctx;
+  ConcurrentWarningWorkerArg args[8];
+  GThread *threads[8] = { 0, };
+  guint i;
+
+  memset (&ctx, 0, sizeof (ctx));
+  g_mutex_init (&ctx.lock);
+  g_cond_init (&ctx.ready_cond);
+  g_cond_init (&ctx.start_cond);
+
+  current_warning_context = &ctx;
+  g_test_log_set_fatal_handler (reentrant_warning_not_fatal, NULL);
+
+  for (i = 0; i < n_threads; i++)
+    {
+      args[i].ctx = &ctx;
+      threads[i] = g_thread_new ("warn-concurrent-loader", concurrent_warning_worker, &args[i]);
+      g_assert_nonnull (threads[i]);
+    }
+
+  g_mutex_lock (&ctx.lock);
+  while (ctx.ready_count < (gint) n_threads)
+    {
+      gint64 deadline = g_get_monotonic_time () + 10 * G_TIME_SPAN_SECOND;
+      g_assert_true (g_cond_wait_until (&ctx.ready_cond, &ctx.lock, deadline));
+    }
+  ctx.start = TRUE;
+  g_cond_broadcast (&ctx.start_cond);
+  g_mutex_unlock (&ctx.lock);
+
+  for (i = 0; i < n_threads; i++)
+    g_thread_join (threads[i]);
+
+  g_assert_cmpint (g_atomic_int_get (&ctx.thread_failures), ==, 0);
+  g_assert_cmpint (g_atomic_int_get (&ctx.null_results), ==, (gint) n_threads);
+  g_assert_cmpint (g_atomic_int_get (&ctx.warning_count), ==, 1);
+  g_assert_cmpint (g_atomic_int_get (&ctx.reentrant_handler_invoked), ==, 1);
+  g_assert_cmpint (g_atomic_int_get (&ctx.reentrant_construct_seen_null), ==, 1);
+  current_warning_context = NULL;
+  current_warning_context = NULL;
+  g_cond_clear (&ctx.start_cond);
+  g_cond_clear (&ctx.ready_cond);
+  g_mutex_clear (&ctx.lock);
+}
