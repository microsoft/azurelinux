diff --git a/glib/tests/hmac-openssl-first-load.c b/glib/tests/hmac-openssl-first-load.c
new file mode 100644
index 0000000000000000000000000000000000000000..40a9c9c8dccc04860afac63e44d60ef3d8e8c46b
--- /dev/null
+++ b/glib/tests/hmac-openssl-first-load.c
@@ -0,0 +1,174 @@
+#include <glib.h>
+
+static const gchar *expected_sha256_abc =
+  "9c196e32dc0175f86f4b1cb89289d6619de6bee699e4c378e68309ed97a1a6ab";
+
+static gboolean
+maps_contains (const gchar *needle)
+{
+  g_autofree gchar *contents = NULL;
+  gsize length = 0;
+
+  if (!g_file_get_contents ("/proc/self/maps", &contents, &length, NULL))
+    g_error ("failed to read /proc/self/maps");
+
+  return strstr (contents, needle) != NULL;
+}
+
+static gchar *
+maps_first_path_containing (const gchar *needle)
+{
+  g_autofree gchar *contents = NULL;
+  g_auto(GStrv) lines = NULL;
+  gsize length = 0;
+  guint i;
+
+  if (!g_file_get_contents ("/proc/self/maps", &contents, &length, NULL))
+    g_error ("failed to read /proc/self/maps");
+
+  lines = g_strsplit (contents, "\n", -1);
+  for (i = 0; lines[i] != NULL; i++)
+    {
+      const gchar *path;
+
+      if (strstr (lines[i], needle) == NULL)
+        continue;
+
+      path = strchr (lines[i], '/');
+      if (path != NULL)
+        return g_strdup (path);
+    }
+
+  return NULL;
+}
+
+static gchar *
+maps_loaded_provider_modules (void)
+{
+  g_autofree gchar *contents = NULL;
+  g_auto(GStrv) lines = NULL;
+  g_autoptr(GString) modules = g_string_new ("");
+  gsize length = 0;
+  guint i;
+
+  if (!g_file_get_contents ("/proc/self/maps", &contents, &length, NULL))
+    g_error ("failed to read /proc/self/maps");
+
+  lines = g_strsplit (contents, "\n", -1);
+  for (i = 0; lines[i] != NULL; i++)
+    {
+      const gchar *path;
+
+      if (strstr (lines[i], ".so") == NULL)
+        continue;
+      if (strstr (lines[i], "ossl-modules") == NULL &&
+          strstr (lines[i], "providers") == NULL)
+        continue;
+
+      path = strchr (lines[i], '/');
+      if (path == NULL)
+        continue;
+
+      if (modules->len > 0)
+        g_string_append (modules, " | ");
+      g_string_append (modules, path);
+    }
+
+  return g_string_free (g_steal_pointer (&modules), FALSE);
+}
+
+static void
+assert_expected_provider_paths_and_hashes (const gchar *provider_modules)
+{
+  const gchar *expected_paths_env = g_getenv ("GLIB_TEST_EXPECTED_PROVIDER_PATHS");
+  const gchar *expected_hash_pairs_env = g_getenv ("GLIB_TEST_EXPECTED_PROVIDER_HASH_PAIRS");
+  g_auto(GStrv) expected_paths = NULL;
+  g_auto(GStrv) expected_hash_pairs = NULL;
+  guint i;
+
+  if (expected_paths_env != NULL && *expected_paths_env != '\0')
+    {
+      g_assert_nonnull (provider_modules);
+      expected_paths = g_strsplit (expected_paths_env, ":", -1);
+
+      for (i = 0; expected_paths[i] != NULL; i++)
+        {
+          if (expected_paths[i][0] == '\0')
+            continue;
+          g_assert_nonnull (strstr (provider_modules, expected_paths[i]));
+        }
+    }
+
+  if (expected_hash_pairs_env == NULL || *expected_hash_pairs_env == '\0')
+    return;
+
+  expected_hash_pairs = g_strsplit (expected_hash_pairs_env, ";", -1);
+  for (i = 0; expected_hash_pairs[i] != NULL; i++)
+    {
+      g_auto(GStrv) parts = NULL;
+      g_autofree gchar *contents = NULL;
+      g_autofree gchar *actual_hash = NULL;
+      g_autoptr(GChecksum) checksum = NULL;
+      gsize len = 0;
+
+      if (expected_hash_pairs[i][0] == '\0')
+        continue;
+
+      parts = g_strsplit (expected_hash_pairs[i], "|", 2);
+      g_assert_nonnull (parts[0]);
+      g_assert_nonnull (parts[1]);
+      g_assert_true (g_file_get_contents (parts[0], &contents, &len, NULL));
+      checksum = g_checksum_new (G_CHECKSUM_SHA256);
+      g_checksum_update (checksum, (const guchar *) contents, len);
+      actual_hash = g_strdup (g_checksum_get_string (checksum));
+      g_assert_cmpstr (actual_hash, ==, parts[1]);
+    }
+}
+
+static void
+test_ghmac_first_load_real_runtime (void)
+{
+  GHmac *hmac;
+  const gchar *digest;
+  g_autofree gchar *libcrypto_path = NULL;
+  g_autofree gchar *provider_modules = NULL;
+  const gchar *openssl_conf = g_getenv ("OPENSSL_CONF");
+  const gchar *openssl_modules = g_getenv ("OPENSSL_MODULES");
+
+  g_assert_false (maps_contains ("libcrypto.so.3"));
+  g_assert_false (maps_contains ("/hmac-openssl/"));
+
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (hmac);
+  g_hmac_update (hmac, (const guchar *) "abc", 3);
+  digest = g_hmac_get_string (hmac);
+  g_assert_cmpstr (digest, ==, expected_sha256_abc);
+  g_hmac_unref (hmac);
+
+  g_assert_true (maps_contains ("libcrypto.so.3"));
+  libcrypto_path = maps_first_path_containing ("libcrypto.so.3");
+  g_assert_nonnull (libcrypto_path);
+  g_test_message ("GHmac first-load mapped libcrypto: %s", libcrypto_path);
+
+  g_test_message ("OPENSSL_CONF: %s", openssl_conf != NULL ? openssl_conf : "<unset>");
+  g_test_message ("OPENSSL_MODULES: %s", openssl_modules != NULL ? openssl_modules : "<unset>");
+
+  provider_modules = maps_loaded_provider_modules ();
+  if (provider_modules != NULL && *provider_modules != '\0')
+    g_test_message ("loaded provider modules: %s", provider_modules);
+  else
+    g_test_message ("loaded provider modules: <none observed; builtin/default provider path>");
+
+  assert_expected_provider_paths_and_hashes (provider_modules);
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/hmac/openssl/first-load/rtld-local-runtime",
+                   test_ghmac_first_load_real_runtime);
+
+  return g_test_run ();
+}
diff --git a/glib/tests/hmac-openssl-policy.c b/glib/tests/hmac-openssl-policy.c
new file mode 100644
index 0000000000000000000000000000000000000000..4e6b036aad9f24f77fa6706e1db8f9d492db95d5
--- /dev/null
+++ b/glib/tests/hmac-openssl-policy.c
@@ -0,0 +1,735 @@
+#include <glib.h>
+
+#include <dlfcn.h>
+#include <openssl/conf.h>
+#include <openssl/core_names.h>
+#include <openssl/crypto.h>
+#include <openssl/err.h>
+#include <openssl/evp.h>
+#include <openssl/params.h>
+#include <openssl/provider.h>
+#include <string.h>
+
+static const gint64 SUBPROCESS_TIMEOUT_US = 30 * G_TIME_SPAN_SECOND;
+
+typedef struct
+{
+  GChecksumType digest_type;
+  const gchar *name;
+  const guint8 *key;
+  gsize key_len;
+  const guint8 *data;
+  gsize data_len;
+  const gchar *expected_hex;
+} KatCase;
+
+static const guint8 common_key[] = { 'k', 'e', 'y' };
+static const guint8 common_data[] = "The quick brown fox jumps over the lazy dog";
+static const gchar *expected_sha256_abcdef = "4c5277d3e85316d1762c7e219862a9440546171f5ae5f1b29499ff9fbdd4c56a";
+
+static const KatCase kat_cases[] = {
+  { G_CHECKSUM_MD5, "md5", common_key, 3, common_data, sizeof (common_data) - 1,
+    "80070713463e7749b90c2dc24911e275" },
+  { G_CHECKSUM_SHA1, "sha1", common_key, 3, common_data, sizeof (common_data) - 1,
+    "de7c9b85b8b78aa6bc8a7a36f70a90701c9db4d9" },
+  { G_CHECKSUM_SHA256, "sha256", common_key, 3, common_data, sizeof (common_data) - 1,
+    "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8" },
+  { G_CHECKSUM_SHA384, "sha384", common_key, 3, common_data, sizeof (common_data) - 1,
+    "d7f4727e2c0b39ae0f1e40cc96f60242d5b7801841cea6fc592c5d3e1ae50700"
+    "582a96cf35e1e554995fe4e03381c237" },
+  { G_CHECKSUM_SHA512, "sha512", common_key, 3, common_data, sizeof (common_data) - 1,
+    "b42af09057bac1e2d41708e48a902e09b5ff7f12ab428a4fe86653c73dd248fb"
+    "82f948a549f7b791a5b41915ee4d1ec3935357e4e2317250d0372afa2ebeeb3a" },
+};
+
+typedef struct
+{
+  guint count;
+  unsigned long values[16];
+} ErrorQueueSnapshot;
+
+typedef struct
+{
+  gboolean config_discovered;
+  gboolean config_readable;
+  gboolean config_parsed;
+  gboolean default_properties_established;
+  gboolean fips_enabled;
+  gchar *config_path;
+  gchar *config_sha256;
+  gchar *config_parse_note;
+  gchar *configured_default_properties;
+  gchar *restore_query;
+  gchar *openssl_conf;
+  gchar *openssl_modules;
+  gchar *provider_names;
+} BaselineProfile;
+
+static gchar **
+build_clean_envp (void)
+{
+  gchar **envp = g_get_environ ();
+  const gchar *old_path = g_environ_getenv (envp, "LD_LIBRARY_PATH");
+  g_auto(GStrv) parts = NULL;
+  GString *rebuilt = NULL;
+  guint i;
+
+  envp = g_environ_unsetenv (g_steal_pointer (&envp), "LD_PRELOAD");
+  envp = g_environ_unsetenv (g_steal_pointer (&envp), "LD_AUDIT");
+
+  if (old_path == NULL || old_path[0] == '\0')
+    return envp;
+
+  parts = g_strsplit (old_path, ":", -1);
+  rebuilt = g_string_new ("");
+
+  for (i = 0; parts[i] != NULL; i++)
+    {
+      if (parts[i][0] == '\0')
+        continue;
+      if (strstr (parts[i], "/hmac-openssl/") != NULL)
+        continue;
+
+      if (rebuilt->len > 0)
+        g_string_append_c (rebuilt, ':');
+      g_string_append (rebuilt, parts[i]);
+    }
+
+  if (rebuilt->len > 0)
+    envp = g_environ_setenv (g_steal_pointer (&envp), "LD_LIBRARY_PATH", rebuilt->str, TRUE);
+  else
+    envp = g_environ_unsetenv (g_steal_pointer (&envp), "LD_LIBRARY_PATH");
+
+  g_string_free (g_steal_pointer (&rebuilt), TRUE);
+  return envp;
+}
+
+static void
+snapshot_error_queue (ErrorQueueSnapshot *snapshot)
+{
+  guint i = 0;
+
+  memset (snapshot, 0, sizeof (*snapshot));
+  while (i < G_N_ELEMENTS (snapshot->values))
+    {
+      unsigned long value = ERR_get_error ();
+      if (value == 0)
+        break;
+      snapshot->values[i++] = value;
+    }
+
+  snapshot->count = i;
+}
+
+static void
+assert_error_queue_exact (const ErrorQueueSnapshot *expected)
+{
+  ErrorQueueSnapshot actual;
+  guint i;
+
+  snapshot_error_queue (&actual);
+  g_assert_cmpuint (actual.count, ==, expected->count);
+  for (i = 0; i < expected->count; i++)
+    g_assert_cmphex (actual.values[i], ==, expected->values[i]);
+}
+
+static void
+seed_user_errors (ErrorQueueSnapshot *snapshot)
+{
+  ERR_clear_error ();
+  ERR_raise (ERR_LIB_USER, 0x101);
+  ERR_raise (ERR_LIB_USER, 0x202);
+
+  memset (snapshot, 0, sizeof (*snapshot));
+  snapshot->count = 2;
+  snapshot->values[0] = ERR_peek_error ();
+  snapshot->values[1] = ERR_peek_last_error ();
+  g_assert_cmphex (snapshot->values[0], !=, 0);
+  g_assert_cmphex (snapshot->values[1], !=, 0);
+}
+
+static int
+collect_provider_name (OSSL_PROVIDER *provider,
+                       void          *user_data)
+{
+  GString *names = user_data;
+  const gchar *provider_name = OSSL_PROVIDER_get0_name (provider);
+
+  if (provider_name == NULL)
+    return 1;
+
+  if (names->len > 0)
+    g_string_append (names, ",");
+  g_string_append (names, provider_name);
+  return 1;
+}
+
+static gchar *
+collect_provider_names (OSSL_LIB_CTX *ctx)
+{
+  g_autoptr(GString) names = g_string_new ("");
+
+  OSSL_PROVIDER_do_all (ctx, collect_provider_name, names);
+  return g_string_free (g_steal_pointer (&names), FALSE);
+}
+
+static gchar *
+resolve_config_path (void)
+{
+  char *default_path = NULL;
+  gchar *result = NULL;
+
+  default_path = CONF_get1_default_config_file ();
+  if (default_path != NULL)
+    {
+      result = g_strdup (default_path);
+      OPENSSL_free (default_path);
+    }
+
+  if (g_getenv ("OPENSSL_CONF") != NULL && *g_getenv ("OPENSSL_CONF") != '\0')
+    {
+      g_free (result);
+      result = g_strdup (g_getenv ("OPENSSL_CONF"));
+    }
+
+  return result;
+}
+
+static gchar *
+compute_file_sha256 (const gchar *path)
+{
+  g_autofree gchar *contents = NULL;
+  gsize length = 0;
+  g_autoptr(GChecksum) checksum = NULL;
+
+  if (!g_file_get_contents (path, &contents, &length, NULL))
+    return NULL;
+
+  checksum = g_checksum_new (G_CHECKSUM_SHA256);
+  g_checksum_update (checksum, (const guchar *) contents, length);
+  return g_strdup (g_checksum_get_string (checksum));
+}
+
+static gchar *
+read_config_default_properties (void)
+{
+  CONF *conf = NULL;
+  g_autofree gchar *config_path = NULL;
+  const gchar *openssl_conf;
+  const gchar *alg_section;
+  const gchar *default_properties;
+  long error_line = 0;
+  gboolean marked;
+  gchar *result = NULL;
+
+  marked = ERR_set_mark () == 1;
+  config_path = resolve_config_path ();
+
+  if (config_path == NULL)
+    return NULL;
+
+  if (!g_file_test (config_path, G_FILE_TEST_EXISTS))
+    goto out;
+
+  if (!g_file_test (config_path, G_FILE_TEST_IS_REGULAR))
+    g_error ("OpenSSL config path is not a regular file: %s", config_path);
+
+  {
+    g_autofree gchar *config_sha256 = compute_file_sha256 (config_path);
+    if (config_sha256 == NULL)
+      g_error ("failed to read OpenSSL config file: %s", config_path);
+  }
+
+  conf = NCONF_new (NULL);
+  if (conf == NULL)
+    g_error ("NCONF_new failed while parsing OpenSSL config");
+
+  if (NCONF_load (conf, config_path, &error_line) <= 0)
+    g_error ("NCONF_load failed for %s at line %ld", config_path, error_line);
+
+  openssl_conf = NCONF_get_string (conf, NULL, "openssl_conf");
+  if (openssl_conf == NULL)
+    goto out;
+
+  alg_section = NCONF_get_string (conf, openssl_conf, "alg_section");
+  if (alg_section == NULL)
+    goto out;
+
+  default_properties = NCONF_get_string (conf, alg_section, "default_properties");
+  if (default_properties != NULL)
+    result = g_strdup (default_properties);
+
+out:
+  if (conf != NULL)
+    NCONF_free (conf);
+
+  if (marked)
+    ERR_pop_to_mark ();
+  else
+    ERR_clear_error ();
+
+  return result;
+}
+
+static BaselineProfile
+capture_baseline_profile (OSSL_LIB_CTX *ctx)
+{
+  BaselineProfile profile = { 0 };
+
+  if (ctx == NULL)
+    {
+      profile.config_path = resolve_config_path ();
+      profile.config_discovered = profile.config_path != NULL;
+      if (profile.config_path != NULL)
+        {
+          if (!g_file_test (profile.config_path, G_FILE_TEST_EXISTS))
+            g_error ("OpenSSL config path does not exist: %s", profile.config_path);
+
+          profile.config_sha256 = compute_file_sha256 (profile.config_path);
+          if (profile.config_sha256 == NULL)
+            g_error ("unable to hash OpenSSL config path: %s", profile.config_path);
+
+          profile.config_readable = TRUE;
+          profile.config_parsed = TRUE;
+        }
+
+      profile.configured_default_properties = read_config_default_properties ();
+      profile.default_properties_established = profile.configured_default_properties != NULL;
+      profile.restore_query = g_strdup (profile.configured_default_properties != NULL ?
+                                        profile.configured_default_properties : "");
+      profile.config_parse_note = g_strdup (profile.default_properties_established ?
+                                            "default_properties established from config" :
+                                            "default_properties absent in config");
+    }
+  else
+    {
+      g_assert_cmpint (EVP_set_default_properties (ctx, ""), ==, 1);
+      profile.config_discovered = TRUE;
+      profile.config_readable = TRUE;
+      profile.config_parsed = TRUE;
+      profile.default_properties_established = TRUE;
+      profile.config_path = g_strdup ("<controlled-custom-context>");
+      profile.config_sha256 = g_strdup ("<not-applicable>");
+      profile.config_parse_note = g_strdup ("controlled custom-context baseline with explicit empty query");
+      profile.configured_default_properties = g_strdup ("");
+      profile.restore_query = g_strdup ("");
+    }
+
+  profile.fips_enabled = EVP_default_properties_is_fips_enabled (ctx) == 1;
+  profile.openssl_conf = g_strdup (g_getenv ("OPENSSL_CONF"));
+  profile.openssl_modules = g_strdup (g_getenv ("OPENSSL_MODULES"));
+  profile.provider_names = collect_provider_names (ctx);
+
+  g_test_message ("baseline config path: %s",
+                  profile.config_path != NULL ? profile.config_path : "<none>");
+  g_test_message ("baseline config sha256: %s",
+                  profile.config_sha256 != NULL ? profile.config_sha256 : "<none>");
+  g_test_message ("baseline config note: %s",
+                  profile.config_parse_note != NULL ? profile.config_parse_note : "<none>");
+  g_test_message ("baseline fips-enabled: %d", profile.fips_enabled ? 1 : 0);
+  g_test_message ("baseline configured default_properties: %s",
+                  profile.configured_default_properties != NULL ?
+                  profile.configured_default_properties : "<none>");
+  g_test_message ("baseline restore query: %s", profile.restore_query);
+  g_test_message ("baseline OPENSSL_CONF: %s",
+                  profile.openssl_conf != NULL ? profile.openssl_conf : "<unset>");
+  g_test_message ("baseline OPENSSL_MODULES: %s",
+                  profile.openssl_modules != NULL ? profile.openssl_modules : "<unset>");
+  g_test_message ("baseline providers: %s",
+                  profile.provider_names != NULL && *profile.provider_names != '\0' ?
+                  profile.provider_names : "<none>");
+
+  return profile;
+}
+
+static void
+free_baseline_profile (BaselineProfile *profile)
+{
+  g_clear_pointer (&profile->config_path, g_free);
+  g_clear_pointer (&profile->config_sha256, g_free);
+  g_clear_pointer (&profile->config_parse_note, g_free);
+  g_clear_pointer (&profile->configured_default_properties, g_free);
+  g_clear_pointer (&profile->restore_query, g_free);
+  g_clear_pointer (&profile->openssl_conf, g_free);
+  g_clear_pointer (&profile->openssl_modules, g_free);
+  g_clear_pointer (&profile->provider_names, g_free);
+}
+
+static void
+restore_baseline_profile (OSSL_LIB_CTX              *ctx,
+                          const BaselineProfile     *profile)
+{
+  g_assert_cmpint (EVP_set_default_properties (ctx, profile->restore_query), ==, 1);
+  g_assert_cmpuint ((unsigned) EVP_default_properties_is_fips_enabled (ctx),
+                    ==, (unsigned) (profile->fips_enabled ? 1 : 0));
+}
+
+static void
+assert_all_kats (void)
+{
+  guint i;
+
+  for (i = 0; i < G_N_ELEMENTS (kat_cases); i++)
+    {
+      const KatCase *tc = &kat_cases[i];
+      GHmac *hmac = g_hmac_new (tc->digest_type, tc->key, tc->key_len);
+      const gchar *digest;
+
+      g_assert_nonnull (hmac);
+      g_hmac_update (hmac, tc->data, tc->data_len);
+      digest = g_hmac_get_string (hmac);
+      g_assert_cmpstr (digest, ==, tc->expected_hex);
+      g_hmac_unref (hmac);
+    }
+}
+
+static void
+assert_real_libcrypto_identity (void)
+{
+  Dl_info info;
+  Dl_info info_from_handle;
+  void *no_load_handle;
+  void *fetch_symbol;
+  void *default_fetch_symbol;
+  GHmac *hmac;
+
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (hmac);
+  g_hmac_unref (hmac);
+
+  default_fetch_symbol = dlsym (RTLD_DEFAULT, "EVP_MAC_fetch");
+  g_assert_nonnull (default_fetch_symbol);
+  g_assert_true (dladdr (default_fetch_symbol, &info) != 0);
+  g_assert_nonnull (info.dli_fname);
+  g_assert_cmpuint ((unsigned) (OpenSSL_version_num () >> 28), ==, 3u);
+  g_test_message ("mapped libcrypto path: %s", info.dli_fname);
+  g_test_message ("openssl version: %s", OpenSSL_version (OPENSSL_VERSION));
+  g_test_message ("openssl build: %s", OpenSSL_version (OPENSSL_BUILT_ON));
+
+#ifdef RTLD_NOLOAD
+  no_load_handle = dlopen ("libcrypto.so.3", RTLD_NOW | RTLD_LOCAL | RTLD_NOLOAD);
+#else
+  no_load_handle = dlopen ("libcrypto.so.3", RTLD_NOW | RTLD_LOCAL);
+#endif
+  g_assert_nonnull (no_load_handle);
+  fetch_symbol = dlsym (no_load_handle, "EVP_MAC_fetch");
+  g_assert_nonnull (fetch_symbol);
+  g_assert_true (dladdr (fetch_symbol, &info_from_handle) != 0);
+  g_assert_nonnull (info_from_handle.dli_fname);
+  g_assert_cmpstr (info_from_handle.dli_fname, ==, info.dli_fname);
+  g_assert_cmpint (dlclose (no_load_handle), ==, 0);
+}
+
+static void
+assert_queue_preserved_across_success_paths (gboolean seeded_queue)
+{
+  ErrorQueueSnapshot seeded;
+  GHmac *source;
+  GHmac *copy;
+  GHmac *closed_copy;
+  const gchar *digest;
+  const gchar *copy_digest;
+
+  if (seeded_queue)
+    {
+      g_test_message ("queue-stage-1: seeding expected queue");
+      seed_user_errors (&seeded);
+    }
+  else
+    g_assert_cmphex (ERR_peek_error (), ==, 0);
+
+  source = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (source);
+  g_hmac_update (source, (const guchar *) "abc", 3);
+  copy = g_hmac_copy (source);
+  g_assert_nonnull (copy);
+  g_hmac_update (copy, (const guchar *) "d", 1);
+  copy_digest = g_hmac_get_string (copy);
+  g_assert_cmpstr (copy_digest, ==, "2a31ec0ee8d878c9eece9fb0df79b3b90b2256240163aa5ee50d176d3d1121f8");
+  closed_copy = g_hmac_copy (copy);
+  g_assert_nonnull (closed_copy);
+  digest = g_hmac_get_string (closed_copy);
+  g_assert_cmpstr (digest, ==, copy_digest);
+  g_hmac_unref (source);
+  g_hmac_unref (copy);
+  g_hmac_unref (closed_copy);
+
+  if (seeded_queue)
+    {
+      g_test_message ("queue-stage-1: asserting seeded queue preserved");
+      assert_error_queue_exact (&seeded);
+      ERR_clear_error ();
+    }
+  else
+    g_assert_cmphex (ERR_peek_error (), ==, 0);
+
+  source = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (source);
+  if (seeded_queue)
+    {
+      g_test_message ("queue-stage-2: reseeding expected queue");
+      seed_user_errors (&seeded);
+    }
+  g_hmac_update (source, (const guchar *) "abc", 3);
+  copy = g_hmac_copy (source);
+  g_assert_nonnull (copy);
+  g_hmac_update (source, (const guchar *) "def", 3);
+  digest = g_hmac_get_string (source);
+  g_assert_cmpstr (digest, ==, expected_sha256_abcdef);
+  g_hmac_unref (copy);
+  g_hmac_unref (source);
+
+  if (seeded_queue)
+    {
+      g_test_message ("queue-stage-2: asserting seeded queue preserved");
+      assert_error_queue_exact (&seeded);
+      ERR_clear_error ();
+    }
+  else
+    g_assert_cmphex (ERR_peek_error (), ==, 0);
+}
+
+static void
+count_warning_handler (const gchar   *log_domain,
+                       GLogLevelFlags log_level,
+                       const gchar   *message,
+                       gpointer       user_data)
+{
+  guint *count = user_data;
+  (void) log_domain;
+  (void) log_level;
+  (void) message;
+  (*count)++;
+}
+
+static void
+assert_unsatisfied_properties_fail_without_fallback (void)
+{
+  GHmac *hmac;
+  gchar *hex;
+  GBytes *key_bytes;
+  GBytes *data_bytes;
+  EVP_MAC *mac;
+  guint warning_count = 0;
+  gulong handler_id;
+  BaselineProfile baseline = { 0 };
+  ErrorQueueSnapshot seeded;
+
+  baseline = capture_baseline_profile (NULL);
+
+  g_assert_cmpint (EVP_set_default_properties (NULL, "provider=glib_test_nonexistent"), ==, 1);
+  mac = EVP_MAC_fetch (NULL, "HMAC", NULL);
+  g_assert_null (mac);
+
+  handler_id = g_log_set_handler (G_LOG_DOMAIN, G_LOG_LEVEL_WARNING,
+                                  count_warning_handler, &warning_count);
+
+  seed_user_errors (&seeded);
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_null (hmac);
+  hex = g_compute_hmac_for_data (G_CHECKSUM_SHA256, (const guchar *) "key", 3,
+                                 (const guchar *) "abc", 3);
+  g_assert_null (hex);
+  hex = g_compute_hmac_for_string (G_CHECKSUM_SHA256, (const guchar *) "key", 3, "abc", 3);
+  g_assert_null (hex);
+  key_bytes = g_bytes_new_static ("key", 3);
+  data_bytes = g_bytes_new_static ("abc", 3);
+  hex = g_compute_hmac_for_bytes (G_CHECKSUM_SHA256, key_bytes, data_bytes);
+  g_assert_null (hex);
+  g_bytes_unref (key_bytes);
+  g_bytes_unref (data_bytes);
+  assert_error_queue_exact (&seeded);
+  ERR_clear_error ();
+
+  g_assert_cmphex (ERR_peek_error (), ==, 0);
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_null (hmac);
+  hex = g_compute_hmac_for_data (G_CHECKSUM_SHA256, (const guchar *) "key", 3,
+                                 (const guchar *) "abc", 3);
+  g_assert_null (hex);
+  hex = g_compute_hmac_for_string (G_CHECKSUM_SHA256, (const guchar *) "key", 3, "abc", 3);
+  g_assert_null (hex);
+  key_bytes = g_bytes_new_static ("key", 3);
+  data_bytes = g_bytes_new_static ("abc", 3);
+  hex = g_compute_hmac_for_bytes (G_CHECKSUM_SHA256, key_bytes, data_bytes);
+  g_assert_null (hex);
+  g_bytes_unref (key_bytes);
+  g_bytes_unref (data_bytes);
+  g_assert_cmphex (ERR_peek_error (), ==, 0);
+  g_assert_cmpuint (warning_count, ==, 0);
+
+  g_log_remove_handler (G_LOG_DOMAIN, handler_id);
+  restore_baseline_profile (NULL, &baseline);
+  assert_all_kats ();
+  free_baseline_profile (&baseline);
+}
+
+static void
+assert_open_context_survives_policy_flip (void)
+{
+  GHmac *open_hmac;
+  GHmac *new_hmac;
+  const gchar *digest;
+  BaselineProfile baseline = { 0 };
+
+  baseline = capture_baseline_profile (NULL);
+
+  open_hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (open_hmac);
+  g_hmac_update (open_hmac, (const guchar *) "abc", 3);
+
+  g_assert_cmpint (EVP_set_default_properties (NULL, "provider=glib_test_nonexistent"), ==, 1);
+  new_hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_null (new_hmac);
+
+  g_hmac_update (open_hmac, (const guchar *) "def", 3);
+  digest = g_hmac_get_string (open_hmac);
+  g_assert_cmpstr (digest, ==, expected_sha256_abcdef);
+  g_hmac_unref (open_hmac);
+
+  restore_baseline_profile (NULL, &baseline);
+  new_hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (new_hmac);
+  g_hmac_update (new_hmac, (const guchar *) "abcdef", 6);
+  g_assert_cmpstr (g_hmac_get_string (new_hmac), ==, expected_sha256_abcdef);
+  g_hmac_unref (new_hmac);
+  free_baseline_profile (&baseline);
+}
+
+static void
+assert_thread_default_context_behavior (void)
+{
+  OSSL_LIB_CTX *custom_ctx;
+  OSSL_LIB_CTX *previous_ctx;
+  OSSL_PROVIDER *default_provider;
+  GHmac *hmac;
+  EVP_MAC *mac;
+  BaselineProfile baseline = { 0 };
+
+  custom_ctx = OSSL_LIB_CTX_new ();
+  g_assert_nonnull (custom_ctx);
+  default_provider = OSSL_PROVIDER_load (custom_ctx, "default");
+  g_assert_nonnull (default_provider);
+  baseline = capture_baseline_profile (custom_ctx);
+  restore_baseline_profile (custom_ctx, &baseline);
+
+  previous_ctx = OSSL_LIB_CTX_set0_default (custom_ctx);
+  g_assert_true (previous_ctx != custom_ctx);
+
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (hmac);
+  g_hmac_update (hmac, (const guchar *) "abc", 3);
+  g_assert_nonnull (g_hmac_get_string (hmac));
+  g_hmac_unref (hmac);
+
+  g_assert_cmpint (EVP_set_default_properties (custom_ctx, "provider=glib_test_nonexistent"), ==, 1);
+  mac = EVP_MAC_fetch (custom_ctx, "HMAC", NULL);
+  g_assert_null (mac);
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_null (hmac);
+
+  restore_baseline_profile (custom_ctx, &baseline);
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (hmac);
+  g_hmac_unref (hmac);
+
+  g_assert_true (OSSL_LIB_CTX_set0_default (previous_ctx) == custom_ctx);
+  OSSL_PROVIDER_unload (default_provider);
+  OSSL_LIB_CTX_free (custom_ctx);
+  free_baseline_profile (&baseline);
+}
+
+static void
+run_policy_case_child (const gchar *case_name)
+{
+  g_assert_nonnull (case_name);
+  g_test_message ("case=%s", case_name);
+
+  if (g_strcmp0 (case_name, "real-instance-and-kats") == 0)
+    {
+      assert_real_libcrypto_identity ();
+      assert_all_kats ();
+      assert_queue_preserved_across_success_paths (TRUE);
+      assert_queue_preserved_across_success_paths (FALSE);
+      return;
+    }
+
+  if (g_strcmp0 (case_name, "unsatisfied-properties") == 0)
+    {
+      assert_unsatisfied_properties_fail_without_fallback ();
+      return;
+    }
+
+  if (g_strcmp0 (case_name, "thread-default-context") == 0)
+    {
+      assert_thread_default_context_behavior ();
+      return;
+    }
+
+  if (g_strcmp0 (case_name, "open-context-survives-policy-flip") == 0)
+    {
+      assert_open_context_survives_policy_flip ();
+      return;
+    }
+
+  g_error ("unknown policy case: %s", case_name);
+}
+
+static void
+run_policy_case_subprocess (const gchar *case_name)
+{
+  g_auto(GStrv) envp = NULL;
+
+  if (g_test_subprocess ())
+    {
+      const gchar *selected = g_getenv ("GLIB_TEST_POLICY_CASE");
+      run_policy_case_child (selected);
+      return;
+    }
+
+  envp = build_clean_envp ();
+  envp = g_environ_setenv (g_steal_pointer (&envp), "GLIB_TEST_POLICY_CASE", case_name, TRUE);
+  g_test_trap_subprocess_with_envp (NULL, (const gchar * const *) envp, SUBPROCESS_TIMEOUT_US, G_TEST_SUBPROCESS_DEFAULT);
+  g_test_trap_assert_passed ();
+}
+
+static void
+test_policy_real_instance_and_kats (void)
+{
+  run_policy_case_subprocess ("real-instance-and-kats");
+}
+
+static void
+test_policy_unsatisfied_properties (void)
+{
+  run_policy_case_subprocess ("unsatisfied-properties");
+}
+
+static void
+test_policy_thread_default_context (void)
+{
+  run_policy_case_subprocess ("thread-default-context");
+}
+
+static void
+test_policy_open_context_survives_policy_flip (void)
+{
+  run_policy_case_subprocess ("open-context-survives-policy-flip");
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/hmac/openssl/policy/real-instance-and-kats",
+                   test_policy_real_instance_and_kats);
+  g_test_add_func ("/hmac/openssl/policy/unsatisfied-properties",
+                   test_policy_unsatisfied_properties);
+  g_test_add_func ("/hmac/openssl/policy/thread-default-context",
+                   test_policy_thread_default_context);
+  g_test_add_func ("/hmac/openssl/policy/open-context-survives-policy-flip",
+                   test_policy_open_context_survives_policy_flip);
+
+  return g_test_run ();
+}
