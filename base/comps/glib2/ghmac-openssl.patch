diff --git a/glib/tests/hmac-openssl/scripted/crypto.c b/glib/tests/hmac-openssl/scripted/crypto.c
new file mode 100644
index 0000000000000000000000000000000000000000..9f6f0a30efeef9a27b9483aced280a8f98dfc4b8
--- /dev/null
+++ b/glib/tests/hmac-openssl/scripted/crypto.c
@@ -0,0 +1,404 @@
+#include "../fixture-api.h"
+
+#include <openssl/core_names.h>
+#include <openssl/err.h>
+#include <openssl/evp.h>
+#include <openssl/params.h>
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define EXPORT __attribute__((visibility("default")))
+
+typedef struct
+{
+  uint32_t magic;
+  uint32_t _pad;
+} FakeMac;
+
+typedef struct
+{
+  size_t mac_size;
+  uint64_t total_len;
+} FakeMacCtx;
+
+typedef struct
+{
+  unsigned queue_count;
+  uint64_t queue_fingerprint;
+  unsigned mark_snapshot;
+  uint64_t mark_snapshot_fingerprint;
+  int marked;
+  uint64_t next_token;
+} ThreadQueueState;
+
+static GlibTestCryptoMode current_mode = GLIB_TEST_CRYPTO_MODE_SUCCESS;
+static int mark_behavior_enabled = 1;
+static __thread ThreadQueueState tls_queue = { 0, };
+static GlibTestCryptoCounters counters = { 0, };
+
+static size_t
+digest_size_for_name (const char *digest_name)
+{
+  if (digest_name == NULL)
+    return 32;
+  if (strcmp (digest_name, "MD5") == 0)
+    return 16;
+  if (strcmp (digest_name, "SHA1") == 0)
+    return 20;
+  if (strcmp (digest_name, "SHA256") == 0)
+    return 32;
+  if (strcmp (digest_name, "SHA384") == 0)
+    return 48;
+  if (strcmp (digest_name, "SHA512") == 0)
+    return 64;
+  return 0;
+}
+
+static uint64_t
+mix_token (uint64_t state,
+           uint64_t token)
+{
+  state ^= token + 0x9e3779b97f4a7c15ULL + (state << 6) + (state >> 2);
+  return state;
+}
+
+static uint64_t
+seed_fingerprint_for_count (unsigned count)
+{
+  uint64_t fp = 0;
+  unsigned i;
+
+  for (i = 0; i < count; i++)
+    fp = mix_token (fp, (uint64_t) (i + 1));
+
+  return fp;
+}
+
+static void
+inject_queue_error (void)
+{
+  uint64_t token = tls_queue.next_token++;
+  tls_queue.queue_count++;
+  tls_queue.queue_fingerprint = mix_token (tls_queue.queue_fingerprint, token);
+}
+
+EXPORT const char *
+glib_test_crypto_identity (void)
+{
+  return "scripted-fixture";
+}
+
+EXPORT void
+glib_test_crypto_reset_state (void)
+{
+  memset (&counters, 0, sizeof (counters));
+  tls_queue.queue_count = 0;
+  tls_queue.queue_fingerprint = 0;
+  tls_queue.mark_snapshot = 0;
+  tls_queue.mark_snapshot_fingerprint = 0;
+  tls_queue.marked = 0;
+  tls_queue.next_token = 1;
+  current_mode = GLIB_TEST_CRYPTO_MODE_SUCCESS;
+  mark_behavior_enabled = 1;
+}
+
+EXPORT void
+glib_test_crypto_set_mode (int mode)
+{
+  current_mode = (GlibTestCryptoMode) mode;
+}
+
+EXPORT void
+glib_test_crypto_set_mark_behavior (int enabled)
+{
+  mark_behavior_enabled = enabled != 0;
+}
+
+EXPORT void
+glib_test_crypto_seed_queue (unsigned count)
+{
+  tls_queue.queue_count = count;
+  tls_queue.queue_fingerprint = seed_fingerprint_for_count (count);
+  tls_queue.marked = 0;
+  tls_queue.mark_snapshot = 0;
+  tls_queue.mark_snapshot_fingerprint = 0;
+  tls_queue.next_token = ((uint64_t) count) + 1;
+}
+
+EXPORT unsigned
+glib_test_crypto_get_queue_count (void)
+{
+  return tls_queue.queue_count;
+}
+
+EXPORT uint64_t
+glib_test_crypto_get_queue_fingerprint (void)
+{
+  return tls_queue.queue_fingerprint;
+}
+
+EXPORT void
+glib_test_crypto_get_counters (GlibTestCryptoCounters *out)
+{
+  if (out == NULL)
+    return;
+
+  *out = counters;
+  out->tls_queue_count = tls_queue.queue_count;
+}
+
+EXPORT EVP_MAC *
+EVP_MAC_fetch (OSSL_LIB_CTX *libctx, const char *algorithm, const char *properties)
+{
+  FakeMac *mac;
+
+  (void) libctx;
+  (void) properties;
+  counters.fetch_calls++;
+  if (algorithm == NULL || strcmp (algorithm, "HMAC") != 0)
+    return NULL;
+
+  if (current_mode == GLIB_TEST_CRYPTO_MODE_FETCH_NULL)
+    {
+      counters.fetch_failures++;
+      inject_queue_error ();
+      return NULL;
+    }
+
+  mac = calloc (1, sizeof (*mac));
+  if (mac == NULL)
+    return NULL;
+  mac->magic = 0xBEEFCAFEu;
+  counters.live_mac_objects++;
+  return (EVP_MAC *) mac;
+}
+
+EXPORT void
+EVP_MAC_free (EVP_MAC *mac)
+{
+  if (mac != NULL)
+    {
+      counters.live_mac_objects--;
+      free (mac);
+    }
+  counters.mac_free_calls++;
+}
+
+EXPORT EVP_MAC_CTX *
+EVP_MAC_CTX_new (EVP_MAC *mac)
+{
+  FakeMacCtx *ctx;
+  FakeMac *fake_mac = (FakeMac *) mac;
+
+  counters.ctx_new_calls++;
+  if (fake_mac == NULL || fake_mac->magic != 0xBEEFCAFEu)
+    return NULL;
+
+  if (current_mode == GLIB_TEST_CRYPTO_MODE_CTX_NEW_NULL)
+    {
+      counters.ctx_new_failures++;
+      inject_queue_error ();
+      return NULL;
+    }
+
+  ctx = calloc (1, sizeof (*ctx));
+  if (ctx == NULL)
+    return NULL;
+  ctx->mac_size = 32;
+  counters.live_ctx_objects++;
+  return (EVP_MAC_CTX *) ctx;
+}
+
+EXPORT void
+EVP_MAC_CTX_free (EVP_MAC_CTX *ctx)
+{
+  if (ctx != NULL)
+    {
+      counters.live_ctx_objects--;
+      free (ctx);
+    }
+  counters.ctx_free_calls++;
+}
+
+EXPORT EVP_MAC_CTX *
+EVP_MAC_CTX_dup (const EVP_MAC_CTX *src)
+{
+  const FakeMacCtx *src_ctx = (const FakeMacCtx *) src;
+  FakeMacCtx *copy;
+
+  counters.ctx_dup_calls++;
+  if (current_mode == GLIB_TEST_CRYPTO_MODE_DUP_FAIL)
+    {
+      counters.ctx_dup_failures++;
+      inject_queue_error ();
+      return NULL;
+    }
+
+  copy = calloc (1, sizeof (*copy));
+  if (copy == NULL)
+    return NULL;
+  *copy = *src_ctx;
+  counters.live_ctx_objects++;
+  return (EVP_MAC_CTX *) copy;
+}
+
+EXPORT size_t
+EVP_MAC_CTX_get_mac_size (EVP_MAC_CTX *ctx)
+{
+  FakeMacCtx *fake_ctx = (FakeMacCtx *) ctx;
+  counters.ctx_get_size_calls++;
+
+  if (current_mode == GLIB_TEST_CRYPTO_MODE_INITIAL_SIZE_ZERO)
+    return 0;
+  if (current_mode == GLIB_TEST_CRYPTO_MODE_INITIAL_SIZE_MISMATCH)
+    return fake_ctx->mac_size + 1;
+
+  return fake_ctx->mac_size;
+}
+
+EXPORT int
+EVP_MAC_init (EVP_MAC_CTX         *ctx,
+              const unsigned char *key,
+              size_t               keylen,
+              const OSSL_PARAM     params[])
+{
+  FakeMacCtx *fake_ctx = (FakeMacCtx *) ctx;
+  const OSSL_PARAM *param;
+  const char *digest_name = NULL;
+
+  counters.init_calls++;
+  if (keylen == 0)
+    {
+      if (key != NULL)
+        counters.empty_key_nonnull++;
+      else
+        counters.empty_key_null++;
+    }
+  if (keylen > 0 && key != NULL)
+    counters.key_bytes_seen += keylen;
+
+  for (param = params; param != NULL && param->key != NULL; param++)
+    {
+      if (strcmp (param->key, OSSL_MAC_PARAM_DIGEST) == 0 && param->data != NULL)
+        {
+          digest_name = (const char *) param->data;
+          break;
+        }
+    }
+
+  if (digest_name == NULL || digest_size_for_name (digest_name) == 0)
+    {
+      counters.digest_param_bad++;
+      counters.init_failures++;
+      inject_queue_error ();
+      return 0;
+    }
+
+  counters.digest_param_ok++;
+
+  if (current_mode == GLIB_TEST_CRYPTO_MODE_INIT_FAIL)
+    {
+      counters.init_failures++;
+      inject_queue_error ();
+      return 0;
+    }
+
+  fake_ctx->mac_size = digest_size_for_name (digest_name);
+  fake_ctx->total_len = 0;
+  return 1;
+}
+
+EXPORT int
+EVP_MAC_update (EVP_MAC_CTX *ctx, const unsigned char *data, size_t datalen)
+{
+  FakeMacCtx *fake_ctx = (FakeMacCtx *) ctx;
+
+  counters.update_calls++;
+  if (current_mode == GLIB_TEST_CRYPTO_MODE_UPDATE_FAIL)
+    {
+      counters.update_failures++;
+      inject_queue_error ();
+      return 0;
+    }
+
+  if (data != NULL || datalen == 0)
+    fake_ctx->total_len += datalen;
+  return 1;
+}
+
+EXPORT int
+EVP_MAC_final (EVP_MAC_CTX *ctx, unsigned char *out, size_t *outl, size_t outsize)
+{
+  FakeMacCtx *fake_ctx = (FakeMacCtx *) ctx;
+  size_t i;
+  size_t result_len = fake_ctx->mac_size;
+
+  counters.final_calls++;
+  if (current_mode == GLIB_TEST_CRYPTO_MODE_FINAL_FAIL)
+    {
+      counters.final_failures++;
+      inject_queue_error ();
+      return 0;
+    }
+
+  if (outsize < result_len)
+    {
+      counters.final_failures++;
+      inject_queue_error ();
+      return 0;
+    }
+
+  for (i = 0; i < result_len; i++)
+    out[i] = (unsigned char) ((fake_ctx->total_len + i) & 0xff);
+
+  if (current_mode == GLIB_TEST_CRYPTO_MODE_FINAL_WRONG_SIZE && result_len > 0)
+    {
+      counters.final_wrong_size_calls++;
+      if (outl != NULL)
+        *outl = result_len - 1;
+      return 1;
+    }
+
+  if (outl != NULL)
+    *outl = result_len;
+  return 1;
+}
+
+EXPORT int
+ERR_set_mark (void)
+{
+  counters.err_set_mark_calls++;
+  if (!mark_behavior_enabled)
+    return 0;
+  if (tls_queue.queue_count == 0)
+    return 0;
+
+  tls_queue.marked = 1;
+  tls_queue.mark_snapshot = tls_queue.queue_count;
+  tls_queue.mark_snapshot_fingerprint = tls_queue.queue_fingerprint;
+  return 1;
+}
+
+EXPORT int
+ERR_pop_to_mark (void)
+{
+  counters.err_pop_to_mark_calls++;
+  if (!tls_queue.marked)
+    return 0;
+
+  tls_queue.queue_count = tls_queue.mark_snapshot;
+  tls_queue.queue_fingerprint = tls_queue.mark_snapshot_fingerprint;
+  tls_queue.marked = 0;
+  return 1;
+}
+
+EXPORT void
+ERR_clear_error (void)
+{
+  counters.err_clear_error_calls++;
+  tls_queue.queue_count = 0;
+  tls_queue.queue_fingerprint = 0;
+  tls_queue.marked = 0;
+}
