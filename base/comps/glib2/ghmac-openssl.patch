+static gpointer
+hmac_ref_thread (gpointer user_data)
+{
+  RefThreadData *data = user_data;
+  gint i;
+
+  for (i = 0; i < data->iterations; i++)
+    {
+      GHmac *tmp = g_hmac_ref (data->hmac);
+      g_hmac_unref (tmp);
+    }
+
+  return NULL;
+}
