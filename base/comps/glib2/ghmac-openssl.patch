diff --git a/glib/tests/fake-crypto-scripted.c b/glib/tests/fake-crypto-scripted.c
new file mode 100644
index 0000000000000000000000000000000000000000..dc4a0b7a257f38866a0a7d0c7314d079daea18a3
--- /dev/null
+++ b/glib/tests/fake-crypto-scripted.c
@@ -0,0 +1,216 @@
+#include <openssl/core_names.h>
+#include <openssl/err.h>
+#include <openssl/evp.h>
+#include <openssl/params.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef struct
+{
+  size_t mac_size;
+  size_t total_len;
+} FakeMacCtx;
+
+static int
+mode_is (const char *value)
+{
+  const char *mode = getenv ("GLIB_TEST_OPENSSL_MODE");
+  return mode != NULL && strcmp (mode, value) == 0;
+}
+
+static size_t
+digest_size_for_name (const char *digest_name)
+{
+  if (digest_name == NULL)
+    return 32;
+  if (strcmp (digest_name, "MD5") == 0)
+    return 16;
+  if (strcmp (digest_name, "SHA1") == 0)
+    return 20;
+  if (strcmp (digest_name, "SHA256") == 0)
+    return 32;
+  if (strcmp (digest_name, "SHA384") == 0)
+    return 48;
+  if (strcmp (digest_name, "SHA512") == 0)
+    return 64;
+  return 32;
+}
+
+__attribute__((constructor))
+static void
+fake_crypto_marker_ctor (void)
+{
+  const char *path = getenv ("GLIB_TEST_OPENSSL_MARKER_PATH");
+  FILE *stream;
+
+  if (path == NULL || path[0] == '\0')
+    return;
+
+  stream = fopen (path, "w");
+  if (stream == NULL)
+    return;
+  fputs ("loaded\n", stream);
+  fclose (stream);
+}
+
+EVP_MAC *
+EVP_MAC_fetch (OSSL_LIB_CTX  *libctx,
+               const char    *algorithm,
+               const char    *properties)
+{
+  (void) libctx;
+  (void) algorithm;
+  (void) properties;
+
+  if (mode_is ("fetch-null"))
+    return NULL;
+
+  return (EVP_MAC *) (uintptr_t) 0x1;
+}
+
+void
+EVP_MAC_free (EVP_MAC *mac)
+{
+  (void) mac;
+}
+
+EVP_MAC_CTX *
+EVP_MAC_CTX_new (EVP_MAC *mac)
+{
+  FakeMacCtx *ctx;
+
+  (void) mac;
+  if (mode_is ("ctx-new-null"))
+    return NULL;
+
+  ctx = calloc (1, sizeof (FakeMacCtx));
+  if (ctx == NULL)
+    return NULL;
+  ctx->mac_size = 32;
+  return (EVP_MAC_CTX *) ctx;
+}
+
+void
+EVP_MAC_CTX_free (EVP_MAC_CTX *ctx)
+{
+  free ((FakeMacCtx *) ctx);
+}
+
+EVP_MAC_CTX *
+EVP_MAC_CTX_dup (const EVP_MAC_CTX *src)
+{
+  const FakeMacCtx *in_ctx = (const FakeMacCtx *) src;
+  FakeMacCtx *out_ctx;
+
+  if (mode_is ("dup-fail"))
+    return NULL;
+
+  out_ctx = malloc (sizeof (FakeMacCtx));
+  if (out_ctx == NULL)
+    return NULL;
+  *out_ctx = *in_ctx;
+  return (EVP_MAC_CTX *) out_ctx;
+}
+
+size_t
+EVP_MAC_CTX_get_mac_size (EVP_MAC_CTX *ctx)
+{
+  FakeMacCtx *fake_ctx = (FakeMacCtx *) ctx;
+
+  if (mode_is ("size-zero"))
+    return 0;
+  if (mode_is ("size-mismatch"))
+    return fake_ctx->mac_size + 1;
+  return fake_ctx->mac_size;
+}
+
+int
+EVP_MAC_init (EVP_MAC_CTX         *ctx,
+              const unsigned char *key,
+              size_t               keylen,
+              const OSSL_PARAM     params[])
+{
+  FakeMacCtx *fake_ctx = (FakeMacCtx *) ctx;
+  const OSSL_PARAM *param;
+  const char *digest_name = NULL;
+
+  (void) key;
+  (void) keylen;
+
+  if (mode_is ("init-fail"))
+    return 0;
+
+  for (param = params; param != NULL && param->key != NULL; param++)
+    {
+      if (strcmp (param->key, OSSL_MAC_PARAM_DIGEST) == 0 && param->data != NULL)
+        {
+          digest_name = (const char *) param->data;
+          break;
+        }
+    }
+
+  fake_ctx->mac_size = digest_size_for_name (digest_name);
+  fake_ctx->total_len = 0;
+  return 1;
+}
+
+int
+EVP_MAC_update (EVP_MAC_CTX          *ctx,
+                const unsigned char  *data,
+                size_t                datalen)
+{
+  FakeMacCtx *fake_ctx = (FakeMacCtx *) ctx;
+
+  if (mode_is ("update-fail"))
+    return 0;
+
+  if (data != NULL || datalen == 0)
+    fake_ctx->total_len += datalen;
+  return 1;
+}
+
+int
+EVP_MAC_final (EVP_MAC_CTX    *ctx,
+               unsigned char  *out,
+               size_t         *outl,
+               size_t          outsize)
+{
+  FakeMacCtx *fake_ctx = (FakeMacCtx *) ctx;
+  size_t i;
+  size_t result_len = fake_ctx->mac_size;
+
+  if (mode_is ("final-fail"))
+    return 0;
+
+  if (mode_is ("final-size-mismatch") && result_len > 0)
+    result_len--;
+
+  if (outsize < result_len)
+    return 0;
+
+  for (i = 0; i < result_len; i++)
+    out[i] = (unsigned char) ((fake_ctx->total_len + i) & 0xff);
+  if (outl != NULL)
+    *outl = result_len;
+  return 1;
+}
+
+int
+ERR_set_mark (void)
+{
+  return 1;
+}
+
+int
+ERR_pop_to_mark (void)
+{
+  return 1;
+}
+
+void
+ERR_clear_error (void)
+{
+}
