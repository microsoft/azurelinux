+static gboolean
+resolve_scripted_api (void            *handle,
+                      ScriptedFixtureApi *api)
+{
+  memset (api, 0, sizeof (*api));
+  api->identity = (FixtureIdentityFunc) dlsym (handle, "glib_test_crypto_identity");
+  api->reset_state = (FixtureResetStateFunc) dlsym (handle, "glib_test_crypto_reset_state");
+  api->set_mode = (FixtureSetModeFunc) dlsym (handle, "glib_test_crypto_set_mode");
+  api->set_mark_behavior = (FixtureSetMarkBehaviorFunc) dlsym (handle, "glib_test_crypto_set_mark_behavior");
+  api->seed_queue = (FixtureSeedQueueFunc) dlsym (handle, "glib_test_crypto_seed_queue");
+  api->get_queue_count = (FixtureGetQueueCountFunc) dlsym (handle, "glib_test_crypto_get_queue_count");
+  api->get_queue_fingerprint = (FixtureGetQueueFingerprintFunc) dlsym (handle, "glib_test_crypto_get_queue_fingerprint");
+  api->get_counters = (FixtureGetCountersFunc) dlsym (handle, "glib_test_crypto_get_counters");
+
+  return api->identity != NULL &&
+         api->reset_state != NULL &&
+         api->set_mode != NULL &&
+         api->set_mark_behavior != NULL &&
+         api->seed_queue != NULL &&
+         api->get_queue_count != NULL &&
