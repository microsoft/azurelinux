+static void
+fatal_mode_child (void)
+{
+  ScriptedFixtureApi api;
+  void *handle;
+  GHmac *hmac;
+  int mode;
+  const gchar *mode_env;
+
+  assert_non_secure_execution ();
+  handle = open_scripted_fixture (&api);
+  mode_env = g_getenv ("GLIB_TEST_FATAL_MODE");
+  g_assert_nonnull (mode_env);
+  mode = atoi (mode_env);
+  api.reset_state ();
+  api.set_mode (mode);
+
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (hmac);
+  if (mode == GLIB_TEST_CRYPTO_MODE_UPDATE_FAIL)
+    g_hmac_update (hmac, (const guchar *) "abc", 3);
+  else if (mode == GLIB_TEST_CRYPTO_MODE_DUP_FAIL)
+    g_hmac_copy (hmac);
+  else
+    {
+      g_hmac_update (hmac, (const guchar *) "abc", 3);
+      g_hmac_get_string (hmac);
+    }
+
+  g_assert_cmpuint (dlclose (handle), ==, 0);
+  g_assert_not_reached ();
+}
