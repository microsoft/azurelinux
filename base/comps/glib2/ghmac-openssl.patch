+      gchar *hmac_below;
+      gchar *hmac_at;
+      gchar *hmac_above;
+
+      key_below = g_malloc (algo->block_size - 1);
+      key_at = g_malloc (algo->block_size);
+      key_above = g_malloc (algo->block_size + 1);
+      memset (key_below, 0x41, algo->block_size - 1);
+      memset (key_at, 0x42, algo->block_size);
+      memset (key_above, 0x43, algo->block_size + 1);
+
+      hmac_below = g_compute_hmac_for_data (algo->type, key_below, algo->block_size - 1,
+                                            (const guint8 *) "payload", 7);
+      hmac_at = g_compute_hmac_for_data (algo->type, key_at, algo->block_size,
+                                         (const guint8 *) "payload", 7);
+      hmac_above = g_compute_hmac_for_data (algo->type, key_above, algo->block_size + 1,
+                                            (const guint8 *) "payload", 7);
+
+      g_assert_cmpstr (hmac_below, ==, algo->expected_block_below);
+      g_assert_cmpstr (hmac_at, ==, algo->expected_block_at);
+      g_assert_cmpstr (hmac_above, ==, algo->expected_block_above);
+      g_assert_cmpstr (hmac_below, !=, hmac_at);
+      g_assert_cmpstr (hmac_at, !=, hmac_above);
+
+      g_free (hmac_above);
+      g_free (hmac_at);
+      g_free (hmac_below);
+      g_free (key_above);
+      g_free (key_at);
+      g_free (key_below);
+    }
