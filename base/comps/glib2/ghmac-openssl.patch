+static void
+assert_queue_state (ScriptedFixtureApi *api,
+                    guint               expected_count,
+                    guint64             expected_fingerprint)
+{
+  g_assert_cmpuint (api->get_queue_count (), ==, expected_count);
+  g_assert_cmpuint (api->get_queue_fingerprint (), ==, expected_fingerprint);
+}
+
+static void
+assert_recoverable_constructor_mode (ScriptedFixtureApi *api,
+                                     int                 mode,
+                                     gboolean            seeded_queue)
+{
+  const RecoverableModeExpectations *exp;
+  GHmac *hmac;
+  GlibTestCryptoCounters c = { 0, };
+  guint seeded_count = seeded_queue ? 5u : 0u;
+  guint64 seeded_fp;
+
+  exp = lookup_recoverable_expectation (mode);
+  g_assert_nonnull (exp);
+
+  api->reset_state ();
+  api->set_mark_behavior (1);
+  api->seed_queue (seeded_count);
+  seeded_fp = api->get_queue_fingerprint ();
+
+  api->set_mode (mode);
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_null (hmac);
+  assert_queue_state (api, seeded_count, seeded_fp);
+
+  api->set_mode (GLIB_TEST_CRYPTO_MODE_SUCCESS);
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "", 0);
+  g_assert_nonnull (hmac);
+  assert_queue_state (api, seeded_count, seeded_fp);
+  g_hmac_unref (hmac);
+  assert_queue_state (api, seeded_count, seeded_fp);
+
+  api->get_counters (&c);
+  g_assert_cmpuint (c.fetch_calls, ==, 2);
+  g_assert_cmpuint (c.fetch_failures, ==, exp->fetch_failures);
+  g_assert_cmpuint (c.mac_free_calls, ==, exp->mac_free_calls + 1);
+  g_assert_cmpuint (c.ctx_new_calls, ==, exp->ctx_new_calls + 1);
+  g_assert_cmpuint (c.ctx_new_failures, ==, exp->ctx_new_failures);
+  g_assert_cmpuint (c.init_calls, ==, exp->init_calls + 1);
+  g_assert_cmpuint (c.init_failures, ==, exp->init_failures);
+  g_assert_cmpuint (c.ctx_get_size_calls, ==, exp->ctx_get_size_calls + 1);
+  g_assert_cmpuint (c.ctx_free_calls, ==, exp->ctx_free_calls + 1);
+  g_assert_cmpuint (c.key_bytes_seen, ==, exp->key_bytes_seen);
+  g_assert_cmpuint (c.digest_param_ok, ==, exp->digest_param_ok + 1);
+  g_assert_cmpuint (c.digest_param_bad, ==, 0);
+  g_assert_cmpuint (c.empty_key_nonnull, ==, 1);
+  g_assert_cmpuint (c.empty_key_null, ==, 0);
+  g_assert_cmpuint (c.live_ctx_objects, ==, 0);
+  g_assert_cmpuint (c.live_mac_objects, ==, 0);
+  g_assert_cmpuint (c.err_set_mark_calls, ==, 3);
+  g_assert_cmpuint (c.err_pop_to_mark_calls, ==, seeded_queue ? 3u : 0u);
+  g_assert_cmpuint (c.err_clear_error_calls, ==, seeded_queue ? 0u : 3u);
+}
