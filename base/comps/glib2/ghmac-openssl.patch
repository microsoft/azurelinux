+typedef const char *(*FixtureIdentityFunc) (void);
+typedef void (*FixtureResetStateFunc) (void);
+typedef void (*FixtureSetModeFunc) (int);
+typedef void (*FixtureSetMarkBehaviorFunc) (int);
+typedef void (*FixtureSeedQueueFunc) (unsigned);
+typedef unsigned (*FixtureGetQueueCountFunc) (void);
+typedef uint64_t (*FixtureGetQueueFingerprintFunc) (void);
+typedef void (*FixtureGetCountersFunc) (GlibTestCryptoCounters *);
+
+typedef struct
+{
+  FixtureIdentityFunc identity;
+  FixtureResetStateFunc reset_state;
+  FixtureSetModeFunc set_mode;
+  FixtureSetMarkBehaviorFunc set_mark_behavior;
+  FixtureSeedQueueFunc seed_queue;
+  FixtureGetQueueCountFunc get_queue_count;
+  FixtureGetQueueFingerprintFunc get_queue_fingerprint;
+  FixtureGetCountersFunc get_counters;
+} ScriptedFixtureApi;
+
+static const gint64 SUBPROCESS_TIMEOUT_US = 30 * G_TIME_SPAN_SECOND;
+
+static gchar **
+build_envp (const gchar *fixture_dir,
+            const gchar *key_limit_case)
+{
+  gchar **envp = g_get_environ ();
+  g_autofree gchar *absolute_fixture_dir = NULL;
+  const gchar *old_path = g_environ_getenv (envp, "LD_LIBRARY_PATH");
+  gchar *new_path;
+
+  if (g_path_is_absolute (fixture_dir))
+    absolute_fixture_dir = g_strdup (fixture_dir);
+  else
+    absolute_fixture_dir = g_canonicalize_filename (fixture_dir, g_get_current_dir ());
+  g_assert_true (g_path_is_absolute (absolute_fixture_dir));
+
+  if (old_path != NULL && old_path[0] != '\0')
+    new_path = g_strconcat (absolute_fixture_dir, ":", old_path, NULL);
+  else
+    new_path = g_strdup (absolute_fixture_dir);
+
+  envp = g_environ_setenv (g_steal_pointer (&envp), "LD_LIBRARY_PATH", new_path, TRUE);
+  g_free (new_path);
+
+  envp = g_environ_unsetenv (g_steal_pointer (&envp), "LD_PRELOAD");
+  envp = g_environ_unsetenv (g_steal_pointer (&envp), "LD_AUDIT");
+
+  if (key_limit_case != NULL)
+    envp = g_environ_setenv (g_steal_pointer (&envp), "GLIB_TEST_KEY_LIMIT_CASE", key_limit_case, TRUE);
+  else
+    envp = g_environ_unsetenv (g_steal_pointer (&envp), "GLIB_TEST_KEY_LIMIT_CASE");
+
+  return envp;
+}
+
+static gchar *
+fixture_dir_for_variant (const gchar *variant)
+{
+  return g_test_build_filename (G_TEST_BUILT, "hmac-openssl", variant, NULL);
+}
+
+static gchar *
+fixture_library_for_variant (const gchar *variant)
+{
+  return g_test_build_filename (G_TEST_BUILT, "hmac-openssl", variant, "libcrypto.so.3", NULL);
+}
+
+static void
+assert_non_secure_execution (void)
+{
+  g_assert_cmpint ((int) getauxval (AT_SECURE), ==, 0);
+}
+
+static void
+assert_wrappers_null (void)
+{
+  gchar *hex;
+  GBytes *key_bytes;
+  GBytes *bytes;
+
+  hex = g_compute_hmac_for_data (G_CHECKSUM_SHA256, (const guchar *) "key", 3,
+                                 (const guchar *) "abc", 3);
+  g_assert_null (hex);
+
+  hex = g_compute_hmac_for_string (G_CHECKSUM_SHA256, (const guchar *) "key", 3, "abc", 3);
+  g_assert_null (hex);
+
+  key_bytes = g_bytes_new_static ("key", 3);
+  bytes = g_bytes_new_static ("abc", 3);
+  hex = g_compute_hmac_for_bytes (G_CHECKSUM_SHA256, key_bytes, bytes);
+  g_assert_null (hex);
+  g_bytes_unref (key_bytes);
+  g_bytes_unref (bytes);
