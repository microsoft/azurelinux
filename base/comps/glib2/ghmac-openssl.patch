+  g_test_expect_message (G_LOG_DOMAIN, G_LOG_LEVEL_CRITICAL,
+                         "*g_hmac_new: OpenSSL backend requires key_len <= G_MAXINT*");
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, &sentinel, key_len);
+  g_test_assert_expected_messages ();
+  g_assert_null (hmac);
+
+  api.get_counters (&c);
+  g_assert_cmpuint (c.fetch_calls, ==, 0);
+  g_assert_cmpuint (c.init_calls, ==, 0);
+  g_assert_cmpuint (c.key_bytes_seen, ==, 0);
+
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (hmac);
+  g_hmac_unref (hmac);
+
+  api.get_counters (&c);
+  g_assert_cmpuint (c.fetch_calls, ==, 1);
+  g_assert_cmpuint (dlclose (handle), ==, 0);
+}
+
+static void
+before_loader_unloadable_child (void)
+{
+  static const guint8 sentinel = 0x5a;
+  gsize key_len = (gsize) G_MAXINT + 1;
+  GHmac *hmac;
+
+  assert_non_secure_execution ();
+  g_test_expect_message (G_LOG_DOMAIN, G_LOG_LEVEL_CRITICAL,
+                         "*g_hmac_new: OpenSSL backend requires key_len <= G_MAXINT*");
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, &sentinel, key_len);
+  g_test_assert_expected_messages ();
+  g_assert_null (hmac);
+
+  g_test_expect_message (G_LOG_DOMAIN, G_LOG_LEVEL_WARNING,
+                         "*Cannot use GHmac: failed to load libcrypto.so.3*");
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_test_assert_expected_messages ();
+  g_assert_null (hmac);
+}
+
+static void
+test_key_limit_before_loader (void)
+{
+  g_autofree gchar *fixture_dir = NULL;
+  gchar **envp;
+
+  if (g_test_subprocess ())
+    {
+      const gchar *mode = g_getenv ("GLIB_TEST_KEY_LIMIT_CASE");
+      g_assert_nonnull (mode);
+      if (strcmp (mode, "scripted") == 0)
+        before_loader_scripted_child ();
+      else
+        before_loader_unloadable_child ();
+      return;
+    }
+
+  fixture_dir = fixture_dir_for_variant ("scripted");
+  envp = build_envp (fixture_dir, "scripted");
+  g_test_trap_subprocess_with_envp (NULL, (const gchar * const *) envp, SUBPROCESS_TIMEOUT_US, G_TEST_SUBPROCESS_DEFAULT);
+  g_test_trap_assert_passed ();
+  g_strfreev (envp);
+
+  g_clear_pointer (&fixture_dir, g_free);
+  fixture_dir = fixture_dir_for_variant ("unloadable");
+  envp = build_envp (fixture_dir, "unloadable");
+  g_test_trap_subprocess_with_envp (NULL, (const gchar * const *) envp, SUBPROCESS_TIMEOUT_US, G_TEST_SUBPROCESS_DEFAULT);
+  g_test_trap_assert_passed ();
+  g_strfreev (envp);
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/hmac/openssl/failures/missing-late-symbol", test_loader_missing_late_symbol);
+  g_test_add_func ("/hmac/openssl/failures/unloadable", test_loader_unloadable);
+  g_test_add_func ("/hmac/openssl/failures/reentrant-concurrent-single-warning", test_reentrant_concurrent_single_warning);
+  g_test_add_func ("/hmac/openssl/failures/recoverable-modes", test_recoverable_modes_and_counters);
+  g_test_add_func ("/hmac/openssl/failures/error-queue-hygiene", test_error_queue_hygiene);
+  g_test_add_func ("/hmac/openssl/failures/fatal-dispatch", test_fatal_operation_modes);
+  g_test_add_func ("/openssl/key-limit/before-loader", test_key_limit_before_loader);
+
+  return g_test_run ();
+}
diff --git a/glib/tests/hmac-openssl/fixture-api.h b/glib/tests/hmac-openssl/fixture-api.h
