+static void
+assert_copy_lifetimes_and_counters (ScriptedFixtureApi *api)
+{
+  GHmac *source;
+  GHmac *open_copy;
+  GHmac *closed_copy;
+  g_autofree gchar *open_copy_digest = NULL;
+  guint64 queue_fp;
+  GlibTestCryptoCounters c = { 0, };
+
+  api->reset_state ();
+  api->set_mark_behavior (1);
+  api->set_mode (GLIB_TEST_CRYPTO_MODE_SUCCESS);
+  api->seed_queue (9);
+  queue_fp = api->get_queue_fingerprint ();
+
+  source = g_hmac_new (G_CHECKSUM_SHA256, (const guchar *) "key", 3);
+  g_assert_nonnull (source);
+  g_hmac_update (source, (const guchar *) "abc", 3);
+  open_copy = g_hmac_copy (source);
+  g_assert_nonnull (open_copy);
+  g_hmac_update (open_copy, (const guchar *) "d", 1);
+
+  g_hmac_unref (source);
+  assert_queue_state (api, 9, queue_fp);
+
+  open_copy_digest = g_strdup (g_hmac_get_string (open_copy));
+  g_assert_nonnull (open_copy_digest);
+  closed_copy = g_hmac_copy (open_copy);
+  g_assert_nonnull (closed_copy);
+  g_hmac_unref (open_copy);
+  g_assert_cmpstr (g_hmac_get_string (closed_copy), ==, open_copy_digest);
+
+  g_hmac_unref (closed_copy);
+  assert_queue_state (api, 9, queue_fp);
+
+  api->get_counters (&c);
+  g_assert_cmpuint (c.fetch_calls, ==, 1);
+  g_assert_cmpuint (c.mac_free_calls, ==, 1);
+  g_assert_cmpuint (c.ctx_new_calls, ==, 1);
+  g_assert_cmpuint (c.init_calls, ==, 1);
+  g_assert_cmpuint (c.ctx_get_size_calls, ==, 1);
+  g_assert_cmpuint (c.ctx_dup_calls, ==, 1);
+  g_assert_cmpuint (c.ctx_free_calls, ==, 2);
+  g_assert_cmpuint (c.final_calls, ==, 1);
+  g_assert_cmpuint (c.live_ctx_objects, ==, 0);
+  g_assert_cmpuint (c.live_mac_objects, ==, 0);
+  g_assert_cmpuint (c.err_set_mark_calls, ==, 6);
+  g_assert_cmpuint (c.err_pop_to_mark_calls, ==, 6);
+  g_assert_cmpuint (c.err_clear_error_calls, ==, 0);
+}
