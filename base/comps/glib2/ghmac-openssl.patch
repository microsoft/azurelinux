diff --git a/glib/ghmac-openssl.c b/glib/ghmac-openssl.c
new file mode 100644
index 0000000000000000000000000000000000000000..9afc0b575729cde00bf8e81e1fd815800339dd4f
--- /dev/null
+++ b/glib/ghmac-openssl.c
@@ -0,0 +1,451 @@
+/* ghmac-openssl.c - data hashing functions
+ *
+ * Copyright (C) 2026  Microsoft
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <openssl/core_names.h>
+#include <openssl/err.h>
+#include <openssl/evp.h>
+#include <openssl/params.h>
+#include <string.h>
+
+#include "ghmac.h"
+
+#include "gatomic.h"
+#include "gchecksumprivate.h"
+#include "gmem.h"
+#include "gslice.h"
+#include "gstrfuncs.h"
+#include "gtestutils.h"
+#include "gthread.h"
+#include "gtypes.h"
+#include "glibintl.h"
+
+#ifndef USE_OPENSSL
+#error "build configuration error"
+#endif
+#ifdef USE_GNUTLS
+#error "build configuration error"
+#endif
+
+typedef EVP_MAC *(*OpenSslEvpMacFetchFunc) (OSSL_LIB_CTX  *libctx,
+                                            const char    *algorithm,
+                                            const char    *properties);
+typedef void (*OpenSslEvpMacFreeFunc) (EVP_MAC *mac);
+typedef EVP_MAC_CTX *(*OpenSslEvpMacCtxNewFunc) (EVP_MAC *mac);
+typedef void (*OpenSslEvpMacCtxFreeFunc) (EVP_MAC_CTX *ctx);
+typedef EVP_MAC_CTX *(*OpenSslEvpMacCtxDupFunc) (const EVP_MAC_CTX *src);
+typedef size_t (*OpenSslEvpMacCtxGetMacSizeFunc) (EVP_MAC_CTX *ctx);
+typedef int (*OpenSslEvpMacInitFunc) (EVP_MAC_CTX         *ctx,
+                                      const unsigned char *key,
+                                      size_t               keylen,
+                                      const OSSL_PARAM     params[]);
+typedef int (*OpenSslEvpMacUpdateFunc) (EVP_MAC_CTX *ctx,
+                                        const unsigned char *data,
+                                        size_t datalen);
+typedef int (*OpenSslEvpMacFinalFunc) (EVP_MAC_CTX    *ctx,
+                                       unsigned char  *out,
+                                       size_t         *outl,
+                                       size_t          outsize);
+typedef int (*OpenSslErrSetMarkFunc) (void);
+typedef int (*OpenSslErrPopToMarkFunc) (void);
+typedef void (*OpenSslErrClearErrorFunc) (void);
+
+typedef struct
+{
+  OpenSslEvpMacFetchFunc loaded_EVP_MAC_fetch;
+  OpenSslEvpMacFreeFunc loaded_EVP_MAC_free;
+  OpenSslEvpMacCtxNewFunc loaded_EVP_MAC_CTX_new;
+  OpenSslEvpMacCtxFreeFunc loaded_EVP_MAC_CTX_free;
+  OpenSslEvpMacCtxDupFunc loaded_EVP_MAC_CTX_dup;
+  OpenSslEvpMacCtxGetMacSizeFunc loaded_EVP_MAC_CTX_get_mac_size;
+  OpenSslEvpMacInitFunc loaded_EVP_MAC_init;
+  OpenSslEvpMacUpdateFunc loaded_EVP_MAC_update;
+  OpenSslEvpMacFinalFunc loaded_EVP_MAC_final;
+  OpenSslErrSetMarkFunc loaded_ERR_set_mark;
+  OpenSslErrPopToMarkFunc loaded_ERR_pop_to_mark;
+  OpenSslErrClearErrorFunc loaded_ERR_clear_error;
+} OpenSslLoaderVtable;
+
+typedef struct
+{
+  gpointer handle;
+  OpenSslLoaderVtable table;
+} OpenSslLoader;
+
+struct _GHmac
+{
+  int ref_count;
+  GChecksumType digest_type;
+  gsize digest_len;
+  EVP_MAC_CTX *ctx;
+  gboolean closed;
+  guint8 digest[64];
+  gchar *digest_str;
+};
+
+static gsize openssl_loader_state = 0;
+static OpenSslLoader openssl_loader = { 0, };
+static gchar *openssl_loader_error = NULL;
+static gint openssl_loader_warned = 0;
+
+static void
+restore_error_queue_scope (gboolean marked)
+{
+  if (marked)
+    openssl_loader.table.loaded_ERR_pop_to_mark ();
+  else
+    openssl_loader.table.loaded_ERR_clear_error ();
+}
+
+static gboolean
+openssl_hmac_load_symbol (gpointer      handle,
+                          const gchar  *name,
+                          gpointer     *target)
+{
+  dlerror ();
+  *target = dlsym (handle, name);
+  if (*target == NULL)
+    {
+      const char *error_message = dlerror ();
+      g_free (openssl_loader_error);
+      openssl_loader_error = g_strdup_printf ("failed to resolve %s: %s",
+                                              name,
+                                              error_message != NULL ? error_message : "unknown error");
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+initialize_openssl_loader (void)
+{
+  gpointer handle = NULL;
+  OpenSslLoader loader = { 0, };
+
+  handle = dlopen ("libcrypto.so.3", RTLD_NOW | RTLD_LOCAL);
+  if (handle == NULL)
+    {
+      const char *error_message = dlerror ();
+      g_free (openssl_loader_error);
+      openssl_loader_error = g_strdup_printf ("failed to load libcrypto.so.3: %s",
+                                              error_message != NULL ? error_message : "unknown error");
+      return FALSE;
+    }
+
+  if (!openssl_hmac_load_symbol (handle, "EVP_MAC_fetch", (gpointer *) &loader.table.loaded_EVP_MAC_fetch) ||
+      !openssl_hmac_load_symbol (handle, "EVP_MAC_free", (gpointer *) &loader.table.loaded_EVP_MAC_free) ||
+      !openssl_hmac_load_symbol (handle, "EVP_MAC_CTX_new", (gpointer *) &loader.table.loaded_EVP_MAC_CTX_new) ||
+      !openssl_hmac_load_symbol (handle, "EVP_MAC_CTX_free", (gpointer *) &loader.table.loaded_EVP_MAC_CTX_free) ||
+      !openssl_hmac_load_symbol (handle, "EVP_MAC_CTX_dup", (gpointer *) &loader.table.loaded_EVP_MAC_CTX_dup) ||
+      !openssl_hmac_load_symbol (handle, "EVP_MAC_CTX_get_mac_size", (gpointer *) &loader.table.loaded_EVP_MAC_CTX_get_mac_size) ||
+      !openssl_hmac_load_symbol (handle, "EVP_MAC_init", (gpointer *) &loader.table.loaded_EVP_MAC_init) ||
+      !openssl_hmac_load_symbol (handle, "EVP_MAC_update", (gpointer *) &loader.table.loaded_EVP_MAC_update) ||
+      !openssl_hmac_load_symbol (handle, "EVP_MAC_final", (gpointer *) &loader.table.loaded_EVP_MAC_final) ||
+      !openssl_hmac_load_symbol (handle, "ERR_set_mark", (gpointer *) &loader.table.loaded_ERR_set_mark) ||
+      !openssl_hmac_load_symbol (handle, "ERR_pop_to_mark", (gpointer *) &loader.table.loaded_ERR_pop_to_mark) ||
+      !openssl_hmac_load_symbol (handle, "ERR_clear_error", (gpointer *) &loader.table.loaded_ERR_clear_error))
+    {
+      dlclose (handle);
+      return FALSE;
+    }
+
+  loader.handle = handle;
+  openssl_loader = loader;
+  return TRUE;
+}
+
+static gboolean
+ensure_openssl_loader (void)
+{
+  if (g_once_init_enter (&openssl_loader_state))
+    {
+      gsize state = initialize_openssl_loader () ? 1 : 2;
+      g_once_init_leave (&openssl_loader_state, state);
+    }
+
+  if (openssl_loader_state == 1)
+    return TRUE;
+
+  if (g_atomic_int_compare_and_exchange (&openssl_loader_warned, 0, 1))
+    g_warning ("Cannot use GHmac: %s",
+               openssl_loader_error != NULL ? openssl_loader_error : "OpenSSL backend loader initialization failed");
+
+  return FALSE;
+}
+
+static gboolean
+lookup_digest (GChecksumType  digest_type,
+               const gchar  **digest_name,
+               gsize         *digest_len)
+{
+  switch (digest_type)
+    {
+    case G_CHECKSUM_MD5:
+      *digest_name = "MD5";
+      *digest_len = 16;
+      return TRUE;
+    case G_CHECKSUM_SHA1:
+      *digest_name = "SHA1";
+      *digest_len = 20;
+      return TRUE;
+    case G_CHECKSUM_SHA256:
+      *digest_name = "SHA256";
+      *digest_len = 32;
+      return TRUE;
+    case G_CHECKSUM_SHA384:
+      *digest_name = "SHA384";
+      *digest_len = 48;
+      return TRUE;
+    case G_CHECKSUM_SHA512:
+      *digest_name = "SHA512";
+      *digest_len = 64;
+      return TRUE;
+    default:
+      return FALSE;
+    }
+}
+
+static gboolean
+ensure_closed (GHmac *hmac)
+{
+  gboolean marked;
+  size_t out_len = 0;
+  int final_status;
+
+  if (hmac->closed)
+    return TRUE;
+
+  marked = openssl_loader.table.loaded_ERR_set_mark () == 1;
+  final_status = openssl_loader.table.loaded_EVP_MAC_final (hmac->ctx,
+                                                            hmac->digest,
+                                                            &out_len,
+                                                            sizeof (hmac->digest));
+  openssl_loader.table.loaded_EVP_MAC_CTX_free (hmac->ctx);
+  hmac->ctx = NULL;
+  restore_error_queue_scope (marked);
+
+  if (final_status != 1)
+    return FALSE;
+  if (out_len != hmac->digest_len)
+    return FALSE;
+
+  hmac->closed = TRUE;
+  return TRUE;
+}
+
+GHmac *
+g_hmac_new (GChecksumType  digest_type,
+            const guchar  *key,
+            gsize          key_len)
+{
+  GHmac *hmac;
+  const gchar *digest_name = NULL;
+  gsize digest_len = 0;
+  EVP_MAC *mac = NULL;
+  const guint8 empty_key = 0;
+  const guchar *effective_key = key;
+  int init_result;
+  size_t mac_size;
+  gboolean marked;
+
+  g_return_val_if_fail (key != NULL || key_len == 0, NULL);
+
+  if (!lookup_digest (digest_type, &digest_name, &digest_len))
+    g_return_val_if_reached (NULL);
+
+  if (key_len > G_MAXINT)
+    {
+      g_critical ("g_hmac_new: OpenSSL backend requires key_len <= G_MAXINT");
+      return NULL;
+    }
+
+  if (!ensure_openssl_loader ())
+    return NULL;
+
+  marked = openssl_loader.table.loaded_ERR_set_mark () == 1;
+  mac = openssl_loader.table.loaded_EVP_MAC_fetch (NULL, "HMAC", NULL);
+  if (mac == NULL)
+    {
+      restore_error_queue_scope (marked);
+      return NULL;
+    }
+
+  hmac = g_new0 (GHmac, 1);
+  hmac->ref_count = 1;
+  hmac->digest_type = digest_type;
+  hmac->digest_len = digest_len;
+  hmac->ctx = openssl_loader.table.loaded_EVP_MAC_CTX_new (mac);
+  openssl_loader.table.loaded_EVP_MAC_free (mac);
+
+  if (hmac->ctx == NULL)
+    {
+      restore_error_queue_scope (marked);
+      g_free (hmac);
+      return NULL;
+    }
+
+  if (effective_key == NULL)
+    effective_key = &empty_key;
+
+  {
+    OSSL_PARAM params[] = {
+      OSSL_PARAM_utf8_string (OSSL_MAC_PARAM_DIGEST, (char *) digest_name, 0),
+      OSSL_PARAM_END
+    };
+
+    init_result = openssl_loader.table.loaded_EVP_MAC_init (hmac->ctx, effective_key, key_len, params);
+  }
+  if (init_result != 1)
+    {
+      openssl_loader.table.loaded_EVP_MAC_CTX_free (hmac->ctx);
+      restore_error_queue_scope (marked);
+      g_free (hmac);
+      return NULL;
+    }
+
+  mac_size = openssl_loader.table.loaded_EVP_MAC_CTX_get_mac_size (hmac->ctx);
+  if (mac_size != digest_len)
+    {
+      openssl_loader.table.loaded_EVP_MAC_CTX_free (hmac->ctx);
+      restore_error_queue_scope (marked);
+      g_free (hmac);
+      return NULL;
+    }
+
+  restore_error_queue_scope (marked);
+  return hmac;
+}
+
+GHmac *
+g_hmac_copy (const GHmac *hmac)
+{
+  GHmac *copy;
+
+  g_return_val_if_fail (hmac != NULL, NULL);
+
+  copy = g_new0 (GHmac, 1);
+  copy->ref_count = 1;
+  copy->digest_type = hmac->digest_type;
+  copy->digest_len = hmac->digest_len;
+  copy->closed = hmac->closed;
+
+  if (hmac->closed)
+    {
+      memcpy (copy->digest, hmac->digest, hmac->digest_len);
+      if (hmac->digest_str != NULL)
+        copy->digest_str = g_strdup (hmac->digest_str);
+      return copy;
+    }
+
+  {
+    gboolean marked = openssl_loader.table.loaded_ERR_set_mark () == 1;
+    copy->ctx = openssl_loader.table.loaded_EVP_MAC_CTX_dup (hmac->ctx);
+    restore_error_queue_scope (marked);
+  }
+
+  if (copy->ctx == NULL)
+    g_error ("OpenSSL backend failure in g_hmac_copy: EVP_MAC_CTX_dup");
+
+  return copy;
+}
+
+GHmac *
+g_hmac_ref (GHmac *hmac)
+{
+  g_return_val_if_fail (hmac != NULL, NULL);
+
+  g_atomic_int_inc (&hmac->ref_count);
+
+  return hmac;
+}
+
+void
+g_hmac_unref (GHmac *hmac)
+{
+  g_return_if_fail (hmac != NULL);
+
+  if (g_atomic_int_dec_and_test (&hmac->ref_count))
+    {
+      if (!hmac->closed && hmac->ctx != NULL)
+        {
+          gboolean marked = openssl_loader.table.loaded_ERR_set_mark () == 1;
+          openssl_loader.table.loaded_EVP_MAC_CTX_free (hmac->ctx);
+          restore_error_queue_scope (marked);
+        }
+
+      g_free (hmac->digest_str);
+      g_free (hmac);
+    }
+}
+
+void
+g_hmac_update (GHmac        *hmac,
+               const guchar *data,
+               gssize        length)
+{
+  gboolean marked;
+  int update_status;
+  size_t update_len;
+
+  g_return_if_fail (hmac != NULL);
+  g_return_if_fail (length == 0 || data != NULL);
+
+  if (hmac->closed)
+    {
+      g_warning ("g_hmac_update: HMAC context is already closed");
+      return;
+    }
+
+  if (length < 0)
+    update_len = strlen ((const gchar *) data);
+  else
+    update_len = (size_t) length;
+
+  if (update_len == 0)
+    return;
+
+  marked = openssl_loader.table.loaded_ERR_set_mark () == 1;
+  update_status = openssl_loader.table.loaded_EVP_MAC_update (hmac->ctx, data, update_len);
+  restore_error_queue_scope (marked);
+
+  if (update_status != 1)
+    g_error ("OpenSSL backend failure in g_hmac_update: EVP_MAC_update");
+}
+
+const gchar *
+g_hmac_get_string (GHmac *hmac)
+{
+  g_return_val_if_fail (hmac != NULL, NULL);
+
+  if (!ensure_closed (hmac))
+    g_error ("OpenSSL backend failure in g_hmac_get_string: EVP_MAC_final");
+
+  if (hmac->digest_str == NULL)
+    hmac->digest_str = gchecksum_digest_to_string (hmac->digest, hmac->digest_len);
+
+  return hmac->digest_str;
+}
+
+void
+g_hmac_get_digest (GHmac  *hmac,
+                   guint8 *buffer,
+                   gsize  *digest_len)
+{
+  g_return_if_fail (hmac != NULL);
+  g_return_if_fail (buffer != NULL);
+  g_return_if_fail (digest_len != NULL);
+  g_return_if_fail (*digest_len >= hmac->digest_len);
+
+  if (!ensure_closed (hmac))
+    g_error ("OpenSSL backend failure in g_hmac_get_digest: EVP_MAC_final");
+
+  memcpy (buffer, hmac->digest, hmac->digest_len);
+  *digest_len = hmac->digest_len;
+}
diff --git a/glib/ghmac.c b/glib/ghmac.c
index ddb1635578db7c41fdd5dba39ab76d238705ffdd..972412fc12c96cc0bd5a1c127181142b54542a1e 100644
--- a/glib/ghmac.c
+++ b/glib/ghmac.c
@@ -35,31 +35,10 @@
 #include "gtypes.h"
 #include "glibintl.h"
 
-#ifdef USE_GNUTLS
+#if defined(USE_GNUTLS) || defined(USE_OPENSSL)
 #error "build configuration error"
 #endif
 
-/**
- * GHmac:
- *
- * HMACs should be used when producing a cookie or hash based on data
- * and a key. Simple mechanisms for using SHA1 and other algorithms to
- * digest a key and data together are vulnerable to various security
- * issues.
- * [HMAC](http://en.wikipedia.org/wiki/HMAC)
- * uses algorithms like SHA1 in a secure way to produce a digest of a
- * key and data.
- *
- * Both the key and data are arbitrary byte arrays of bytes or characters.
- *
- * Support for HMAC Digests has been added in GLib 2.30, and support for SHA-512
- * in GLib 2.42. Support for SHA-384 was added in GLib 2.52.
- *
- * To create a new `GHmac`, use [ctor@GLib.Hmac.new]. To free a `GHmac`, use
- * [method@GLib.Hmac.unref].
- *
- * Since: 2.30
- */
 
 struct _GHmac
 {
@@ -69,46 +48,6 @@ struct _GHmac
   GChecksum *digesto;
 };
 
-/**
- * g_hmac_new: (constructor)
- * @digest_type: the desired type of digest
- * @key: (array length=key_len): the key for the HMAC
- * @key_len: the length of the keys
- *
- * Creates a new #GHmac, using the digest algorithm @digest_type.
- * If the @digest_type is not known, %NULL is returned.
- * A #GHmac can be used to compute the HMAC of a key and an
- * arbitrary binary blob, using different hashing algorithms.
- *
- * A #GHmac works by feeding a binary blob through g_hmac_update()
- * until the data is complete; the digest can then be extracted
- * using g_hmac_get_string(), which will return the checksum as a
- * hexadecimal string; or g_hmac_get_digest(), which will return a
- * array of raw bytes. Once either g_hmac_get_string() or
- * g_hmac_get_digest() have been called on a #GHmac, the HMAC
- * will be closed and it won't be possible to call g_hmac_update()
- * on it anymore.
- *
- * Support for digests of type %G_CHECKSUM_SHA512 has been added in GLib 2.42.
- * Support for %G_CHECKSUM_SHA384 was added in GLib 2.52.
- *
- * Note that #GHmac creation may fail, in which case this function will
- * return %NULL. Since there is no error parameter, it is not possible
- * to indicate why.
- *
- * In Fedora, CentOS Stream, and Red Hat Enterprise Linux, GLib is
- * configured to use GnuTLS to implement #GHmac in order to support FIPS
- * compliance. This introduces additional failure possibilities that are
- * not present in upstream GLib. For example, the creation of a #GHmac
- * will fail if @digest_type is %G_CHECKSUM_MD5 and the system is
- * running in FIPS mode. #GHmac creation may also fail if GLib is unable
- * to load GnuTLS.
- *
- * Returns: (nullable) (transfer full): the newly created #GHmac, or %NULL.
- *   Use g_hmac_unref() to free the memory allocated by it.
- *
- * Since: 2.30
- */
 GHmac *
 g_hmac_new (GChecksumType  digest_type,
             const guchar  *key,
@@ -187,19 +126,6 @@ g_hmac_new (GChecksumType  digest_type,
   return hmac;
 }
 
-/**
- * g_hmac_copy:
- * @hmac: the #GHmac to copy
- *
- * Copies a #GHmac. If @hmac has been closed, by calling
- * g_hmac_get_string() or g_hmac_get_digest(), the copied
- * HMAC will be closed as well.
- *
- * Returns: (transfer full): the copy of the passed #GHmac. Use g_hmac_unref()
- *   when finished using it.
- *
- * Since: 2.30
- */
 GHmac *
 g_hmac_copy (const GHmac *hmac)
 {
@@ -216,18 +142,6 @@ g_hmac_copy (const GHmac *hmac)
   return copy;
 }
 
-/**
- * g_hmac_ref:
- * @hmac: a valid #GHmac
- *
- * Atomically increments the reference count of @hmac by one.
- *
- * This function is MT-safe and may be called from any thread.
- *
- * Returns: (transfer full): the passed in #GHmac.
- *
- * Since: 2.30
- **/
 GHmac *
 g_hmac_ref (GHmac *hmac)
 {
@@ -238,19 +152,6 @@ g_hmac_ref (GHmac *hmac)
   return hmac;
 }
 
-/**
- * g_hmac_unref:
- * @hmac: (transfer full): a #GHmac
- *
- * Atomically decrements the reference count of @hmac by one.
- *
- * If the reference count drops to 0, all keys and values will be
- * destroyed, and all memory allocated by the hash table is released.
- * This function is MT-safe and may be called from any thread.
- * Frees the memory allocated for @hmac.
- *
- * Since: 2.30
- */
 void
 g_hmac_unref (GHmac *hmac)
 {
@@ -264,19 +165,6 @@ g_hmac_unref (GHmac *hmac)
     }
 }
 
-/**
- * g_hmac_update:
- * @hmac: a #GHmac
- * @data: (array length=length): buffer used to compute the checksum
- * @length: size of the buffer, or -1 if it is a nul-terminated string
- *
- * Feeds @data into an existing #GHmac.
- *
- * The HMAC must still be open, that is g_hmac_get_string() or
- * g_hmac_get_digest() must not have been called on @hmac.
- *
- * Since: 2.30
- */
 void
 g_hmac_update (GHmac        *hmac,
                const guchar *data,
@@ -288,23 +176,6 @@ g_hmac_update (GHmac        *hmac,
   g_checksum_update (hmac->digesti, data, length);
 }
 
-/**
- * g_hmac_get_string:
- * @hmac: a #GHmac
- *
- * Gets the HMAC as a hexadecimal string.
- *
- * Once this function has been called the #GHmac can no longer be
- * updated with g_hmac_update().
- *
- * The hexadecimal characters will be lower case.
- *
