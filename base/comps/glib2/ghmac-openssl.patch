+      g_assert_cmpstr (g_hmac_get_string (hmac), ==, algo->expected_neglen);
+
+      g_hmac_unref (hmac);
+    }
+}
+
+static void
+test_hmac_get_digest_buffer_sizes_and_canaries (void)
+{
+  guint i;
+
+  for (i = 0; i < G_N_ELEMENTS (algorithm_cases); i++)
+    {
+      const AlgorithmCase *algo = &algorithm_cases[i];
+      GHmac *hmac;
+      guint8 exact_buf[128];
+      guint8 larger_buf[160];
+      gsize digest_len = g_checksum_type_get_length (algo->type);
+      gsize len;
+
+      hmac = g_hmac_new (algo->type, (const guint8 *) "key", 3);
+      g_assert_nonnull (hmac);
+      g_hmac_update (hmac, (const guint8 *) "abcdef", 6);
+
+      memset (exact_buf, 0xee, sizeof (exact_buf));
+      len = digest_len;
+      g_hmac_get_digest (hmac, exact_buf, &len);
+      g_assert_cmpuint (len, ==, digest_len);
+      {
+        gsize j;
+        for (j = digest_len; j < sizeof (exact_buf); j++)
+          g_assert_cmpuint (exact_buf[j], ==, 0xee);
+      }
+
+      memset (larger_buf, 0xcc, sizeof (larger_buf));
+      len = sizeof (larger_buf);
+      g_hmac_get_digest (hmac, larger_buf, &len);
+      g_assert_cmpuint (len, ==, digest_len);
+      g_assert_cmpmem (larger_buf, digest_len, exact_buf, digest_len);
+      {
+        gsize j;
+        for (j = digest_len; j < sizeof (larger_buf); j++)
+          g_assert_cmpuint (larger_buf[j], ==, 0xcc);
+      }
+      g_assert_cmpstr (g_hmac_get_string (hmac), ==, algo->expected_neglen);
+      g_hmac_unref (hmac);
+    }
+}
+#endif
+
+#ifdef USE_OPENSSL
+static void
+test_hmac_oversized_key_open_ssl (void)
+{
+  static const guint8 sentinel = 0x5a;
+  GHmac *hmac;
+  gsize key_len = (gsize) G_MAXINT + 1;
+
+  g_test_expect_message (G_LOG_DOMAIN, G_LOG_LEVEL_CRITICAL,
+                         "*g_hmac_new: OpenSSL backend requires key_len <= G_MAXINT*");
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, &sentinel, key_len);
+  g_test_assert_expected_messages ();
+  g_assert_null (hmac);
+}
+#endif
+
 int
 main (int argc,
     char **argv)
@@ -556,6 +1206,30 @@ main (int argc,
   g_test_add_func ("/hmac/for-data", test_hmac_for_data);
   g_test_add_func ("/hmac/for-string", test_hmac_for_string);
   g_test_add_func ("/hmac/for-bytes", test_hmac_for_bytes);
+  g_test_add_func ("/hmac/null-zero-key", test_hmac_null_zero_key);
+  g_test_add_func ("/hmac/empty-message-all-algorithms", test_hmac_empty_message_all_algorithms);
+  g_test_add_func ("/hmac/embedded-nul-all-algorithms", test_hmac_embedded_nul_all_algorithms);
+  g_test_add_func ("/hmac/split-update", test_hmac_split_update_matches_oneshot);
+  g_test_add_func ("/hmac/negative-length", test_hmac_negative_length_matches_explicit);
+  g_test_add_func ("/hmac/block-size-boundaries", test_hmac_key_block_size_boundaries);
+  g_test_add_func ("/hmac/copy-open-diverges", test_hmac_copy_open_diverges);
+#ifdef USE_OPENSSL
+  g_test_add_func ("/hmac/copy-closed-after-source-unref/digest-then-string",
+                   test_hmac_copy_closed_after_source_unref_digest_then_string);
+  g_test_add_func ("/hmac/copy-closed-after-source-unref/string-then-digest",
+                   test_hmac_copy_closed_after_source_unref_string_then_digest);
+#endif
+  g_test_add_func ("/hmac/ref-unref-threads", test_hmac_quiescent_thread_ref_unref);
+  g_test_add_func ("/hmac/first-use-concurrent-success", test_hmac_concurrent_first_use_success_subprocess);
+#ifdef USE_OPENSSL
+  g_test_add_func ("/hmac/closed-update-warns", test_hmac_closed_update_warns);
+#endif
+#ifdef USE_OPENSSL
+  g_test_add_func ("/hmac/get-digest-small-buffer", test_hmac_get_digest_small_buffer);
+  g_test_add_func ("/hmac/get-digest-buffer-sizes-and-canaries",
+                   test_hmac_get_digest_buffer_sizes_and_canaries);
+  g_test_add_func ("/hmac/openssl/oversized-key", test_hmac_oversized_key_open_ssl);
+#endif
 
   return g_test_run ();
 }
