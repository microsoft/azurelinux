+typedef struct
+{
+  GMutex lock;
+  GCond ready_cond;
+  GCond start_cond;
+  guint waiting;
+  guint target;
+  gboolean start;
+  gint failures;
+} FirstUseState;
+
+static gpointer
+hmac_first_use_worker (gpointer user_data)
+{
+  FirstUseState *state = user_data;
+  GHmac *hmac;
+  const gchar *digest;
+
+  g_mutex_lock (&state->lock);
+  state->waiting++;
+  if (state->waiting == state->target)
+    g_cond_signal (&state->ready_cond);
+  while (!state->start)
+    g_cond_wait (&state->start_cond, &state->lock);
+  g_mutex_unlock (&state->lock);
+
+  hmac = g_hmac_new (G_CHECKSUM_SHA256, (const guint8 *) "thread-key", 10);
+  if (hmac == NULL)
+    {
+      g_atomic_int_inc (&state->failures);
+      return NULL;
+    }
+
+  g_hmac_update (hmac, (const guint8 *) "thread-data", 11);
+  digest = g_hmac_get_string (hmac);
+  if (g_strcmp0 (digest, "36fef1ae2ee64705586107697319e2ba7c40fb62f82566568f048418743cc02c") != 0)
+    g_atomic_int_inc (&state->failures);
+  g_hmac_unref (hmac);
+
+  return NULL;
+}
+
+static void
+test_hmac_concurrent_first_use_success_subprocess (void)
+{
+  if (g_test_subprocess ())
+    {
+      FirstUseState state = { 0, };
+      GThread *threads[8];
+      guint n_threads = 0;
+      gint64 start_us;
+      gint64 elapsed_us;
+      gint64 wait_deadline;
+      gboolean all_waiting = TRUE;
+      guint i;
+
+      g_mutex_init (&state.lock);
+      g_cond_init (&state.ready_cond);
+      g_cond_init (&state.start_cond);
+
+      g_mutex_lock (&state.lock);
+      for (i = 0; i < G_N_ELEMENTS (threads); i++)
+        {
+          threads[i] = g_thread_new ("hmac-first-use", hmac_first_use_worker, &state);
+          g_assert_nonnull (threads[i]);
+          n_threads++;
+        }
+
+      state.target = n_threads;
+      wait_deadline = g_get_monotonic_time () + (G_TIME_SPAN_SECOND * 30);
+      while (state.waiting < state.target)
+        {
+          if (!g_cond_wait_until (&state.ready_cond, &state.lock, wait_deadline))
+            {
+              all_waiting = FALSE;
+              break;
+            }
+        }
+      start_us = g_get_monotonic_time ();
+      state.start = TRUE;
+      g_cond_broadcast (&state.start_cond);
+      g_mutex_unlock (&state.lock);
+
+      for (i = 0; i < n_threads; i++)
+        g_thread_join (threads[i]);
+      elapsed_us = g_get_monotonic_time () - start_us;
+
+      g_assert_true (all_waiting);
+      g_assert_cmpint (g_atomic_int_get (&state.failures), ==, 0);
+      g_assert_cmpint (elapsed_us < G_TIME_SPAN_SECOND * 10, ==, TRUE);
+      g_cond_clear (&state.start_cond);
+      g_cond_clear (&state.ready_cond);
+      g_mutex_clear (&state.lock);
+      return;
+    }
+
+  g_test_trap_subprocess ("/hmac/first-use-concurrent-success", G_TIME_SPAN_SECOND * 30, G_TEST_SUBPROCESS_DEFAULT);
+  g_test_trap_assert_passed ();
+}
