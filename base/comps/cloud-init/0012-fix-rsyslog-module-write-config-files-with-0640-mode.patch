+    def test_custom_and_packaged_filenames_use_restrictive_mode(self):
+        packaged_filename = os.path.join(self.tmp, "21-cloudinit.conf")
+        custom_filename = os.path.join(self.tmp, "custom.conf")
+
+        util.write_file(packaged_filename, "stale\n", mode=0o644, omode="wb")
+
+        with mock.patch(
+            "cloudinit.config.cc_rsyslog.util.write_file",
+            wraps=util.write_file,
+        ) as m_write:
+            changed = apply_rsyslog_changes(
+                configs=[
+                    {"content": "line-1", "filename": "21-cloudinit.conf"},
+                    {"content": "line-2", "filename": "21-cloudinit.conf"},
+                    {"content": "custom-line", "filename": "custom.conf"},
+                ],
+                def_fname="20-cloud-config.conf",
+                cfg_dir=self.tmp,
+            )
+
+        self.assertEqual([packaged_filename, custom_filename], changed)
+        self.assertEqual("line-1\nline-2\n", util.load_text_file(packaged_filename))
+        self.assertEqual("custom-line\n", util.load_text_file(custom_filename))
+        self.assertEqual(stat.S_IMODE(os.stat(packaged_filename).st_mode), 0o640)
+        self.assertEqual(stat.S_IMODE(os.stat(custom_filename).st_mode), 0o640)
+        self.assertEqual(3, len(m_write.call_args_list))
+        self.assertEqual("wb", m_write.call_args_list[0].kwargs["omode"])
+        self.assertEqual("ab", m_write.call_args_list[1].kwargs["omode"])
+        self.assertEqual("wb", m_write.call_args_list[2].kwargs["omode"])
+        for call in m_write.call_args_list:
+            self.assertEqual(0o640, call.kwargs["mode"])
 
