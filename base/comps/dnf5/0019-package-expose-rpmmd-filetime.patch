+++ b/test/libdnf5/rpm/test_package.cpp
@@ -128,6 +128,14 @@ void RpmPackageTest::test_get_build_time() {
     CPPUNIT_ASSERT_EQUAL(456LLU, get_pkg("pkg-1.2-3.x86_64").get_build_time());
 }
 
+void RpmPackageTest::test_get_file_time() {
+    auto package = get_pkg("pkg-1.2-3.x86_64");
+    CPPUNIT_ASSERT(package.get_file_time().has_value());
+    CPPUNIT_ASSERT_EQUAL(123LLU, *package.get_file_time());
+    CPPUNIT_ASSERT_EQUAL(456LLU, package.get_build_time());
+    CPPUNIT_ASSERT(!get_pkg("unresolvable-1:2-3.noarch").get_file_time().has_value());
+}
