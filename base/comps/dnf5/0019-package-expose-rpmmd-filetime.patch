 include/libdnf5/rpm/package.hpp                        |  4 ++++
 libdnf5/rpm/package.cpp                                | 10 ++++++++++
 .../repos-repomd/repomd-repo1/repodata/primary.xml     |  2 +-
 .../data/repos-repomd/repomd-repo1/repodata/repomd.xml |  8 ++++----
 test/libdnf5/rpm/test_package.cpp                      |  8 ++++++++
 test/libdnf5/rpm/test_package.hpp                      |  2 ++
 test/python3/libdnf5/rpm/test_package_query.py         |  5 +++++
 8 files changed, 36 insertions(+), 5 deletions(-)

diff --git a/bindings/libdnf5/rpm.i b/bindings/libdnf5/rpm.i
index fe1e5e9..8b14964 100644
--- a/bindings/libdnf5/rpm.i
+++ b/bindings/libdnf5/rpm.i
@@ -86,6 +86,8 @@ add_hash(libdnf5::rpm::Reldep)
 add_str(libdnf5::rpm::Package)
 add_repr(libdnf5::rpm::Package)
 add_hash(libdnf5::rpm::Package)
+// SWIG has no optional<unsigned long long> conversion here; expose the C++ API only.
+%ignore libdnf5::rpm::Package::get_file_time;
 %include "libdnf5/rpm/package.hpp"
 
 %template(VectorPackage) std::vector<libdnf5::rpm::Package>;
diff --git a/include/libdnf5/rpm/package.hpp b/include/libdnf5/rpm/package.hpp
index c240a3d..8018d02 100644
--- a/include/libdnf5/rpm/package.hpp
+++ b/include/libdnf5/rpm/package.hpp
@@ -29,6 +29,7 @@ along with libdnf.  If not, see <https://www.gnu.org/licenses/>.
 #include "libdnf5/repo/repo_weak.hpp"
 #include "libdnf5/transaction/transaction_item_reason.hpp"
 
+#include <optional>
 #include <set>
 #include <string>
 #include <vector>
@@ -242,6 +243,9 @@ public:
     // @replaces libdnf:libdnf/hy-package.h:function:dnf_package_get_buildtime(DnfPackage * pkg)
     unsigned long long get_build_time() const;
 
+    /// @return File timestamp from repository rpm-md metadata, if present.
+    std::optional<unsigned long long> get_file_time() const;
+
     // TODO not supported by libsolv: https://github.com/openSUSE/libsolv/issues/400
     //std::string get_build_host();
 
diff --git a/libdnf5/rpm/package.cpp b/libdnf5/rpm/package.cpp
index bb7a7a3..cdc52a7 100644
--- a/libdnf5/rpm/package.cpp
+++ b/libdnf5/rpm/package.cpp
@@ -176,6 +176,16 @@ unsigned long long Package::get_build_time() const {
     return get_rpm_pool(p_impl->base).lookup_num(p_impl->id.id, SOLVABLE_BUILDTIME);
 }
 
+std::optional<unsigned long long> Package::get_file_time() const {
+    auto & pool = get_rpm_pool(p_impl->base);
+    auto * solvable = pool.id2solvable(p_impl->id.id);
+    libdnf5::solv::get_repo(solvable).internalize();
+    if (solvable_lookup_type(solvable, SOLVABLE_FILETIME) != REPOKEY_TYPE_NUM) {
+        return std::nullopt;
+    }
+    return solvable_lookup_num(solvable, SOLVABLE_FILETIME, 0);
+}
+
