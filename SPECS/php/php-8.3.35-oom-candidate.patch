diff --git a/ext/soap/tests/oom_http_server.inc b/ext/soap/tests/oom_http_server.inc
new file mode 100644
index 00000000000..f9aa31e32ea
--- /dev/null
+++ b/ext/soap/tests/oom_http_server.inc
@@ -0,0 +1,69 @@
+<?php
+
+/* Minimal single-shot raw HTTP server for OOM tests */
+function oom_soap_http_server(string $response, string $repeat = '', int $times = 0): array
+{
+    $code = <<<'PHP'
+        $server = stream_socket_server('tcp://127.0.0.1:0', $errno, $errstr);
+        if (!$server) {
+            fwrite(STDERR, "bind failed: $errstr\n");
+            exit(1);
+        }
+        echo stream_socket_get_name($server, false), "\n";
+        $conn = stream_socket_accept($server, 10);
+        if ($conn === false) {
+            exit(1);
+        }
+        $length = 0;
+        while (($line = fgets($conn)) !== false && rtrim($line, "\r\n") !== '') {
+            if (preg_match('/^Content-Length:\s*(\d+)/i', $line, $m)) {
+                $length = (int) $m[1];
+            }
+        }
+        while ($length > 0 && !feof($conn)) {
+            $chunk = fread($conn, $length);
+            if ($chunk === false || $chunk === '') {
+                break;
+            }
+            $length -= strlen($chunk);
+        }
+        fwrite($conn, $argv[1]);
+        /* Optionally keep appending $argv[2] so a test can make the server
+         * produce far more than the client's memory limit without the parent
+         * having to hold it, or pass it on the command line. */
+        for ($i = 0; $i < (int) $argv[3]; $i++) {
+            if (@fwrite($conn, $argv[2]) === false) {
+                break;
+            }
+        }
+        fflush($conn);
+        fclose($conn);
+        PHP;
+
+    $proc = proc_open(
+        [PHP_BINARY, '-n', '-d', 'memory_limit=-1', '-r', $code, $response, $repeat, (string) $times],
+        [1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
+        $pipes,
+    );
+    if (!is_resource($proc)) {
+        die('could not start the helper server');
+    }
+    $address = trim((string) fgets($pipes[1]));
+    if ($address === '') {
+        die('helper server did not report an address: ' . stream_get_contents($pipes[2]));
+    }
+
+    return ['proc' => $proc, 'uri' => 'http://' . $address];
+}
+
+function oom_soap_http_server_skipif(): void
+{
+    if (!function_exists('proc_open')) {
+        die('skip proc_open() not available');
+    }
+    $server = @stream_socket_server('tcp://127.0.0.1:0');
+    if (!$server) {
+        die('skip stream_socket_server() failed');
+    }
+    fclose($server);
+}
diff --git a/ext/soap/tests/oom_soap_response.inc b/ext/soap/tests/oom_soap_response.inc
new file mode 100644
index 00000000000..ab7bea9b8ca
--- /dev/null
+++ b/ext/soap/tests/oom_soap_response.inc
@@ -0,0 +1,33 @@
+<?php
+
+/* Builds a compact SOAP response for OOM tests */
+function oom_soap_response(int $dimensions, int $items): string
+{
+    $arrayType = 'xsd:string[' . implode(',', array_fill(0, $dimensions, 1)) . ']';
+    $items = str_repeat('<i/>', $items);
+
+    return <<<XML
+        <?xml version="1.0"?>
+        <SOAP-ENV:Envelope
+            xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/"
+            xmlns:SOAP-ENC="http://schemas.xmlsoap.org/soap/encoding/"
+            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
+            xmlns:ns1="http://test-uri/">
+          <SOAP-ENV:Body>
+            <ns1:fResponse><p SOAP-ENC:arrayType="$arrayType">$items</p></ns1:fResponse>
+          </SOAP-ENV:Body>
+        </SOAP-ENV:Envelope>
+        XML;
+}
+
+/* A SoapClient whose transport is replaced by a canned response, so that the
+ * reproducer exercises only the response decoder. */
+class OomSoapClient extends SoapClient
+{
+    public string $response = '';
+
+    public function __doRequest($request, $location, $action, $version, $oneWay = false): ?string
+    {
+        return $this->response;
+    }
+}
