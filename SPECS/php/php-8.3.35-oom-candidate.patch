+--SKIPIF--
+<?php
+require __DIR__ . "/oom_rfc1867_session_skipif.inc";
+if (getenv('SKIP_ASAN')) die("skip slow under ASan");
+?>
+--FILE--
+<?php
+require __DIR__ . '/oom_rfc1867.inc';
+
+$savePath = sys_get_temp_dir() . '/oom_rfc1867_sess';
