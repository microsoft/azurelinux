 	if err := s.store.Delete(ctx, dg); err != nil {
diff --git a/services/introspection/local.go b/services/introspection/local.go
index 7aa291b..4351b85 100644
--- a/services/introspection/local.go
+++ b/services/introspection/local.go
@@ -73,7 +73,7 @@ func (l *Local) UpdateLocal(root string) {
 func (l *Local) Plugins(ctx context.Context, req *api.PluginsRequest, _ ...grpc.CallOption) (*api.PluginsResponse, error) {
 	filter, err := filters.ParseAll(req.Filters...)
 	if err != nil {
-		return nil, errdefs.ToGRPCf(errdefs.ErrInvalidArgument, err.Error())
+		return nil, errdefs.ToGRPCf(errdefs.ErrInvalidArgument, "%s", err.Error())
 	}
 
 	var plugins []*api.Plugin
-- 
