diff --git a/tools/testing/selftests/net/test_vxlan_nh.sh b/tools/testing/selftests/net/test_vxlan_nh.sh
new file mode 100755
--- /dev/null
+++ b/tools/testing/selftests/net/test_vxlan_nh.sh
@@ -0,0 +1,314 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+
+source lib.sh
+TESTS="
+	basic_tx_ipv4
+	basic_tx_ipv6
+	learning
+	proxy_ipv4
+	proxy_ipv6
+"
+VERBOSE=0
+PAUSE_ON_FAIL=no
+ret=0
+
+################################################################################
+# Utilities
+
+check_err()
+{
+	if [ "$1" -ne 0 ]; then
+		RET=1
+		echo "ERROR: $2"
+	fi
+}
+
+log_test()
+{
+	if [ "$RET" -eq 0 ]; then
+		printf "TEST: %-60s  [ OK ]\n" "$1"
+	else
+		ret=1
+		printf "TEST: %-60s  [FAIL]\n" "$1"
+		if [ "$PAUSE_ON_FAIL" = yes ]; then
+			read -r -p "Hit enter to continue, 'q' to quit: " answer
+			[ "$answer" = q ] && exit 1
+		fi
+	fi
+}
+
+run_cmd()
+{
+	local cmd="$1"
+	local out
+	local rc
+
+	if [ "$VERBOSE" = "1" ]; then
+		echo "COMMAND: $cmd"
+	fi
+
+	out=$(eval "$cmd" 2>&1)
+	rc=$?
+	if { [ "$VERBOSE" -eq 1 ] || [ "$rc" -ne 0 ]; } &&
+	   [ -n "$out" ]; then
+		echo "    $out"
+	fi
+	check_err "$rc" "Command failed: $cmd"
+
+	return $rc
+}
+
+################################################################################
+# Tests
+
+tc_packets_get()
+{
+	tc -n "$ns1" -j -s filter show dev dummy1 egress |
+		jq -er --argjson handle "$1" \
+			'.[] | select(.options.handle == $handle) |
+			 .options.actions[0].stats.packets'
+}
+
+tc_check_packets()
+{
+	local packets
+
+	packets=$(tc_packets_get "$1") || return 1
+	case "$2" in
+	-eq) [ "$packets" -eq "$3" ];;
+	-gt) [ "$packets" -gt "$3" ];;
+	*) echo "ERROR: Invalid packet-counter comparison: $2"; return 1;;
+	esac
+}
+
+basic_tx_common()
+{
+	local af_str=$1; shift
+	local proto=$1; shift
+	local local_addr=$1; shift
+	local plen=$1; shift
+	local remote_addr=$1; shift
+	local port
+	local default_packets
+	local override_packets
+
+	RET=0
+
+	# Verify outer UDP ports without requiring nexthop group statistics.
+
+	run_cmd "ip -n $ns1 link add name dummy1 up type dummy"
+	run_cmd "ip -n $ns1 route add $remote_addr/$plen dev dummy1"
+	run_cmd "tc -n $ns1 qdisc add dev dummy1 clsact"
+	run_cmd "tc -n $ns1 filter add dev dummy1 egress proto $proto pref 1 handle 101 flower ip_proto udp dst_ip $remote_addr dst_port 4789 action pass"
+
+	run_cmd "ip -n $ns1 address add $local_addr/$plen dev lo"
+
+	run_cmd "ip -n $ns1 nexthop add id 1 via $remote_addr fdb"
+	run_cmd "ip -n $ns1 nexthop add id 10 group 1 fdb"
+
+	run_cmd "ip -n $ns1 link add name vx0 up type vxlan id 10010 local $local_addr dstport 4789"
+	run_cmd "bridge -n $ns1 fdb add 00:11:22:33:44:55 dev vx0 self static nhid 10"
+
+	run_cmd "ip netns exec $ns1 mausezahn vx0 -a own -b 00:11:22:33:44:55 -c 1 -q"
+
+	busywait "$BUSYWAIT_TIMEOUT" tc_check_packets 101 -eq 1
+	check_err $? "tc filter stats did not increase"
+
+	# Add a second FDB nexthop group whose nexthop carries a per-nexthop
+	# destination port (NHA_DST_PORT) that differs from the VXLAN device
+	# default. Matching outer traffic must egress with that port, so a
+	# separate flower filter keyed on the new port catches it.
+	run_cmd "tc -n $ns1 filter add dev dummy1 egress proto $proto \
+		pref 1 handle 102 flower ip_proto udp dst_ip $remote_addr \
+		dst_port 4790 action pass"
+
+	run_cmd "ip -n $ns1 nexthop add id 2 via $remote_addr fdb dst_port 4790"
+	run_cmd "ip -n $ns1 nexthop add id 20 group 2 fdb"
+
+	run_cmd "bridge -n $ns1 fdb add 00:11:22:33:44:66 dev vx0 \
+		self static nhid 20"
+
+	run_cmd "ip netns exec $ns1 mausezahn vx0 -a own \
+		-b 00:11:22:33:44:66 -c 1 -q"
+
+	busywait "$BUSYWAIT_TIMEOUT" tc_check_packets 102 -eq 1
+	check_err $? "tc filter stats did not increase (with port)"
+
+	# Both members share the underlay IP and VNI. Vary the inner flow.
+	run_cmd "ip -n $ns1 nexthop add id 30 group 1/2 fdb"
+	run_cmd "bridge -n $ns1 fdb add 00:11:22:33:44:77 dev vx0 self static nhid 30"
+	for port in $(seq 1024 1087); do
+		run_cmd "ip netns exec $ns1 mausezahn vx0 -a own \
+			-b 00:11:22:33:44:77 -A 198.51.100.1 -B 198.51.100.2 \
+			-t udp 'sp=$port,dp=9' -c 1 -q"
+	done
+	busywait "$BUSYWAIT_TIMEOUT" tc_check_packets 101 -gt 1
+	check_err $? "ECMP did not use the device-default port"
+	busywait "$BUSYWAIT_TIMEOUT" tc_check_packets 102 -gt 1
+	check_err $? "ECMP did not use the per-nexthop port"
+
+	default_packets=$(tc_packets_get 101)
+	check_err $? "Could not read device-default port counter"
+	override_packets=$(tc_packets_get 102)
+	check_err $? "Could not read per-nexthop port counter"
+
+	run_cmd "tc -n $ns1 filter add dev dummy1 egress proto $proto \
+		pref 1 handle 103 flower ip_proto udp dst_ip $remote_addr \
+		dst_port 5790 action pass"
+	run_cmd "ip -n $ns1 nexthop replace id 2 via $remote_addr fdb dst_port 5790"
+	run_cmd "ip netns exec $ns1 mausezahn vx0 -a own \
+		-b 00:11:22:33:44:66 -c 1 -q"
+	busywait "$BUSYWAIT_TIMEOUT" tc_check_packets 103 -eq 1
+	check_err $? "Nexthop replacement did not change the outer UDP port"
+	tc_check_packets 102 -eq "$override_packets"
+	check_err $? "Traffic still used the old per-nexthop port"
+
+	run_cmd "ip -n $ns1 nexthop replace id 2 via $remote_addr fdb"
+	run_cmd "ip netns exec $ns1 mausezahn vx0 -a own \
+		-b 00:11:22:33:44:66 -c 1 -q"
+	busywait "$BUSYWAIT_TIMEOUT" tc_check_packets 101 -eq "$((default_packets + 1))"
+	check_err $? "Removing dst_port did not restore the device-default port"
+
+	log_test "VXLAN FDB nexthop: $af_str basic Tx"
+}
+
+basic_tx_ipv4()
+{
+	basic_tx_common "IPv4" ipv4 192.0.2.1 32 192.0.2.2
+}
+
+basic_tx_ipv6()
+{
+	basic_tx_common "IPv6" ipv6 2001:db8:1::1 128 2001:db8:1::2
+}
+
+learning()
+{
+	RET=0
+
+	# When learning is enabled on the VXLAN device, an incoming packet
+	# might try to refresh an FDB entry that points to an FDB nexthop group
+	# instead of an ordinary remote destination. Check that the kernel does
+	# not crash in this situation.
+
+	run_cmd "ip -n $ns1 address add 192.0.2.1/32 dev lo"
+	run_cmd "ip -n $ns1 address add 192.0.2.2/32 dev lo"
+
+	run_cmd "ip -n $ns1 nexthop add id 1 via 192.0.2.3 fdb"
+	run_cmd "ip -n $ns1 nexthop add id 10 group 1 fdb"
+
+	run_cmd "ip -n $ns1 link add name vx0 up type vxlan id 10010 local 192.0.2.1 dstport 12345 localbypass"
+	run_cmd "ip -n $ns1 link add name vx1 up type vxlan id 10020 local 192.0.2.2 dstport 54321 learning"
+
+	run_cmd "bridge -n $ns1 fdb add 00:11:22:33:44:55 dev vx0 self static dst 192.0.2.2 port 54321 vni 10020"
+	run_cmd "bridge -n $ns1 fdb add 00:aa:bb:cc:dd:ee dev vx1 self static nhid 10"
+
+	run_cmd "ip netns exec $ns1 mausezahn vx0 -a 00:aa:bb:cc:dd:ee -b 00:11:22:33:44:55 -c 1 -q"
+
+	log_test "VXLAN FDB nexthop: learning"
+}
+
+proxy_common()
+{
+	local af_str=$1; shift
+	local local_addr=$1; shift
+	local plen=$1; shift
+	local remote_addr=$1; shift
+	local neigh_addr=$1; shift
+	local ping_cmd=$1; shift
+
+	RET=0
+
+	# When the "proxy" option is enabled on the VXLAN device, the device
+	# will suppress ARP requests and IPv6 Neighbor Solicitation messages if
+	# it is able to reply on behalf of the remote host. That is, if a
+	# matching and valid neighbor entry is configured on the VXLAN device
+	# whose MAC address is not behind the "any" remote (0.0.0.0 / ::). The
+	# FDB entry for the neighbor's MAC address might point to an FDB
+	# nexthop group instead of an ordinary remote destination. Check that
+	# the kernel does not crash in this situation.
+
+	run_cmd "ip -n $ns1 address add $local_addr/$plen dev lo"
+
+	run_cmd "ip -n $ns1 nexthop add id 1 via $remote_addr fdb"
+	run_cmd "ip -n $ns1 nexthop add id 10 group 1 fdb"
+
+	run_cmd "ip -n $ns1 link add name vx0 up type vxlan id 10010 local $local_addr dstport 4789 proxy"
+
+	run_cmd "ip -n $ns1 neigh add $neigh_addr lladdr 00:11:22:33:44:55 nud perm dev vx0"
+
+	run_cmd "bridge -n $ns1 fdb add 00:11:22:33:44:55 dev vx0 self static nhid 10"
+
+	run_cmd "ip netns exec $ns1 $ping_cmd"
+
+	log_test "VXLAN FDB nexthop: $af_str proxy"
+}
+
+proxy_ipv4()
+{
+	proxy_common "IPv4" 192.0.2.1 32 192.0.2.2 192.0.2.3 \
+		"arping -b -c 1 -s 192.0.2.1 -I vx0 192.0.2.3"
+}
+
+proxy_ipv6()
+{
+	proxy_common "IPv6" 2001:db8:1::1 128 2001:db8:1::2 2001:db8:1::3 \
+		"ndisc6 -r 1 -s 2001:db8:1::1 -w 1 2001:db8:1::3 vx0"
+}
+
+################################################################################
+# Usage
+
+usage()
+{
+	cat <<EOF
+usage: ${0##*/} OPTS
+
+        -t <test>   Test(s) to run (default: all)
+                    (options: $TESTS)
+        -p          Pause on fail
+        -v          Verbose mode (show commands and output)
+EOF
+}
+
+################################################################################
+# Main
+
+while getopts ":t:pvh" opt; do
+	case $opt in
+		t) TESTS=$OPTARG;;
+		p) PAUSE_ON_FAIL=yes;;
+		v) VERBOSE=$((VERBOSE + 1));;
+		h) usage; exit 0;;
+		*) usage; exit 1;;
+	esac
+done
+
+if [ "$(id -u)" -ne 0 ]; then
+	echo "SKIP: Need root privileges"
+	exit "$ksft_skip"
+fi
+
+for cmd in ip bridge tc mausezahn arping ndisc6 jq; do
+	if ! command -v "$cmd" > /dev/null 2>&1; then
+		echo "SKIP: Missing command: $cmd"
+		exit "$ksft_skip"
+	fi
+done
+
+if ! ip nexthop help 2>&1 | grep -q "dst_port"; then
+	echo "SKIP: iproute2 ip too old, missing nexthop dst_port support"
+	exit "$ksft_skip"
+fi
+
+trap cleanup_all_ns EXIT
+
+for t in $TESTS
+do
+	setup_ns ns1 || exit "$ksft_skip"
+	$t
+	cleanup_all_ns
+done
+
+exit "$ret"
