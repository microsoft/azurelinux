--- a/fs/btrfs/super.c
+++ b/fs/btrfs/super.c
@@ -2355,6 +2355,46 @@ static int btrfs_show_devname(struct seq_file *m, struct dentry *root)
 	return 0;
 }
 
+static struct block_device *btrfs_get_integrity_bdev(struct super_block *sb)
+{
+	struct btrfs_fs_info *fs_info = btrfs_sb(sb);
+	struct btrfs_fs_devices *fs_devices = fs_info->fs_devices;
+	struct btrfs_device *device;
+	struct block_device *bdev = NULL;
+
+	if (!sb_rdonly(sb))
+		return NULL;
+
+	/* Match the device-list -> replacement lock order in dev-replace.c. */
+	mutex_lock(&fs_devices->device_list_mutex);
+	down_read(&fs_info->dev_replace.rwsem);
+	if (!sb_rdonly(sb) || btrfs_test_opt(fs_info, DEGRADED) ||
+	    fs_devices->seeding || !list_empty(&fs_devices->seed_list) ||
+	    fs_devices->num_devices != 1 || fs_devices->open_devices != 1 ||
+	    fs_devices->total_devices != 1 || fs_devices->missing_devices ||
+	    fs_devices->rw_devices || !list_is_singular(&fs_devices->devices) ||
+	    btrfs_dev_replace_is_ongoing(&fs_info->dev_replace))
+		goto out;
+
+	device = list_first_entry(&fs_devices->devices,
+				  struct btrfs_device, dev_list);
+	if (device->fs_devices != fs_devices || device->fs_info != fs_info ||
+	    !device->bdev || !bdev_read_only(device->bdev) ||
+	    !test_bit(BTRFS_DEV_STATE_IN_FS_METADATA, &device->dev_state) ||
+	    test_bit(BTRFS_DEV_STATE_WRITEABLE, &device->dev_state) ||
+	    test_bit(BTRFS_DEV_STATE_MISSING, &device->dev_state) ||
+	    test_bit(BTRFS_DEV_STATE_REPLACE_TGT, &device->dev_state) ||
+	    device->devid == BTRFS_DEV_REPLACE_DEVID)
+		goto out;
+
+	if (get_device(&device->bdev->bd_device))
+		bdev = device->bdev;
+out:
+	up_read(&fs_info->dev_replace.rwsem);
+	mutex_unlock(&fs_devices->device_list_mutex);
+	return bdev;
+}
+
 static const struct super_operations btrfs_super_ops = {
 	.drop_inode	= btrfs_drop_inode,
 	.evict_inode	= btrfs_evict_inode,
@@ -2369,6 +2409,7 @@ static const struct super_operations btrfs_super_ops = {
 	.remount_fs	= btrfs_remount,
 	.freeze_fs	= btrfs_freeze,
 	.unfreeze_fs	= btrfs_unfreeze,
+	.get_integrity_bdev = btrfs_get_integrity_bdev,
 };
 
