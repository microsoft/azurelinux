+
+	/*
+	 * Optional integrity backing device for filesystems without s_bdev.
+	 * The caller holds an inode reference and may sleep. Return NULL when
+	 * one immutable device cannot represent the complete filesystem.
+	 * A non-NULL result holds a bd_device reference, released by the caller.
+	 */
+	struct block_device *(*get_integrity_bdev)(struct super_block *sb);
 };
 
