Backport to Azure Linux 6.6.161.1: Apply before enabling unlocked requests.
Keep the 6.6 monolithic route constructor and its existing GFP flags,
avoiding the split plus preallocation/factorisation changes that upstream
later reverted. Limit RCU to the nexthop branch, including its non-sleeping
preferred-source validation so the nexthop-owned device stays valid. Add
the upstream local RCU guards to route purge, multipath rebalance and
notification; no outer RCU section is introduced.

Signed-off-by: Alex Cortelyou <alcortel@microsoft.com>
---
 net/ipv6/ip6_fib.c |  9 +++++++--
 net/ipv6/route.c   | 32 ++++++++++++++++++++++++--------
 2 files changed, 31 insertions(+), 10 deletions(-)

diff --git a/net/ipv6/ip6_fib.c b/net/ipv6/ip6_fib.c
index 828e5a0..c5aeb9c 100644
--- a/net/ipv6/ip6_fib.c
+++ b/net/ipv6/ip6_fib.c
@@ -1035,8 +1035,9 @@ static void fib6_drop_pcpu_from(struct fib6_info *f6i,
 			.table = table
 		};
 
-		nexthop_for_each_fib6_nh(f6i->nh, fib6_nh_drop_pcpu_from,
-					 &arg);
+		rcu_read_lock();
+		nexthop_for_each_fib6_nh(f6i->nh, fib6_nh_drop_pcpu_from, &arg);
+		rcu_read_unlock();
 	} else {
 		struct fib6_nh *fib6_nh;
 
@@ -1236,7 +1237,9 @@ next_iter:
 			fib6_nsiblings++;
 		}
 		BUG_ON(fib6_nsiblings != rt->fib6_nsiblings);
+		rcu_read_lock();
 		rt6_multipath_rebalance(temp_sibling);
+		rcu_read_unlock();
 	}
 
 	/*
@@ -1280,7 +1283,9 @@ add:
 						   sibling->fib6_nsiblings - 1);
 				WRITE_ONCE(rt->fib6_nsiblings, 0);
 				list_del_rcu(&rt->fib6_siblings);
+				rcu_read_lock();
 				rt6_multipath_rebalance(next_sibling);
+				rcu_read_unlock();
 				return err;
 			}
 		}
diff --git a/net/ipv6/route.c b/net/ipv6/route.c
index a2ec1b6..f747dbb 100644
--- a/net/ipv6/route.c
+++ b/net/ipv6/route.c
@@ -1826,11 +1826,13 @@ static int rt6_nh_flush_exceptions(struct fib6_nh *nh, void *arg)
 
 void rt6_flush_exceptions(struct fib6_info *f6i)
 {
-	if (f6i->nh)
-		nexthop_for_each_fib6_nh(f6i->nh, rt6_nh_flush_exceptions,
-					 f6i);
-	else
+	if (f6i->nh) {
+		rcu_read_lock();
+		nexthop_for_each_fib6_nh(f6i->nh, rt6_nh_flush_exceptions, f6i);
+		rcu_read_unlock();
+	} else {
 		fib6_nh_flush_exceptions(f6i->fib6_nh, f6i);
+	}
 }
 
 /* Find cached rt in the hash table inside passed in rt
@@ -3835,26 +3837,28 @@ static struct fib6_info *ip6_route_info_create(struct fib6_config *cfg,
 	if (cfg->fc_nh_id) {
 		struct nexthop *nh;
 
+		rcu_read_lock();
+
 		nh = nexthop_find_by_id(net, cfg->fc_nh_id);
 		if (!nh) {
 			err = -EINVAL;
 			NL_SET_ERR_MSG(extack, "Nexthop id does not exist");
-			goto out_free;
+			goto out_unlock;
 		}
 
 		err = fib6_check_nexthop(nh, cfg, extack);
 		if (err)
-			goto out_free;
+			goto out_unlock;
 
 		if (rt->fib6_src.plen) {
 			NL_SET_ERR_MSG(extack, "Nexthops can not be used with source routing");
 			err = -EINVAL;
-			goto out_free;
+			goto out_unlock;
 		}
 		if (!nexthop_get(nh)) {
 			NL_SET_ERR_MSG(extack, "Nexthop has been deleted");
 			err = -ENOENT;
-			goto out_free;
+			goto out_unlock;
 		}
 
 		rt->nh = nh;
@@ -3888,10 +3892,16 @@ static struct fib6_info *ip6_route_info_create(struct fib6_config *cfg,
 	} else
 		rt->fib6_prefsrc.plen = 0;
 
+	if (rt->nh)
+		rcu_read_unlock();
 	return rt;
 out:
+	if (rt && rt->nh)
+		rcu_read_unlock();
 	fib6_info_release(rt);
 	return ERR_PTR(err);
+out_unlock:
+	rcu_read_unlock();
 out_free:
 	ip_fib_metrics_put(rt->fib6_metrics);
 	kfree(rt);
@@ -6258,6 +6268,8 @@ void inet6_rt_notify(int event, struct fib6_info *rt, struct nl_info *info,
 	err = -ENOBUFS;
 	seq = info->nlh ? info->nlh->nlmsg_seq : 0;
 
+	rcu_read_lock();
+
 	skb = nlmsg_new(rt6_nlmsg_size(rt), GFP_ATOMIC);
 	if (!skb)
 		goto errout;
@@ -6270,10 +6282,14 @@ void inet6_rt_notify(int event, struct fib6_info *rt, struct nl_info *info,
 		kfree_skb(skb);
 		goto errout;
 	}
+
+	rcu_read_unlock();
+
 	rtnl_notify(skb, net, info->portid, RTNLGRP_IPV6_ROUTE,
 		    info->nlh, GFP_ATOMIC);
 	return;
 errout:
+	rcu_read_unlock();
 	if (err < 0)
 		rtnl_set_sk_err(net, RTNLGRP_IPV6_ROUTE, err);
 }
