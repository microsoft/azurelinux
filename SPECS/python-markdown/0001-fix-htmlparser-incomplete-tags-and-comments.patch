From 45f4fdb85f9284d0dcc4b871dc77f88a31afb24a Mon Sep 17 00:00:00 2001
From: Durga Jagadeesh Palli <v-dpalli@microsoft.com>
Date: Fri, 8 May 2026 07:45:54 +0000
Subject: [PATCH] fix htmlparser incomplete tags and comments

Upstream patch reference: https://github.com/Python-Markdown/markdown/pull/1539
                          https://github.com/Python-Markdown/markdown/issues/1537

Backport upstream fix for Python-Markdown issue #1537 / PR #1539.
Adjust HTML parser handling for incomplete start tags and unclosed comments
to preserve historical Markdown behavior with newer CPython HTML parser changes.

---
 markdown/htmlparser.py | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/markdown/htmlparser.py b/markdown/htmlparser.py
index 4b96dd2..8c13b9d 100644
--- a/markdown/htmlparser.py
+++ b/markdown/htmlparser.py
@@
     def parse_pi(self, i: int) -> int:
         if self.at_line_start() or self.intail:
             return super().parse_pi(i)
         # This is not the beginning of a raw block so treat as plain data
         # and avoid consuming any tags which may follow (see #1066).
         self.handle_data('<?')
         return i + 2
+
+    def parse_comment(self, i: int, report: int = 1) -> int:
+        rawdata = self.rawdata
+        assert rawdata.startswith('<!--', i), 'unexpected call to parse_comment()'
+        match = htmlparser.commentclose.search(rawdata, i + 4)
+        if not match:
+            self.handle_data('<')
+            return i + 1
+        if report:
+            j = match.start()
+            self.handle_comment(rawdata[i + 4:j])
+        return match.end()
 
     def parse_html_declaration(self, i: int) -> int:
         if self.at_line_start() or self.intail:
             return super().parse_html_declaration(i)
         # This is not the beginning of a raw block so treat as plain data
@@
     def parse_starttag(self, i: int) -> int:  # pragma: no cover
         self.__starttag_text = None
         endpos = self.check_for_whole_start_tag(i)
         if endpos < 0:
-            return endpos
+            self.handle_data(self.rawdata[i:i + 1])
+            return i + 1
         rawdata = self.rawdata
         self.__starttag_text = rawdata[i:endpos]
 
         # Now parse the data between `i+1` and `j` into a tag and `attrs`
-- 
