+++ b/runtime/net.c
@@ -1687,6 +1687,11 @@ CODESTARTobjQueryInterface(net)
 	pIf->CmpHost = CmpHost;
 	pIf->HasRestrictions = HasRestrictions;
 	pIf->GetIFIPAddr = getIFIPAddr;
+
+	pIf->netns_save = netns_save;
+	pIf->netns_restore = netns_restore;
