 runtime/net.c                  |   5 +
 runtime/net.h                  |  60 +++++++++++-
 runtime/netns_socket.c         | 166 +++++++++++++++++++++++++++++++++
 runtime/netns_socket.h         |  40 ++++++++
 tests/known_issues.supp        |  18 ++++
 tests/tcp_forwarding_ns_tpl.sh |   2 +-
 tools/omfwd.c                  |  50 +---------
 8 files changed, 293 insertions(+), 50 deletions(-)
 create mode 100644 runtime/netns_socket.c
 create mode 100644 runtime/netns_socket.h

