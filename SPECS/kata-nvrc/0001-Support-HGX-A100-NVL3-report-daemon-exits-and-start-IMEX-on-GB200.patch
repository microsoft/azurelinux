-        kmsg::wait_for_marker_after("FM starting NvLink Inband", 120, || {
-            self.spawn_fabricmanager(&gpu_extension::path("/bin/nv-fabricmanager"))
+        self.spawn_until_marker("FM starting NvLink Inband", 120, |nvrc| {
