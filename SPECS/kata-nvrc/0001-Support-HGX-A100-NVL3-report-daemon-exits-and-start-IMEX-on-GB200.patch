+        }));
+
+        assert!(result.is_err());
+        assert!(start.elapsed() < Duration::from_secs(10));
+    }
 }

From 79a0a3290ed63cebabfe765624f77ec250c9c86d Mon Sep 17 00:00:00 2001
From: Jocelyn Berrendonner <jocelynb@microsoft.com>
