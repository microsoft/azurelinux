+
+fn imex_fabric_from(pci_path: &str) -> bool {
+    let Ok(entries) = fs::read_dir(pci_path) else {
+        return false;
+    };
+    entries.flatten().any(|e| {
+        let read = |f: &str| fs::read_to_string(e.path().join(f)).unwrap_or_default();
