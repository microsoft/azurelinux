+        use std::time::{Duration, Instant};
+
+        let log = tempfile::NamedTempFile::new().unwrap();
+        let mut reader = kmsg::open_kmsg(log.path().to_str().unwrap());
+        let mut nvrc = NVRC::default();
+        nvrc.spawn_daemon("false", "/bin/false", &[]);
+
