From 292287621aa046a7272badd7b0483e73ee1c6729 Mon Sep 17 00:00:00 2001
From: Sushil Sati <v-sushilsati@microsoft.com>
Date: Fri, 23 Oct 2026 11:13:34 +0000
Subject: [PATCH] Fix Forward authentication configuration and AWS credential tests

Complete the configuration mapping required by the CVE-2025-12969
backport by mapping shared_key into the plugin context and registering
empty_shared_key. These mappings match upstream and preserve the
rejection of users-only configurations.

Backport the upstream STS test fix from commit
f879a93bc7642399653e841eedfa664eae1b6376.

Adapt the same TTL-based response-building and ownership pattern for
the HTTP credential test. This HTTP change is a local adaptation,
not a direct upstream backport.

Signed-off-by: Sushil Sati <v-sushilsati@microsoft.com>
Upstream-reference: https://github.com/fluent/fluent-bit/blob/964ebca260a223e9c644155c4ce647e7810242cb/plugins/in_forward/fw.c#L456-L494
Upstream-reference: https://github.com/fluent/fluent-bit/commit/f879a93bc7642399653e841eedfa664eae1b6376.patch

---
 plugins/in_forward/fw.c               |   7 +-
 tests/internal/aws_credentials_http.c |  61 ++++++--
 tests/internal/aws_credentials_sts.c  | 201 +++++++++++++++++++-------
 3 files changed, 205 insertions(+), 64 deletions(-)

diff --git a/plugins/in_forward/fw.c b/plugins/in_forward/fw.c
index 9b55409..9dad174 100644
--- a/plugins/in_forward/fw.c
+++ b/plugins/in_forward/fw.c
@@ -425,8 +425,8 @@ static struct flb_config_map config_map[] = {
    },
    {
     FLB_CONFIG_MAP_STR, "shared_key", NULL,
-    0, FLB_FALSE, 0,
+    0, FLB_TRUE, offsetof(struct flb_in_fw_config, shared_key),
     "Shared key for authentication"
    },
    {
     FLB_CONFIG_MAP_STR, "self_hostname", NULL,
@@ -458,6 +458,11 @@ static struct flb_config_map config_map[] = {
     0, FLB_TRUE, offsetof(struct flb_in_fw_config, buffer_max_size),
     "The maximum buffer memory size used to receive a Forward message."
    },
+   {
+    FLB_CONFIG_MAP_BOOL, "empty_shared_key", "false",
+    0, FLB_TRUE, offsetof(struct flb_in_fw_config, empty_shared_key),
+    "Set an empty shared key for authentication"
+   },
    {0}
 };
 
diff --git a/tests/internal/aws_credentials_http.c b/tests/internal/aws_credentials_http.c
index 55912da..ca7bafc 100644
--- a/tests/internal/aws_credentials_http.c
+++ b/tests/internal/aws_credentials_http.c
@@ -16,13 +16,39 @@
 #define SECRET_KEY_HTTP "http_skid"
 #define TOKEN_HTTP      "http_token"
 
-#define HTTP_CREDENTIALS_RESPONSE "{\n\
-    \"AccessKeyId\": \"http_akid\",\n\
-    \"Expiration\": \"2025-10-24T23:00:23Z\",\n\
-    \"RoleArn\": \"TASK_ROLE_ARN\",\n\
-    \"SecretAccessKey\": \"http_skid\",\n\
-    \"Token\": \"http_token\"\n\
-}"
+static char *build_http_response_with_ttl_calloc(time_t ttl_secs, size_t *out_len)
+{
+    time_t exp = time(NULL) + ttl_secs;
+    struct tm gm;
+    char expbuf[32];
+    const char *tmpl;
+    size_t need;
+    char *buf;
+
+    TEST_ASSERT(gmtime_r(&exp, &gm) != NULL);
+    TEST_ASSERT(strftime(expbuf, sizeof(expbuf), "%Y-%m-%dT%H:%M:%SZ", &gm) > 0);
+
+    tmpl =
+        "{\n"
+        "    \"AccessKeyId\": \"http_akid\",\n"
+        "    \"Expiration\": \"%s\",\n"
+        "    \"RoleArn\": \"TASK_ROLE_ARN\",\n"
+        "    \"SecretAccessKey\": \"http_skid\",\n"
+        "    \"Token\": \"http_token\"\n"
+        "}";
+
+    need = (size_t)snprintf(NULL, 0, tmpl, expbuf) + 1;
+    buf = flb_calloc(1, need);
+    if (!buf) {
+        flb_errno();
+        return NULL;
+    }
+    snprintf(buf, need, tmpl, expbuf);
+    if (out_len) {
+        *out_len = need - 1;
+    }
+    return buf;
+}
 
 /*
  * Unexpected/invalid HTTP response. The goal of this is not to test anything
@@ -48,6 +74,8 @@ struct flb_http_client *request_happy_case(struct flb_aws_client *aws_client,
                                            int method, const char *uri)
 {
     struct flb_http_client *c = NULL;
+    char *payload;
+    size_t payload_len = 0;
 
     TEST_CHECK(method == FLB_HTTP_GET);
 
@@ -61,9 +89,24 @@ struct flb_http_client *request_happy_case(struct flb_aws_client *aws_client,
     }
     mk_list_init(&c->headers);
 
+    payload = build_http_response_with_ttl_calloc(3600, &payload_len);
+    TEST_CHECK(payload != NULL);
+    if (!payload) {
+        flb_http_client_destroy(c);
+        return NULL;
+    }
+
     c->resp.status = 200;
-    c->resp.payload = HTTP_CREDENTIALS_RESPONSE;
-    c->resp.payload_size = strlen(HTTP_CREDENTIALS_RESPONSE);
+    c->resp.data = payload;
+    c->resp.data_len = payload_len;
+    c->resp.data_size = payload_len + 1;
+    c->resp.data_size_max = c->resp.data_size;
+    c->resp.headers_end = c->resp.data;
+    c->resp.payload = payload;
+    c->resp.payload_size = payload_len;
+    c->resp.content_length = -1;
+    c->resp.chunked_encoding = FLB_FALSE;
+    c->resp.connection_close = -1;
 
     return c;
 }
