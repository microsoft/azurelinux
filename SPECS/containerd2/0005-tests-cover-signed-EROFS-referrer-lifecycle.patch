+// TestApplyDmverityPolicy tests the dm-verity policy application logic
+
+func signedMaterializationLabels(rootHash string, signature []byte) map[string]string {
+	return map[string]string{
+		snpkg.DmverityMaterializationVersionLabel:         snpkg.DmverityMaterializationVersion,
+		snpkg.DmverityMaterializationStateLabel:           snpkg.DmverityMaterializationStateSigned,
+		snpkg.DmverityMaterializationRootHashLabel:        rootHash,
+		snpkg.DmverityMaterializationSignatureDigestLabel: digest.FromBytes(signature).String(),
+	}
+}
+
+func createSignedDmverityMetadata(t *testing.T, layerBlob string, signature []byte) {
+	t.Helper()
+	createDmverityMetadata(t, layerBlob)
+	require.NoError(t, os.WriteFile(dmverity.SignaturePath(layerBlob), signature, 0644))
+	require.NoError(t, os.WriteFile(dmverity.SignatureRequiredPath(layerBlob), []byte("1\n"), 0644))
+	t.Cleanup(func() {
+		os.Remove(dmverity.SignaturePath(layerBlob))
+		os.Remove(dmverity.SignatureRequiredPath(layerBlob))
+	})
+}
+
+func TestApplyDmverityReferrerPolicy(t *testing.T) {
+	const rootHash = "fedcba098765432109876543210987654321098765432109876543210987"
+
+	t.Run("signed labels require the distinct config switch", func(t *testing.T) {
+		layer := createTestLayerBlob(t, t.TempDir())
+		labels := signedMaterializationLabels(rootHash, []byte("signature"))
+		s := &snapshotter{dmverityMode: "auto"}
+		_, err := s.applyDmverityPolicy(layer, labels)
+		require.ErrorContains(t, err, "enable_dmverity_referrers is false")
+	})
+
+	t.Run("recorded signed materialization requires sidecars", func(t *testing.T) {
+		layer := createTestLayerBlob(t, t.TempDir())
+		labels := signedMaterializationLabels(rootHash, []byte("signature"))
+		s := &snapshotter{dmverityMode: "auto", enableDmverityReferrers: true}
+		_, err := s.applyDmverityPolicy(layer, labels)
+		require.ErrorContains(t, err, "unusable signed dm-verity metadata")
+	})
+
+	t.Run("recorded signed materialization requires complete signature state", func(t *testing.T) {
+		layer := createTestLayerBlob(t, t.TempDir())
+		createDmverityMetadata(t, layer)
+		labels := signedMaterializationLabels(rootHash, []byte("signature"))
+		s := &snapshotter{dmverityMode: "auto", enableDmverityReferrers: true}
+		_, err := s.applyDmverityPolicy(layer, labels)
+		require.ErrorContains(t, err, "signature state is incomplete")
+	})
+
+	t.Run("recorded signed materialization binds root hash", func(t *testing.T) {
+		layer := createTestLayerBlob(t, t.TempDir())
+		createSignedDmverityMetadata(t, layer, []byte("signature"))
+		labels := signedMaterializationLabels("different-root", []byte("signature"))
+		s := &snapshotter{dmverityMode: "auto", enableDmverityReferrers: true}
+		_, err := s.applyDmverityPolicy(layer, labels)
+		require.ErrorContains(t, err, "does not match recorded root hash")
+	})
+
+	t.Run("recorded signed materialization binds signature", func(t *testing.T) {
+		layer := createTestLayerBlob(t, t.TempDir())
+		createSignedDmverityMetadata(t, layer, []byte("signature"))
+		labels := signedMaterializationLabels(rootHash, []byte("different signature"))
+		s := &snapshotter{dmverityMode: "auto", enableDmverityReferrers: true}
+		_, err := s.applyDmverityPolicy(layer, labels)
+		require.ErrorContains(t, err, "does not match recorded digest")
+	})
+
+	t.Run("recorded signed materialization accepts matching sidecars", func(t *testing.T) {
+		layer := createTestLayerBlob(t, t.TempDir())
+		signature := []byte("signature")
+		createSignedDmverityMetadata(t, layer, signature)
+		labels := signedMaterializationLabels(rootHash, signature)
+		s := &snapshotter{dmverityMode: "auto", enableDmverityReferrers: true}
+		opt, err := s.applyDmverityPolicy(layer, labels)
+		require.NoError(t, err)
+		assert.Equal(t, dmverity.MountOptionModePrefix+dmverity.MetadataPath(layer), opt)
+
+		m, err := s.createErofsMount(layer, labels)
+		require.NoError(t, err)
+		assert.Contains(t, m.Options, dmverity.MountOptionModePrefix+dmverity.MetadataPath(layer))
+		assert.Contains(t, m.Options, dmverity.MountOptionRootHashPrefix+rootHash)
+		assert.Contains(t, m.Options, dmverity.MountOptionSignatureDigestPrefix+labels[snpkg.DmverityMaterializationSignatureDigestLabel])
+	})
+
+	t.Run("require signatures rejects plain layers", func(t *testing.T) {
+		layer := createTestLayerBlob(t, t.TempDir())
+		s := &snapshotter{dmverityMode: "auto", enableDmverityReferrers: true, requireSignatures: true}
+		_, err := s.applyDmverityPolicy(layer, nil)
+		require.ErrorContains(t, err, "signature required")
+	})
+
+	t.Run("partial materialization labels fail closed", func(t *testing.T) {
+		labels := map[string]string{
+			snpkg.DmverityMaterializationVersionLabel: snpkg.DmverityMaterializationVersion,
+			snpkg.DmverityMaterializationStateLabel:   snpkg.DmverityMaterializationStateSigned,
+		}
+		s := &snapshotter{dmverityMode: "auto", enableDmverityReferrers: true}
+		_, err := s.applyDmverityPolicy("layer.erofs", labels)
+		require.ErrorContains(t, err, "missing its dm-verity root hash label")
+	})
+}
