+func TestFetchReferrersStreamedOversizeIsFatal(t *testing.T) {
+	const name = "streamed-oversize"
+	fetcher, subject := newReferrersFetcher(t, name, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", ocispec.MediaTypeImageIndex)
+		w.WriteHeader(http.StatusOK)
+		if flusher, ok := w.(http.Flusher); ok {
+			flusher.Flush()
+		}
+		_, _ = io.WriteString(w, `{"schemaVersion":2,"manifests":[],"padding":"`)
+		_, _ = io.WriteString(w, strings.Repeat("x", int(MaxManifestSize)+1))
+		_, _ = io.WriteString(w, `"}`)
+	}))
+
+	_, err := fetcher.FetchReferrers(t.Context(), subject)
+	if err == nil {
+		t.Fatal("streamed oversized referrers index unexpectedly succeeded")
+	}
+	if errdefs.IsNotFound(err) {
