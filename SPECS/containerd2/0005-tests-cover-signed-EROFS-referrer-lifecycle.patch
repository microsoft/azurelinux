+func newDirectReferrersFetcher(hosts ...RegistryHost) dockerFetcher {
+	return dockerFetcher{dockerBase: &dockerBase{
+		refspec:    reference.Spec{Locator: "source.example/repository"},
+		repository: "repository",
+		hosts:      hosts,
+		header:     make(http.Header),
+	}}
+}
