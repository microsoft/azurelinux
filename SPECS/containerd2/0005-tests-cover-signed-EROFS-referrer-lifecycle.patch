+func TestRemoveUsesPersistedSnapshotIDForCleanup(t *testing.T) {
+	ctx := t.Context()
+	sn, err := NewSnapshotter(t.TempDir())
+	require.NoError(t, err)
+	s := sn.(*snapshotter)
+	t.Cleanup(func() { require.NoError(t, s.Close()) })
+
+	var id string
+	err = s.ms.WithTransaction(ctx, true, func(ctx context.Context) error {
+		snap, err := storage.CreateSnapshot(ctx, snapshots.KindActive, "active", "")
+		if err != nil {
+			return err
+		}
+		id = snap.ID
+		_, err = storage.CommitActive(ctx, "active", "committed", snapshots.Usage{})
+		return err
+	})
+	require.NoError(t, err)
+
+	require.NoError(t, os.MkdirAll(filepath.Dir(s.layerBlobPath(id)), 0755))
+	require.NoError(t, os.WriteFile(s.layerBlobPath(id), []byte("layer"), 0644))
+	require.NoError(t, os.MkdirAll(s.upperPath(id), 0755))
+
+	var releasedLayer, releasedDevice, cleanedUpper string
+	s.releaseDmverityDeviceFn = func(_ context.Context, layerPath string) {
+		releasedLayer = layerPath
+		releasedDevice = dmverity.ErofsDeviceName(layerPath)
+	}
+	s.cleanupUpperFn = func(path string) error {
+		cleanedUpper = path
+		return nil
+	}
+
+	require.NoError(t, s.Remove(ctx, "committed"))
+	assert.Equal(t, s.layerBlobPath(id), releasedLayer)
+	assert.Equal(t, dmverity.ErofsDeviceName(s.layerBlobPath(id)), releasedDevice)
+	assert.Equal(t, s.upperPath(id), cleanedUpper)
+	assert.NotEqual(t, s.layerBlobPath(""), releasedLayer)
+	assert.NotEqual(t, s.upperPath(""), cleanedUpper)
+}
