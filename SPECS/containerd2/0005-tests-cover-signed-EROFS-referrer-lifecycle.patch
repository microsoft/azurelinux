+func TestDmverityReferrersEnabled(t *testing.T) {
+	probeError := errors.New("probe failed")
+	tests := []struct {
+		name      string
+		required  bool
+		probeErr  error
+		want      bool
+		wantError bool
+	}{
+		{name: "optional supported", want: true},
+		{name: "optional probe failure", probeErr: probeError},
+		{name: "required supported", required: true, want: true},
+		{name: "required probe failure", required: true, probeErr: probeError, wantError: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := dmverityReferrersEnabled(test.required, test.probeErr)
+			if got != test.want {
+				t.Fatalf("dmverityReferrersEnabled() = %v, want %v", got, test.want)
+			}
+			if (err != nil) != test.wantError {
+				t.Fatalf("dmverityReferrersEnabled() error = %v, wantError %v", err, test.wantError)
+			}
+		})
+	}
+}
