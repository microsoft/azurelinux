+func newReferrersTestHost(t *testing.T, capabilities HostCapabilities, handler http.HandlerFunc) (RegistryHost, func()) {
+	t.Helper()
+	server := httptest.NewServer(handler)
+	u, err := url.Parse(server.URL)
+	if err != nil {
+		server.Close()
+		t.Fatal(err)
+	}
+	return RegistryHost{
+		Client:       server.Client(),
+		Host:         u.Host,
+		Scheme:       u.Scheme,
+		Path:         "/v2",
+		Capabilities: capabilities,
+	}, server.Close
+}
