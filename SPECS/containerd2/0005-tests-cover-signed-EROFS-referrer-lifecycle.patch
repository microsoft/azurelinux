+func newPersistedFsmergeChain(t *testing.T, bottomLabels map[string]string) (*snapshotter, storage.Snapshot, snapshots.Info, string, string) {
+	t.Helper()
+	sn, err := NewSnapshotter(t.TempDir())
+	require.NoError(t, err)
+	s := sn.(*snapshotter)
+	t.Cleanup(func() { require.NoError(t, s.Close()) })
+
+	var (
+		snap            storage.Snapshot
+		info            snapshots.Info
+		topID, bottomID string
+	)
+	err = s.ms.WithTransaction(t.Context(), true, func(ctx context.Context) error {
+		bottom, err := storage.CreateSnapshot(ctx, snapshots.KindActive, "bottom-active", "")
+		if err != nil {
+			return err
+		}
+		bottomID = bottom.ID
+		if _, err := storage.CommitActive(ctx, "bottom-active", "bottom", snapshots.Usage{},
+			snapshots.WithLabels(bottomLabels)); err != nil {
+			return err
+		}
+
+		top, err := storage.CreateSnapshot(ctx, snapshots.KindActive, "top-active", "bottom")
+		if err != nil {
+			return err
+		}
+		topID = top.ID
+		if _, err := storage.CommitActive(ctx, "top-active", "top", snapshots.Usage{}); err != nil {
+			return err
+		}
+
+		snap, err = storage.CreateSnapshot(ctx, snapshots.KindView, "view", "top")
+		if err != nil {
+			return err
+		}
+		_, info, _, err = storage.GetInfo(ctx, "view")
+		return err
+	})
+	require.NoError(t, err)
+
+	for _, id := range []string{topID, bottomID} {
+		require.NoError(t, os.MkdirAll(filepath.Dir(s.layerBlobPath(id)), 0755))
+		require.NoError(t, os.WriteFile(s.layerBlobPath(id), []byte("layer"), 0644))
+	}
+	require.NoError(t, os.WriteFile(s.fsMetaPath(topID), []byte("merged"), 0644))
+	return s, snap, info, topID, bottomID
+}
