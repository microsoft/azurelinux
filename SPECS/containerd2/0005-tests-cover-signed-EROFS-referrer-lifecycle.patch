+func TestFetchReferrersFallbackErrorPrecedence(t *testing.T) {
+	subject := digest.FromString("subject")
+
+	t.Run("native failure is not masked by fallback absence", func(t *testing.T) {
+		host, closeHost := newReferrersTestHost(t, HostCapabilityResolve|HostCapabilityReferrers, func(w http.ResponseWriter, r *http.Request) {
+			switch {
+			case strings.Contains(r.URL.Path, "/referrers/"):
+				http.Error(w, "native unavailable", http.StatusInternalServerError)
+			case strings.Contains(r.URL.Path, "/manifests/"):
+				http.NotFound(w, r)
+			default:
+				http.NotFound(w, r)
+			}
+		})
+		defer closeHost()
+
+		fetcher := newDirectReferrersFetcher(host)
+		_, err := fetcher.FetchReferrers(t.Context(), subject)
+		if err == nil || errdefs.IsNotFound(err) || !strings.Contains(err.Error(), "500") {
+			t.Fatalf("FetchReferrers() error = %v, want preserved native 500", err)
+		}
+	})
+
+	t.Run("fallback continues to later hosts", func(t *testing.T) {
+		var firstRequests, secondRequests atomic.Int32
+		first, closeFirst := newReferrersTestHost(t, HostCapabilityResolve, func(w http.ResponseWriter, r *http.Request) {
+			firstRequests.Add(1)
+			http.NotFound(w, r)
+		})
+		defer closeFirst()
+		second, closeSecond := newReferrersTestHost(t, HostCapabilityResolve, func(w http.ResponseWriter, r *http.Request) {
+			secondRequests.Add(1)
+			w.Header().Set("Content-Type", ocispec.MediaTypeImageIndex)
+			_, _ = w.Write(newIndex().OCIManifest())
+		})
+		defer closeSecond()
+
+		refs, err := newDirectReferrersFetcher(first, second).FetchReferrers(t.Context(), subject)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(refs) != 0 {
+			t.Fatalf("FetchReferrers() returned %d descriptors, want 0", len(refs))
+		}
+		if firstRequests.Load() == 0 || secondRequests.Load() == 0 {
+			t.Fatalf("fallback requests = (%d, %d), want both hosts attempted", firstRequests.Load(), secondRequests.Load())
+		}
+	})
+
+	t.Run("all fallback hosts absent is empty", func(t *testing.T) {
+		var requests atomic.Int32
+		first, closeFirst := newReferrersTestHost(t, HostCapabilityResolve, func(w http.ResponseWriter, r *http.Request) {
+			requests.Add(1)
+			http.NotFound(w, r)
+		})
+		defer closeFirst()
+		second, closeSecond := newReferrersTestHost(t, HostCapabilityResolve, func(w http.ResponseWriter, r *http.Request) {
+			requests.Add(1)
+			http.NotFound(w, r)
+		})
+		defer closeSecond()
+
+		refs, err := newDirectReferrersFetcher(first, second).FetchReferrers(t.Context(), subject)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(refs) != 0 {
+			t.Fatalf("FetchReferrers() returned %d descriptors, want 0", len(refs))
+		}
+		if requests.Load() != 2 {
+			t.Fatalf("fallback requests = %d, want 2", requests.Load())
+		}
+	})
+}
