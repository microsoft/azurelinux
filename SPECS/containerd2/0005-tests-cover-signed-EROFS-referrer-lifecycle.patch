+func TestApplyFilesystemOptionsUnquotesLSMValues(t *testing.T) {
+	const label = "system_u:object_r:container_file_t:s0:c1,c2"
+	for _, key := range []string{"context", "fscontext", "defcontext", "rootcontext"} {
+		t.Run(key, func(t *testing.T) {
+			var gotKey, gotValue string
+			_, err := applyFilesystemOptions(
+				[]string{fmt.Sprintf(`%s=%q`, key, label)},
+				func(key, value string) error {
+					gotKey, gotValue = key, value
+					return nil
+				},
+				func(string) error { return nil },
+			)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if gotKey != key || gotValue != label {
+				t.Fatalf("fsconfig string = %s=%q, want %s=%q", gotKey, gotValue, key, label)
+			}
+		})
+	}
+}
+
+func TestApplyFilesystemOptionsPreservesOtherStringValues(t *testing.T) {
+	const quoted = `"value,with,commas"`
+	var got string
+	_, err := applyFilesystemOptions(
+		[]string{"custom=" + quoted},
+		func(_, value string) error {
+			got = value
+			return nil
+		},
+		func(string) error { return nil },
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != quoted {
+		t.Fatalf("non-LSM fsconfig value = %q, want %q", got, quoted)
+	}
+}
+
+func TestApplyFilesystemOptionsRejectsMalformedQuotedLSMValue(t *testing.T) {
+	_, err := applyFilesystemOptions(
+		[]string{`context="unterminated`},
+		func(string, string) error { return nil },
+		func(string) error { return nil },
+	)
+	if err == nil {
+		t.Fatal("malformed quoted LSM option unexpectedly accepted")
+	}
+}
