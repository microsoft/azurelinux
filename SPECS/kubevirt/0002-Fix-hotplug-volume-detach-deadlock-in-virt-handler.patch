@@ -898,6 +925,29 @@ var _ = Describe("HotplugVolume", func() {
 			Expect(err).To(HaveOccurred(), "block device volume still exists %s", blockVolume)
 		})
 
+		It("should skip mounting hotplug volumes no longer in VMI spec", func() {
+			vmi := api.NewMinimalVMI("fake-vmi")
