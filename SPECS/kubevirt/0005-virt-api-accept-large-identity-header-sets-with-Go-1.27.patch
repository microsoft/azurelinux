+
+package virt_api
+
+import "net/http"
+
+func configureIdentityHeaderLimit(server *http.Server) {
+	// 1 MiB at 128 bytes per header value; allow thousands of X-Remote-Group values.
+	server.MaxHeaderValueCount = 8192
+}
diff --git a/pkg/virt-api/header_limit_go127_test.go b/pkg/virt-api/header_limit_go127_test.go
new file mode 100644
index 000000000000..92492b88911b
--- /dev/null
+++ b/pkg/virt-api/header_limit_go127_test.go
@@ -0,0 +1,57 @@
