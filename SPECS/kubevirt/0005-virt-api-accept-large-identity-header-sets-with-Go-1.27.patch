+++ b/pkg/virt-api/BUILD.bazel
@@ -2,7 +2,11 @@ load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
 
 go_library(
     name = "go_default_library",
-    srcs = ["api.go"],
+    srcs = [
+        "api.go",
+        "header_limit_go127.go",
+        "header_limit_pre_go127.go",
+    ],
     importpath = "kubevirt.io/kubevirt/pkg/virt-api",
     visibility = ["//visibility:public"],
     deps = [
@@ -54,6 +58,7 @@ go_test(
     name = "go_default_test",
     srcs = [
         "api_test.go",
+        "header_limit_go127_test.go",
         "virt-api_suite_test.go",
     ],
     embed = [":go_default_library"],
diff --git a/pkg/virt-api/api.go b/pkg/virt-api/api.go
index 9518f4b7af7a..7dbe78730259 100644
--- a/pkg/virt-api/api.go
+++ b/pkg/virt-api/api.go
@@ -1132,6 +1132,7 @@ func (app *virtAPIApp) startTLS(informerFactory controller.KubeInformerFactory)
 		// See CVE-2023-44487
 		TLSNextProto: map[string]func(*http.Server, *tls.Conn, http.Handler){},
 	}
+	configureIdentityHeaderLimit(server)
 
 	// start TLS server
 	go func() {
diff --git a/pkg/virt-api/header_limit_go127.go b/pkg/virt-api/header_limit_go127.go
new file mode 100644
index 000000000000..cae0f80260a1
--- /dev/null
+++ b/pkg/virt-api/header_limit_go127.go
@@ -0,0 +1,29 @@
+//go:build go1.27
+
