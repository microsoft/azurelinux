+	}
+
+	vmi, ok := obj.(*v1.VirtualMachineInstance)
+	if !ok {
+		log.Log.Errorf("failed to look up VMI %s for completed migration stats: unexpected object type %T", key, obj)
+		return nil, false
+	}
+
