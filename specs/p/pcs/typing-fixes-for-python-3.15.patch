-            value = value.value
-        new_dict[_field.metadata.get(META_NAME, _field.name)] = value
+            new_value = _convert_enum(value)
+        else:
+            new_value = value
+        new_dict[_field.metadata.get(META_NAME, _field.name)] = new_value
     return new_dict
 
 
