From c4d12c59acb4de1a8fd4be635e192e2dd0a7cb92 Mon Sep 17 00:00:00 2001
From: Elliott Sales de Andrade <quantum.analyst@gmail.com>
Date: Wed, 8 Sep 2021 04:47:08 -0400
Subject: [PATCH 1/2] Loosen up build requirements

And drop coverage dependencies.

Signed-off-by: Elliott Sales de Andrade <quantum.analyst@gmail.com>
---
 pyproject.toml | 3 +--
 setup.py       | 2 +-
 2 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 5820163c..c21566b7 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,7 +1,7 @@
 [build-system]
 requires = [
     "setuptools>=77.0.3",
-    "cython>=3.1,<=3.2",
+    "cython>=3.0.2",
     "numpy>=2,<3",
 ]
 build-backend = "setuptools.build_meta"
@@ -65,7 +65,6 @@ test = [
     "hypothesis",
     "matplotlib",
     "packaging",
-    "pytest-cov>=2.2.0",
     "pytest>=2.8.2",
     "requests",
     "shapely",
diff --git a/setup.py b/setup.py
index 06a3cf95..b444b54f 100755
--- a/setup.py
+++ b/setup.py
@@ -353,7 +353,7 @@ elif cpp11_flag not in eca:
 cpp_ext_options['extra_compile_args'] = eca
 
 # Configure optional Cython coverage.
-cythonize_options = {"language_level": sys.version_info[0], "compiler_directives": {"freethreading_compatible": True}}
+cythonize_options = {"language_level": sys.version_info[0]}
 if os.environ.get('CYTHON_COVERAGE'):
     cythonize_options['compiler_directives'].update(linetrace=True)
     cythonize_options['annotate'] = True
-- 
