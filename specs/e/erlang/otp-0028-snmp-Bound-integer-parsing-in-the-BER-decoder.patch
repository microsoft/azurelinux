-	    exit({bad_version, BadInt});
+    case (catch dec_int_tag(Bytes, ?VERSION_MAX_OCTETS)) of
 	{SNMPversion, Rest} when is_integer(SNMPversion) andalso is_list(Rest) ->
 	    {dec_snmp_ver(SNMPversion), Rest};
+        {'EXIT', {error, {bad_integer, BadInt}}} ->
+	    exit({bad_version, BadInt});
