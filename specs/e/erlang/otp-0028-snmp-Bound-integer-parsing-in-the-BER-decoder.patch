     %% Continue with Message
 %    {MsgSecurityParameters, Bytes2} = dec_oct_str_tag(Bytes1),
@@ -176,8 +192,8 @@ dec_pdu([164 | Bytes]) ->      % It's a trap
     Bytes2 = get_data_bytes(Bytes),
     {Enterprise, Rest1} = dec_oid_tag(Bytes2),
