     #trappdu{enterprise = Enterprise, agent_addr = AgentAddr,
@@ -186,9 +202,9 @@ dec_pdu([164 | Bytes]) ->      % It's a trap
 
 dec_pdu([165 | Bytes]) ->    % Bulk
     Bytes2 = get_data_bytes(Bytes),
