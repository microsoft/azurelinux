+dec_class(Fun) ->
+    try Fun() of
+        Result ->
+            {ok, Result}
+    catch
+        Class:Reason ->
+            {Class, Reason}
+    end.
+
+expect_exit(Field, Reason, Fun) ->
+    case dec_class(Fun) of
+        {exit, Reason} ->
+            ok;
+        Unexpected ->
+            exit({unexpected_decode_result, Field, Reason, Unexpected})
+    end.
