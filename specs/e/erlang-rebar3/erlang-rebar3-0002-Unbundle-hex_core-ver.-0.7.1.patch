-escape_char($n) -> $\n;       %\n = LF
-escape_char($r) -> $\r;       %\r = CR
-escape_char($t) -> $\t;       %\t = TAB
-escape_char($v) -> $\v;       %\v = VT
-escape_char($b) -> $\b;       %\b = BS
-escape_char($f) -> $\f;       %\f = FF
-escape_char($e) -> $\e;       %\e = ESC
-escape_char($s) -> $\s;       %\s = SPC
-escape_char($d) -> $\d;       %\d = DEL
-escape_char(C) -> C.
