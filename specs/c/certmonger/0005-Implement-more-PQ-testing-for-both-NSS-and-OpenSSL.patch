diff --git a/src/prefs-n.c b/src/prefs-n.c
index 584bdd7b..d080f0a1 100644
--- a/src/prefs-n.c
+++ b/src/prefs-n.c
@@ -19,7 +19,9 @@
 
 #include <nss.h>
 #include <nss.h>
+#include <keyhi.h>
 #include <keythi.h>
+#include <pk11pub.h>
 #include <secoidt.h>
 
 #include "prefs.h"
@@ -114,6 +116,45 @@ cm_prefs_nss_sig_alg(SECKEYPrivateKey *pkey)
 			return SEC_OID_ANSIX962_ECDSA_SHA256_SIGNATURE;
 			break;
 		}
+#ifdef CM_ENABLE_ML_DSA
+	case mldsaKey:
+		/* This is a simplified version of
+		 * cm_GetSignatureAlgorithmFromPrivateKey from keyiread-n.c.
+		 * Once the NSS function is exported that can be moved to
+		 * something like util-n.c and be generalized. For now I
+		 * duplicate.
+		 */
+		SECItem item;
+		CK_ULONG paramSet;
+		SECStatus rv;
+
+		rv = PK11_ReadRawAttribute(PK11_TypePrivKey, pkey, CKA_PARAMETER_SET, &item);
+		if (rv != SECSuccess) {
+			return SEC_OID_UNKNOWN;
+		}
+
+		if (item.len != sizeof(paramSet)) {
+			PORT_Free(item.data);	
+			PORT_SetError(SEC_ERROR_INVALID_KEY);
+			return SEC_OID_UNKNOWN;
+		}
+		paramSet = *(CK_ULONG *)item.data;
+		PORT_Free(item.data);
+		switch (paramSet) {
+		case CKP_ML_DSA_44:
+			return SEC_OID_ML_DSA_44_SIGNATURE;
+			break;
+		case CKP_ML_DSA_65:
+			return SEC_OID_ML_DSA_65_SIGNATURE;
+			break;
+		case CKP_ML_DSA_87:
+			return SEC_OID_ML_DSA_87_SIGNATURE;
+			break;
+		default:
+			return SEC_OID_UNKNOWN;
+			break;
+		}
+#endif
 	default:
 		return SEC_OID_UNKNOWN;
 		break;
diff --git a/src/prefs-o.c b/src/prefs-o.c
index 4b6ef6fd..39cabb7e 100644
--- a/src/prefs-o.c
+++ b/src/prefs-o.c
@@ -32,6 +32,39 @@
 #include "prefs.h"
 #include "prefs-o.h"
 #include "util-o.h"
+#include "log.h"
+#include "store-int.h"
+
+const EVP_MD *
+cm_prefs_ossl_sig_alg(enum cm_key_algorithm cm_key_algorithm)
+{
+	switch(cm_key_algorithm) {
+	case cm_key_rsa:
+#ifdef CM_ENABLE_DSA
+	case cm_key_dsa:
+#endif
+#ifdef CM_ENABLE_EC
+	case cm_key_ecdsa:
+#endif
+		return cm_prefs_ossl_hash();
+		break;
+#ifdef CM_ENABLE_ML_DSA
+	case cm_key_ml_dsa_44:
+		return EVP_get_digestbyname("ML-DSA-44");
+		break;
+	case cm_key_ml_dsa_65:
+		return EVP_get_digestbyname("ML-DSA-65");
+		break;
+	case cm_key_ml_dsa_87:
+		return EVP_get_digestbyname("ML-DSA-87");
+		break;
+#endif
+	default:
+		cm_log(1, "Unknown or unsupported key type.\n");
+		return NULL;
+		break;
+	}
+}
 
 const EVP_MD *
 cm_prefs_ossl_hash_by_pref(enum cm_prefs_digest digest)
