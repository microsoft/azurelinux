diff --git a/src/keyiread-n.c b/src/keyiread-n.c
index ed87b095..7f9cdf09 100644
--- a/src/keyiread-n.c
+++ b/src/keyiread-n.c
@@ -52,6 +52,60 @@
 #define PRIVKEY_LIST_EMPTY(l) PRIVKEY_LIST_END(PRIVKEY_LIST_HEAD(l), l)
 #endif
 
+
+/* FIXME: replace when NSS exposes the capability to get the alg */
+/* look up the an oid by string.
+ *
+ * The following code was ripped from NSS.
+ * */
+#include <cryptohi.h>
+
+/* If SECKEY_GetParameterSet() is exported then this can be replaced */
+const char *
+cm_GetSignatureAlgorithmFromPrivateKey(SECKEYPrivateKey *privKey)
+{
+    SECItem item;
+    CK_ULONG paramSet;
+    SECStatus rv;
+
+    /* don't modify hashAlg if we aren't a DSA key */
+    if (privKey->keyType != mldsaKey) {
+	/* should not get here */
+        return "Invalid ML-DSA key";
+    }
+
+    rv = PK11_ReadRawAttribute(PK11_TypePrivKey, privKey,
+                                CKA_PARAMETER_SET, &item);
+
+    if (rv != SECSuccess) {
+        return "UNKNOWN";
+    }
+    if (item.len != sizeof (paramSet)) {
+        PORT_Free(item.data);
+        PORT_SetError(SEC_ERROR_INVALID_KEY);
+        return "UNKNOWN";
+    }
+    paramSet = *(CK_ULONG *)item.data;
+    PORT_Free(item.data);
+    switch  (paramSet) {
+        case CKP_ML_DSA_44:
+            return "ML-DSA-44";
+            break;
+        case CKP_ML_DSA_65:
+            return "ML-DSA-65";
+            break;
+        case CKP_ML_DSA_87:
+            return "ML-DSA-87";
+            break;
+        default:
+            return "UNKNOWN";
+            break;
+    }
+    return "UNKNOWN";
+}
+
+/* end FIXME */
+
 struct cm_keyiread_state {
 	struct cm_keyiread_state_pvt pvt;
 	struct cm_store_entry *entry;
@@ -522,7 +576,10 @@ cm_keyiread_n_main(int fd, struct cm_store_ca *ca, struct cm_store_entry *entry,
 			cm_log(3, "Key is an EC key.\n");
 			alg = "EC";
 			break;
-		/* FIXME: case mlKey? */
+		case mldsaKey:
+			cm_log(3, "Key is an ML-DSA key.\n");
+			alg = cm_GetSignatureAlgorithmFromPrivateKey(keys->privkey);
+			break;
 		case nullKey:
 		default:
 			cm_log(3, "Key is of an unknown type.\n");
