 #ifdef CM_ENABLE_ML_DSA
 	case mldsaKey:
-		/* This is a simplified version of
-		 * cm_GetSignatureAlgorithmFromPrivateKey from keyiread-n.c.
-		 * Once the NSS function is exported that can be moved to
