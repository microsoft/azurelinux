 src/getcert.c    | 25 ++++++++++++++++-
 src/keygen-n.c   | 12 ++++++---
 src/keyiread-n.c | 58 +++------------------------------------
 src/prefs-n.c    | 70 +++++++++++++++++++++++++++---------------------
 src/prefs-n.h    |  2 ++
 6 files changed, 83 insertions(+), 95 deletions(-)

