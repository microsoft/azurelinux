-		 * duplicate.
-		 */
-		SECItem item;
-		CK_ULONG paramSet;
-		SECStatus rv;
+		const char *alg = cm_GetSignatureMLAlgorithmFromPrivateKey(pkey);
 
-		rv = PK11_ReadRawAttribute(PK11_TypePrivKey, pkey, CKA_PARAMETER_SET, &item);
-		if (rv != SECSuccess) {
-			return SEC_OID_UNKNOWN;
-		}
-
-		if (item.len != sizeof(paramSet)) {
-			PORT_Free(item.data);	
-			PORT_SetError(SEC_ERROR_INVALID_KEY);
-			return SEC_OID_UNKNOWN;
-		}
-		paramSet = *(CK_ULONG *)item.data;
-		PORT_Free(item.data);
-		switch (paramSet) {
-		case CKP_ML_DSA_44:
+		if (strcasecmp(alg, "ML-DSA-44") == 0) {
 			return SEC_OID_ML_DSA_44_SIGNATURE;
-			break;
-		case CKP_ML_DSA_65:
+		}
+		else if (strcasecmp(alg, "ML-DSA-65") == 0) {
 			return SEC_OID_ML_DSA_65_SIGNATURE;
-			break;
-		case CKP_ML_DSA_87:
+		}
+		else if (strcasecmp(alg, "ML-DSA-87") == 0) {
 			return SEC_OID_ML_DSA_87_SIGNATURE;
-			break;
-		default:
+		}
+		else {
 			return SEC_OID_UNKNOWN;
-			break;
 		}
 #endif
 	default:
@@ -211,3 +191,33 @@ cm_prefs_nss_dig_alg_len(void)
 		break;
 	}
 }
+
+const char *
+cm_GetSignatureMLAlgorithmFromPrivateKey(SECKEYPrivateKey *privKey)
+{
+	SECOidTag hashAlgTag = SEC_OID_UNKNOWN;
+	SECOidTag tag = SEC_GetSignatureAlgorithmOidTagByKey(privKey, NULL, hashAlgTag);
+
+	if (privKey->keyType != mldsaKey) {
+		return "Not a ML-DSA key";
+	}
+
+	if (tag == SEC_OID_UNKNOWN) {
+	   return "UNKNOWN";
+	}
+
+	switch (tag) {
+		case SEC_OID_ML_DSA_44_PUBLIC_KEY:
+			return "ML-DSA-44";
+			break;
+		case SEC_OID_ML_DSA_65_PUBLIC_KEY:
+			return "ML-DSA-65";
+			break;
+		case SEC_OID_ML_DSA_87_PUBLIC_KEY:
+			return "ML-DSA-87";
+			break;
+		default:
+			return "UNKNOWN";
+			break;
+	}
+}
