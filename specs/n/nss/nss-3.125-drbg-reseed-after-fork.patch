+     * inherited state is rebuilt.  prng_GenerateGlobalRandomBytes() makes the
+     * same check; without it the PR_Lock() below dereferences NULL. */
+    if (globalrng == NULL) {
+        PORT_SetError(SEC_ERROR_LIBRARY_FAILURE);
+        return SECFailure;
+    }
+
     PR_Lock(globalrng->lock);
