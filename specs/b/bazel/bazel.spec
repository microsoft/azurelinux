# This spec file has been modified by azldev to include build configuration overlays.
# Do not edit manually; changes may be overwritten.

%global debug_package %{nil}
# Bazel is an ELF launcher with an appended ZIP payload. Stripping it removes
# the payload and leaves an unusable launcher.
%define __brp_strip %{nil}

Name:           bazel
Version:        7.7.0
Release:        %autorelease
Summary:        Fast and scalable build system
License:        Apache-2.0
URL:            https://bazel.build/
Source0:        https://github.com/bazelbuild/bazel/releases/download/%{version}/%{name}-%{version}-dist.zip
Patch0:         0001-bootstrap-enable-annotation-processing-on-jdk25.patch

ExclusiveArch:  x86_64 aarch64

BuildRequires:  bash
BuildRequires:  gcc-c++
BuildRequires:  java-25-openjdk-devel
BuildRequires:  python3
BuildRequires:  unzip
BuildRequires:  zip
Requires:       java-25-openjdk-devel

%description
Bazel is a build system that supports large, multi-language projects with
incremental and reproducible builds.

%prep
%setup -q -c -T
unzip -q %{SOURCE0}
%patch -P 0 -p1

%build
export JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")"
export JAVA_VERSION=21
export EMBED_LABEL=%{version}
# The scratch bootstrap binary has no stamped version, which makes
# bazel_features assume unsupported development-version APIs.
# https://github.com/bazelbuild/bazel/issues/27401
export BAZEL_DEV_VERSION_OVERRIDE=%{version}
export VERBOSE=yes
export BAZEL_WRKDIR=%{_builddir}/%{name}-bootstrap
# JDK 23 and newer no longer run classpath annotation processors implicitly.
# Bazel's scratch bootstrap needs AutoValue and other bundled processors.
export BAZEL_JAVAC_OPTS="-proc:full"
# Do not fetch Bazel's default remote JDK 11 toolchain. Both the build tool
# runtime and target runtime must use Azure Linux's installed OpenJDK 25.
export EXTRA_BAZEL_ARGS="--java_runtime_version=local_jdk --tool_java_runtime_version=local_jdk"

bash ./compile.sh

%install
install -Dpm 0755 output/bazel %{buildroot}%{_bindir}/bazel

%check
export JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")"
bazel=%{buildroot}%{_bindir}/bazel
smoke_dir=%{_builddir}/%{name}-smoke

mkdir -p "${smoke_dir}"
cd "${smoke_dir}"
touch WORKSPACE

version_output="$("${bazel}" --batch version)"
printf '%%s\n' "${version_output}"
printf '%%s\n' "${version_output}" | grep -Fqx "Build label: %{version}"

cat > BUILD <<'EOF'
genrule(
    name = "hello",
    srcs = ["Hello.java"],
    outs = ["Hello.class"],
    cmd = "/usr/bin/javac -d $(@D) $(location Hello.java)",
)
EOF

cat > Hello.java <<'EOF'
public final class Hello {
    public static void main(String[] args) {
        System.out.println(System.getProperty("java.version"));
    }
}
EOF

"${bazel}" \
    --batch \
    --output_user_root="${smoke_dir}/output-user-root" \
    build \
    --noenable_bzlmod \
    --repository_disable_download \
    //:hello

/usr/bin/java -cp bazel-bin Hello | tee java-version.txt
grep -Eq '^25([.-]|$)' java-version.txt

%files
%license LICENSE
%doc AUTHORS CHANGELOG.md README.md
%{_bindir}/bazel

%changelog
