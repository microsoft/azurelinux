         """
         Delete the snapshot named ``name``
 
@@ -1080,36 +1080,37 @@ class Lvm2Cow(_Lvm2):
         lvs_dict = self.get_lvs_json_report(lvs_all=True)
         for lv_dict in lvs_dict[LVS_REPORT][0][LVS_LV]:
             if filter_cow_snapshot(lv_dict):
