From 09f8a64f7bfd3c012c255e54f23a9e175468d669 Mon Sep 17 00:00:00 2001
From: Tom Rix <Tom.Rix@amd.com>
Date: Fri, 19 Sep 2025 07:56:53 -0700
Subject: [PATCH] prepare hipify cmake for fedora

---
 CMakeLists.txt | 31 ++-----------------------------
 1 file changed, 2 insertions(+), 29 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 36a3b1ddf9cc..f2be64d9ffb1 100755
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -78,20 +78,6 @@ if (NOT HIPIFY_CLANG_TESTS_ONLY)
     Core
   )
   
-  if(LLVM_PACKAGE_VERSION VERSION_GREATER "6.0.1")
-    list(APPEND HIPIFY_ADDL_LINK_LIBS clangToolingInclusions)
-  endif()
-
-  if(LLVM_PACKAGE_VERSION VERSION_GREATER "9.0.1")
-    list(APPEND LLVM_LINK_COMPONENTS FrontendOpenMP)
-  endif()
-
-  if(LLVM_PACKAGE_VERSION VERSION_EQUAL "15.0.0" OR LLVM_PACKAGE_VERSION VERSION_GREATER "15.0.0")
-    list(APPEND LLVM_LINK_COMPONENTS WindowsDriver)
-    list(APPEND HIPIFY_ADDL_LINK_LIBS clangSupport)
-  endif()
-
-
   add_llvm_executable(hipify-clang
     ${HIPIFY_SOURCES} ${HIPIFY_HEADERS}
   )
@@ -129,21 +115,8 @@ if (NOT HIPIFY_CLANG_TESTS_ONLY)
 
   # Link against LLVM and CLANG libraries.
   target_link_libraries(hipify-clang PRIVATE
-    clangASTMatchers
-    clangFrontend
-    clangTooling
-    clangParse
-    clangSerialization
-    clangSema
-    clangEdit
-    clangFormat
-    clangLex
-    clangAnalysis
-    clangDriver
-    clangAST
-    clangToolingCore
-    clangRewrite
-    clangBasic
+    clang-cpp
+    LLVM
     ${HIPIFY_ADDL_LINK_LIBS}
   )
 
-- 
2.51.0

