+class RepoSnapshotFilterTest : public CppUnit::TestCase {
+    CPPUNIT_TEST_SUITE(RepoSnapshotFilterTest);
+    CPPUNIT_TEST(test_parse_snapshot_time_valid);
+    CPPUNIT_TEST(test_parse_snapshot_time_invalid);
+    CPPUNIT_TEST(test_parse_exclude_repos);
