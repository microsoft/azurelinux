+    void test_parse_snapshot_time_invalid();
+    void test_parse_exclude_repos();
+    void test_should_exclude_before_after_cutoff();
+    void test_should_exclude_excluded_repo();
+    void test_should_exclude_installed();
+    void test_should_exclude_missing_file_time();
+};
