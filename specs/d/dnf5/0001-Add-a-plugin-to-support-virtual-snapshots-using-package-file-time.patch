+void RpmPackageTest::test_get_file_time() {
+    // The repo metadata declares `<time file="123" build="456"/>`, so file time
+    // (publish time) must be reported as 123 and be distinct from build time.
+    // This is the end-to-end guard the repo_snapshot plugin relies on: a build
+    // where file time is not wired up would report 0 here and fail.
+    CPPUNIT_ASSERT_EQUAL(123LLU, get_pkg("pkg-1.2-3.x86_64").get_file_time());
+}
