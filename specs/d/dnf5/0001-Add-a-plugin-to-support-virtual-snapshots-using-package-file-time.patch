+// Copyright Contributors to the DNF5 project
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "test_repo_snapshot_filter.hpp"
+
+// The pure filtering helpers live alongside the plugin sources.
+#include "../../../../libdnf5-plugins/repo_snapshot/repo_snapshot_filter.hpp"
+
+#include <ctime>
+#include <set>
+#include <string>
+
+
+CPPUNIT_TEST_SUITE_REGISTRATION(RepoSnapshotFilterTest);
+
+
+void RepoSnapshotFilterTest::test_parse_snapshot_time_valid() {
+    time_t out = 0;
+    CPPUNIT_ASSERT(repo_snapshot::parse_snapshot_time("1700000000", out));
+    CPPUNIT_ASSERT_EQUAL(static_cast<time_t>(1700000000), out);
+
+    // Leading/trailing space is tolerated by strtoll's leading-space handling;
+    // a bare number with no trailing garbage must parse.
+    out = 0;
+    CPPUNIT_ASSERT(repo_snapshot::parse_snapshot_time("1", out));
+    CPPUNIT_ASSERT_EQUAL(static_cast<time_t>(1), out);
+}
+
+
+void RepoSnapshotFilterTest::test_parse_snapshot_time_invalid() {
+    // On failure `out` must be left untouched.
+    time_t out = 42;
+
+    CPPUNIT_ASSERT(!repo_snapshot::parse_snapshot_time("", out));
+    CPPUNIT_ASSERT(!repo_snapshot::parse_snapshot_time("abc", out));
+    CPPUNIT_ASSERT(!repo_snapshot::parse_snapshot_time("123abc", out));  // trailing garbage
+    CPPUNIT_ASSERT(!repo_snapshot::parse_snapshot_time("-5", out));      // negative
+    CPPUNIT_ASSERT(!repo_snapshot::parse_snapshot_time("0", out));       // non-positive
+
+    CPPUNIT_ASSERT_EQUAL(static_cast<time_t>(42), out);
+}
+
+
+void RepoSnapshotFilterTest::test_parse_exclude_repos() {
+    auto repos = repo_snapshot::parse_exclude_repos("repoA, repoB ,repoC");
+    CPPUNIT_ASSERT_EQUAL(static_cast<size_t>(3), repos.size());
+    CPPUNIT_ASSERT(repos.count("repoA") != 0);
+    CPPUNIT_ASSERT(repos.count("repoB") != 0);
+    CPPUNIT_ASSERT(repos.count("repoC") != 0);
+
+    // Empty input yields an empty set.
+    CPPUNIT_ASSERT(repo_snapshot::parse_exclude_repos("").empty());
+
+    // Empty/whitespace-only tokens are dropped.
+    CPPUNIT_ASSERT(repo_snapshot::parse_exclude_repos(" , , ").empty());
+}
+
+
+void RepoSnapshotFilterTest::test_should_exclude_before_after_cutoff() {
+    const std::set<std::string> no_excludes;
+    const time_t cutoff = 1000;
+
+    // Published before the cutoff -> kept.
+    CPPUNIT_ASSERT(!repo_snapshot::should_exclude_package(500, cutoff, false, "repo", no_excludes));
+
+    // Published exactly at the cutoff -> kept (filter is strictly after).
+    CPPUNIT_ASSERT(!repo_snapshot::should_exclude_package(1000, cutoff, false, "repo", no_excludes));
+
+    // Published after the cutoff -> excluded.
+    CPPUNIT_ASSERT(repo_snapshot::should_exclude_package(1500, cutoff, false, "repo", no_excludes));
+}
+
+
+void RepoSnapshotFilterTest::test_should_exclude_excluded_repo() {
+    const std::set<std::string> excludes{"protected"};
+
+    // Published after the cutoff, but the repo is excluded -> kept.
+    CPPUNIT_ASSERT(!repo_snapshot::should_exclude_package(1500, 1000, false, "protected", excludes));
+
+    // Published after the cutoff in a non-excluded repo -> excluded.
+    CPPUNIT_ASSERT(repo_snapshot::should_exclude_package(1500, 1000, false, "other", excludes));
+}
+
+
+void RepoSnapshotFilterTest::test_should_exclude_installed() {
+    const std::set<std::string> no_excludes;
+
+    // Installed packages are always kept, even if published after the cutoff.
+    CPPUNIT_ASSERT(!repo_snapshot::should_exclude_package(1500, 1000, true, "repo", no_excludes));
+}
+
+
+void RepoSnapshotFilterTest::test_should_exclude_missing_file_time() {
+    const std::set<std::string> no_excludes;
+    const time_t cutoff = 1000;
+
+    // Missing publish time is excluded because publication before the cutoff
+    // cannot be proven.
+    CPPUNIT_ASSERT(repo_snapshot::should_exclude_package(0, cutoff, false, "repo", no_excludes));
+}
