index 0000000..11ae1db
--- /dev/null
+++ b/libdnf5-plugins/repo_snapshot/CMakeLists.txt
@@ -0,0 +1,17 @@
+# Build only when this plugin is enabled AND dnf5 command plugins are built:
+# the spec packages this hook plus its config alongside the command plugin
+# under %if %{with dnf5_plugins}. Gating on both avoids installed-but-unpackaged
+# files in a --without dnf5_plugins build.
+if(NOT WITH_PLUGIN_REPO_SNAPSHOT OR NOT WITH_DNF5_PLUGINS)
+    return()
+endif()
+
+add_library(repo_snapshot MODULE repo_snapshot.cpp)
+
+# disable the 'lib' prefix in order to create repo_snapshot.so
+set_target_properties(repo_snapshot PROPERTIES PREFIX "")
+
+target_link_libraries(repo_snapshot PRIVATE libdnf5)
+
+install(TARGETS repo_snapshot LIBRARY DESTINATION "${CMAKE_INSTALL_FULL_LIBDIR}/libdnf5/plugins/")
+install(FILES "repo_snapshot.conf" DESTINATION "${CMAKE_INSTALL_FULL_SYSCONFDIR}/dnf/libdnf5-plugins")
