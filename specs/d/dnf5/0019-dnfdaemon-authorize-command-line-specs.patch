From 5d47d28443fcc2a1d3bec61aede02a16b8a595a7 Mon Sep 17 00:00:00 2001
From: Marek Blaha <mblaha@redhat.com>
Date: Thu, 5 Nov 2026 16:41:23 +0000
Subject: [PATCH 1/3] daemon: report list_fd errors through completion signal

The D-Bus reply with transfer_id is sent before list_fd() runs in its
worker thread, so an exception escaping the method cannot be reported as
a D-Bus error. The worker swallowed it and the client was left waiting
for WRITE_TO_FD_FINISHED signal forever.

Wrap the whole transfer in try/catch and report option decoding,
repository loading, package filtering, and serialization failures
through the completion signal.

Reset the owning sdbus::UnixFd before emitting the signal so the
descriptor is closed exactly once; the old raw close() left the UnixFd
owner unaware and its destructor closed the same descriptor a second
time.
---
 dnf5daemon-server/services/rpm/rpm.cpp | 72 ++++++++++++++------------
 1 file changed, 39 insertions(+), 33 deletions(-)

diff --git a/dnf5daemon-server/services/rpm/rpm.cpp b/dnf5daemon-server/services/rpm/rpm.cpp
index b3b313086..1e0f302a8 100644
--- a/dnf5daemon-server/services/rpm/rpm.cpp
+++ b/dnf5daemon-server/services/rpm/rpm.cpp
@@ -611,42 +611,48 @@ sdbus::MethodReply Rpm::list(sdbus::MethodCall & call) {
 }
 
 void Rpm::list_fd(sdbus::MethodCall & call, const std::string & transfer_id) {
-    // read options from dbus call
-    dnfdaemon::KeyValueMap options;
-    call >> options;
-    // get the output pipe file descriptor
-    sdbus::UnixFd dbus_unix_fd;
-    call >> dbus_unix_fd;
-
-    int out_fd = dbus_unix_fd.get();
-
-    bool interactive = dnfdaemon::key_value_map_get<bool>(options, "interactive", false);
-    session.fill_sack(interactive);
-
-    auto query = filter_packages(options);
-
-    std::vector<std::string> package_attrs =
-        dnfdaemon::key_value_map_get<std::vector<std::string>>(options, "package_attrs", std::vector<std::string>());
     std::string error_msg;
-    for (const auto & pkg : query) {
-        std::string jsonstr;
-        try {
-            jsonstr = package_to_json(pkg, package_attrs) + "\n";
-        } catch (const std::exception & ex) {
-            error_msg = fmt::format(
-                "Error serializing package \"{0}\" from repo \"{1}\": {2}",
-                pkg.get_nevra(),
-                pkg.get_repo_id(),
-                ex.what());
-            break;
-        }
-        std::string write_error;
-        if (!dnfdaemon::write_to_fd(jsonstr, out_fd, write_error)) {
-            error_msg = fmt::format("Error writing package list to the fd: {}", write_error);
-            break;
+    sdbus::UnixFd dbus_unix_fd;
+
+    try {
+        // read options from dbus call
+        dnfdaemon::KeyValueMap options;
+        call >> options;
+        // get the output pipe file descriptor
+        call >> dbus_unix_fd;
+
+        int out_fd = dbus_unix_fd.get();
+        bool interactive = dnfdaemon::key_value_map_get<bool>(options, "interactive", false);
+        session.fill_sack(interactive);
+        auto query = filter_packages(options);
+        std::vector<std::string> package_attrs = dnfdaemon::key_value_map_get<std::vector<std::string>>(
+            options, "package_attrs", std::vector<std::string>());
+
+        for (const auto & pkg : query) {
+            std::string jsonstr;
+            try {
+                jsonstr = package_to_json(pkg, package_attrs) + "\n";
+            } catch (const std::exception & ex) {
+                error_msg = fmt::format(
+                    "Error serializing package \"{0}\" from repo \"{1}\": {2}",
+                    pkg.get_nevra(),
+                    pkg.get_repo_id(),
+                    ex.what());
+                break;
+            }
+            std::string write_error;
+            if (!dnfdaemon::write_to_fd(jsonstr, out_fd, write_error)) {
+                error_msg = fmt::format("Error writing package list to the fd: {}", write_error);
+                break;
+            }
         }
+    } catch (const std::exception & ex) {
+        error_msg = ex.what();
+    } catch (...) {
+        error_msg = "Unknown error while listing packages.";
     }
-    close(out_fd);
+
+    dbus_unix_fd.reset();
 
     // signal client that the transfer has finished and the output file descriptor is closed
     auto dbus_object = get_session().get_dbus_object();
