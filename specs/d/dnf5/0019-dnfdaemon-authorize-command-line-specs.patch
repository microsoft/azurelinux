From 683bae57a9f0b6a1c2bacdf25761fa504d1037a9 Mon Sep 17 00:00:00 2001
From: Marek Blaha <mblaha@redhat.com>
Date: Thu, 5 Nov 2026 07:59:41 +0000
Subject: [PATCH 2/3] utils: add command-line package specification classifier

Goal::Impl::add_spec() previously combined the internal URL helper with a
local ".rpm" suffix check to decide whether a package specification refers
to a command-line package. That classification needs to be reused by callers
that must authorize external package inputs before libdnf5 opens or
downloads them.

Move the predicate to libdnf5::utils::is_cmdline_package_spec(), expose it
through the public libdnf5 utility API, and use it from Goal and
RepoSack. The function performs no filesystem or network I/O and
recognizes supported URLs and non-URL paths ending in ".rpm". Add tests
for scheme support, case insensitivity, query strings, and local paths.

This centralizes the existing behavior without changing it.
---
 include/libdnf5/utils/patterns.hpp   |  9 +++++++++
 libdnf5/base/goal.cpp                |  3 +--
 libdnf5/repo/repo_sack.cpp           |  6 +++++-
 libdnf5/utils/patterns.cpp           |  8 ++++++++
 test/libdnf5/utils/test_patterns.cpp | 15 +++++++++++++++
 test/libdnf5/utils/test_patterns.hpp |  2 ++
 6 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/include/libdnf5/utils/patterns.hpp b/include/libdnf5/utils/patterns.hpp
index cbeeb20f2..b6a800fad 100644
--- a/include/libdnf5/utils/patterns.hpp
+++ b/include/libdnf5/utils/patterns.hpp
@@ -38,6 +38,15 @@ LIBDNF_API bool is_glob_pattern(const char * pattern) noexcept;
 /// @return True if a given pattern is a file path
 LIBDNF_API bool is_file_pattern(const std::string & pattern) noexcept;
 
+/// @brief Check if a given package specification is a command-line package.
+///
+/// A command-line package specification is either a supported URL or a local path
+/// ending in ".rpm".
+///
+/// @param spec Text package specification to be tested
+/// @return True if a given specification is a command-line package
+LIBDNF_API bool is_cmdline_package_spec(const std::string & spec);
+
 }  // namespace libdnf5::utils
 
 #endif  // LIBDNF5_UTILS_PATTERNS_HPP
diff --git a/libdnf5/base/goal.cpp b/libdnf5/base/goal.cpp
index 208b429a2..2f7389bac 100644
--- a/libdnf5/base/goal.cpp
+++ b/libdnf5/base/goal.cpp
@@ -475,8 +475,7 @@ void Goal::Impl::add_spec(GoalAction action, const std::string & spec, const Goa
         group_specs.push_back(
             std::make_tuple(action, libdnf5::transaction::TransactionItemReason::USER, group_spec, group_settings));
     } else {
-        const std::string_view ext(".rpm");
-        if (libdnf5::utils::url::is_url(spec) || (spec.length() > ext.length() && spec.ends_with(ext))) {
+        if (libdnf5::utils::is_cmdline_package_spec(spec)) {
             // spec is a remote rpm file or a local rpm file
             if (action == GoalAction::REMOVE) {
                 throw RuntimeError(M_("Unsupported argument for REMOVE action: {}"), spec);
diff --git a/libdnf5/repo/repo_sack.cpp b/libdnf5/repo/repo_sack.cpp
index d63eb0aa0..361c5d65e 100644
--- a/libdnf5/repo/repo_sack.cpp
+++ b/libdnf5/repo/repo_sack.cpp
@@ -50,6 +50,7 @@ along with libdnf.  If not, see <https://www.gnu.org/licenses/>.
 #include "libdnf5/utils/bgettext/bgettext-mark-domain.h"
 #include "libdnf5/utils/fs/file.hpp"
 #include "libdnf5/utils/fs/temp.hpp"
+#include "libdnf5/utils/patterns.hpp"
 
 extern "C" {
 #include <solv/testcase.h>
@@ -230,9 +231,12 @@ std::map<std::string, libdnf5::rpm::Package> RepoSack::add_cmdline_packages(
     std::vector<std::string> rpm_filepaths;
     const std::string_view ext(".rpm");
     for (const auto & spec : paths) {
+        if (!libdnf5::utils::is_cmdline_package_spec(spec)) {
