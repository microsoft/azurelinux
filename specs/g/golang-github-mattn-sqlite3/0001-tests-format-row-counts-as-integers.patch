From b23074684ddaf703ed469b4b5bb91d9409cc4722 Mon Sep 17 00:00:00 2001
From: Mitch Zhu <mitchzhu@microsoft.com>
Date: Mon, 24 Aug 2026 23:26:16 +0000
Subject: [PATCH] tests: format row counts as integers

Go 1.26's stricter printf analysis rejects %q for integer row IDs and
counts. Use %d for those values and correct the affected error text.

Signed-off-by: Mitch Zhu <mitchzhu@microsoft.com>
---
 sqlite3_test.go | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/sqlite3_test.go b/sqlite3_test.go
--- a/sqlite3_test.go
+++ b/sqlite3_test.go
@@ -431,7 +431,7 @@ func TestUpdate(t *testing.T) {
		t.Fatal("Failed to get LastInsertId:", err)
 	}
 	if expected != lastID {
-		t.Errorf("Expected %q for last Id, but %q:", expected, lastID)
+		t.Errorf("Expected %d for last Id, but %d:", expected, lastID)
 	}
 	affected, _ = res.RowsAffected()
 	if err != nil {
@@ -484,7 +484,7 @@ func TestDelete(t *testing.T) {
		t.Fatal("Failed to get RowsAffected:", err)
 	}
 	if affected != 1 {
-		t.Errorf("Expected %d for cout of affected rows, but %q:", 1, affected)
+		t.Errorf("Expected %d for count of affected rows, but %d:", 1, affected)
 	}
 
 	res, err = db.Exec("delete from foo where id = 123")
@@ -496,14 +496,14 @@ func TestDelete(t *testing.T) {
		t.Fatal("Failed to get LastInsertId:", err)
 	}
 	if expected != lastID {
-		t.Errorf("Expected %q for last Id, but %q:", expected, lastID)
+		t.Errorf("Expected %d for last Id, but %d:", expected, lastID)
 	}
 	affected, err = res.RowsAffected()
 	if err != nil {
		t.Fatal("Failed to get RowsAffected:", err)
 	}
 	if affected != 1 {
-		t.Errorf("Expected %d for cout of affected rows, but %q:", 1, affected)
+		t.Errorf("Expected %d for count of affected rows, but %d:", 1, affected)
 	}
 
 	rows, err := db.Query("select id from foo")
--
2.51.0
