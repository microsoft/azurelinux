+/* Called with unused_thread_mutex held, including the count/serial update. */
+static void
+g_thread_pool_wakeup_unused_threads (guint n_threads)
+{
+  if (n_threads == 0)
+    return;
+
+  g_atomic_int_inc (&wakeup_thread_serial);
+  g_async_queue_lock (unused_thread_queue);
+  for (guint i = 0; i < n_threads; i++)
+    g_async_queue_push_unlocked (unused_thread_queue, wakeup_thread_marker);
+  g_async_queue_unlock (unused_thread_queue);
+}
