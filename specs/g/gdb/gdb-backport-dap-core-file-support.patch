+     cfpy_inferior_corefile_data_key;
+
+/* See python-internal.h.  */
+
+gdbpy_ref<>
+gdbpy_core_file_from_inferior (inferior *inf)
+{
+  gdb_assert (inf != nullptr);
+  gdb_assert (inf->pspace != nullptr);
