%bcond check 1

# https://github.com/tianon/gosu
%global goipath         github.com/tianon/gosu
Version:                1.19
%global tag             %{version}

%gometa -L -f

Name:           gosu
Release:        %autorelease
Summary:        Simple Go-based setuid+setgid+setgroups+exec
License:        Apache-2.0 AND BSD-3-Clause
URL:            %{gourl}
Source0:        %{gosource}
# Generated by go-vendor-tools / azldev custom-source workflow
Source1:        %{archivename}-vendor.tar.gz
Source2:        go-vendor-tools.toml

BuildRequires:  go-vendor-tools

%description
gosu is a simple tool grown out of the simple fact that su and sudo have very
strange and often annoying TTY and signal-forwarding behavior. Once the
user/group is processed, gosu switches to that user and execs the specified
process cleanly without an intermediate wrapper process.

%prep
%goprep -p1
tar -xf %{S:1}

%generate_buildrequires
%go_vendor_license_buildrequires -c %{S:2}

%build
%global gomodulesmode GO111MODULE=on
%gobuild -o %{gobuilddir}/bin/%{name} %{goipath}

%install
%go_vendor_license_install -c %{S:2}
install -Dpm 0755 %{gobuilddir}/bin/%{name} %{buildroot}%{_bindir}/%{name}

%check
%go_vendor_license_check -c %{S:2}
%if %{with check}
%gotest ./...
test "$(%{gobuilddir}/bin/%{name} --version | cut -d' ' -f1)" = "%{version}"
%endif

%files -f %{go_vendor_license_filelist}
%doc README.md SECURITY.md
%{_bindir}/%{name}

