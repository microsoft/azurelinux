@@ -164,18 +163,18 @@
             ::make_address(
                 uri.get_option("socket.if_addr",
                                ::any_addr(
-                                   resolve_result->endpoint().address())));
+                                   resolve_result.begin()->endpoint().address())));
 
-        if (is_multicast(resolve_result->endpoint()))
