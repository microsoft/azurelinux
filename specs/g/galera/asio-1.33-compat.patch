                     gu::from_string<bool>(uri.get_option("socket.if_loop", "false"))));
             socket_.set_option(
                 asio::ip::multicast::hops(
                     gu::from_string<int>(uri.get_option("socket.mcast_ttl", "1"))));
-            socket_.bind(*resolve_result);
+            socket_.bind(*resolve_result.begin());
