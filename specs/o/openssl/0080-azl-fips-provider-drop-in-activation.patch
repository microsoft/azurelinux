diff --git a/crypto/provider_conf.c b/crypto/provider_conf.c
index 1e5053c..795a19f 100644
--- a/crypto/provider_conf.c
+++ b/crypto/provider_conf.c
@@ -11,17 +11,40 @@
 #include <openssl/trace.h>
 #include <openssl/err.h>
 #include <openssl/evp.h>
-#include <unistd.h>
 #include <openssl/conf.h>
 #include <openssl/safestack.h>
 #include <openssl/provider.h>
 #include "internal/provider.h"
 #include "internal/cryptlib.h"
+#include "crypto/evp.h"
 #include "provider_local.h"
 #include "crypto/context.h"
 
 DEFINE_STACK_OF(OSSL_PROVIDER)
 
+/*
+ * Marker value used to designate the FIPS provider in the [azl_fips_provider]
+ * section of the FIPS provider drop-in. Each drop-in declares its provider as
+ *     <provider-name> = azl-fips-module
+ * The provider NAME is the config key (so distinct providers survive as
+ * distinct entries and can be counted), while this fixed VALUE marks the entry
+ * as a FIPS-provider designation. This lets us detect and reject a
+ * misconfiguration that designates more than one FIPS provider.
+ */
+#define OSSL_AZL_FIPS_PROVIDER_MARKER "azl-fips-module"
+#define OSSL_AZL_FIPS_PROVIDER_SECTION "azl_fips_provider"
+
+/*
+ * Per-provider knob (in the [azl_fips_provider] section) selecting how strict the
+ * default property query is once the FIPS provider is active:
+ *   enforcing -> fips=yes   (a fetch with no FIPS implementation fails)
+ *   preferred -> ?fips=yes  (FIPS preferred; falls back to a non-FIPS impl)
+ * Absent defaults to "enforcing".
+ */
+#define OSSL_AZL_FIPS_PROP_QUERY_KEY "azl_fips_prop_query_mode"
+#define OSSL_AZL_FIPS_PROP_QUERY_ENFORCING "enforcing"
+#define OSSL_AZL_FIPS_PROP_QUERY_PREFERRED "preferred"
+
 /* PROVIDER config module */
 
 typedef struct {
@@ -66,6 +89,63 @@ static const char *skip_dot(const char *name)
     return name;
 }
 
+/*
+ * Look up a key within a single CONF section by its logical (dot-stripped)
+ * name, returning the associated value or NULL if absent.
+ *
+ * Unlike NCONF_get_string(), this does NOT fall back to the [default] section
+ * or the process environment when the key is missing from the given section.
+ * The FIPS drop-in selection must stay strictly scoped: a stray top-level key
+ * (e.g. an 'azl_fips_prop_query_mode' left in the global section) must not be
+ * able to silently influence -- and in the enforcing->preferred case, weaken --
+ * the FIPS designation. skip_dot() matches the dotted-key convention the rest
+ * of provider_conf uses for name uniquification.
+ *
+ * This scoping also defends against an OpenSSL include quirk: Fedora's
+ * rh-openssl.cnf runs '.include /etc/pki/tls/openssl.d' from *inside*
+ * [default_sect], and CONF section context persists across include
+ * boundaries. Leading unsectioned lines in a drop-in are therefore parsed as
+ * part of [default_sect], not as top-level config -- so a drop-in must open
+ * [azl_fips_provider] (and its provider sections) explicitly. Because we never
+ * fall back to [default], such stray lines cannot reach or weaken the
+ * designation.
+ */
+static const char *section_get0_value(const STACK_OF(CONF_VALUE) *sect,
+                                      const char *key)
+{
+    int i;
+
+    if (sect == NULL)
+        return NULL;
+
+    for (i = 0; i < sk_CONF_VALUE_num(sect); i++) {
+        const CONF_VALUE *v = sk_CONF_VALUE_value(sect, i);
+
+        if (v->name != NULL && strcmp(skip_dot(v->name), key) == 0)
+            return v->value;
+    }
+    return NULL;
+}
+
+/*
+ * Fetch a CONF section without leaving a CONF "no such section" error on the
+ * error stack when it is simply absent -- the FIPS selection code reports its
+ * own, more specific diagnostics for a missing/empty section.
+ */
+static STACK_OF(CONF_VALUE) *get_section_quiet(const CONF *conf,
+                                               const char *name)
+{
+    STACK_OF(CONF_VALUE) *sect;
+
+    ERR_set_mark();
+    sect = NCONF_get_section(conf, name);
+    if (sect == NULL)
+        ERR_pop_to_mark();
+    else
+        ERR_clear_last_mark();
+    return sect;
+}
+
 /*
  * Parse the provider params section
  * Returns:
@@ -400,6 +480,275 @@ static int provider_conf_load(OSSL_LIB_CTX *libctx, const char *name,
     return ok >= 0;
 }
 
+/*
+ * Validate a FIPS provider drop-in CONF and select the single designated FIPS
+ * provider. This performs all of the drop-in validation -- it does NOT load a
+ * provider module -- so it can be unit-tested without a FIPS provider present.
+ *
+ * On success returns 1 and fills *name_out / *sect_out (both point into
+ * fips_conf; the caller keeps it alive) and *enforcing_out (1 = enforcing, 0 =
+ * preferred). Returns 0 on any misconfiguration, raising an error.
+ */
+int ossl_prov_conf_select_fips(const CONF *fips_conf, const char *prov_sect,
+                               const char **name_out, const char **sect_out,
+                               int *enforcing_out)
+{
+    STACK_OF(CONF_VALUE) *provlist;
+    STACK_OF(CONF_VALUE) *provsect;
+    CONF_VALUE *pval;
+    const char *fips_name = NULL;
+    const char *fips_sect = NULL;
+    const char *identity;
+    const char *mode = NULL;
+    int j, n = 0;
+    int aliases = 0;
+    int mode_entries = 0;
+    int fips_query_enforcing = 1;
+
+    /*
+     * The [azl_fips_provider] section designates which provider is THE FIPS
+     * provider. Count only entries whose value is OSSL_AZL_FIPS_PROVIDER_MARKER
+     * (the provider name is the key), so a misconfiguration that designates
+     * zero or more than one is detected rather than silently resolved.
+     */
+    provlist = get_section_quiet(fips_conf, OSSL_AZL_FIPS_PROVIDER_SECTION);
+    if (provlist == NULL) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "Kernel FIPS mode is active but the FIPS provider "
+                       "configuration has no [" OSSL_AZL_FIPS_PROVIDER_SECTION
+                       "] section designating a FIPS provider.");
+        return 0;
+    }
+
+    for (j = 0; j < sk_CONF_VALUE_num(provlist); j++) {
+        pval = sk_CONF_VALUE_value(provlist, j);
+        if (strcmp(skip_dot(pval->name), OSSL_AZL_FIPS_PROP_QUERY_KEY) == 0) {
+            mode = pval->value;
+            mode_entries++;
+        }
+        if (pval->value != NULL
+                && strcmp(pval->value, OSSL_AZL_FIPS_PROVIDER_MARKER) == 0) {
+            n++;
+            /*
+             * The provider name is the key. Strip any dotted uniquifier
+             * (e.g. "0.myfips") so the name matches its [provider_sect] entry
+             * and activates under the correct provider name.
+             */
+            fips_name = skip_dot(pval->name);
+        }
+    }
+
+    if (n != 1) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "Kernel FIPS mode is active but the ["
+                       OSSL_AZL_FIPS_PROVIDER_SECTION "] section designates %d FIPS "
+                       "providers (expected exactly one entry with value '"
+                       OSSL_AZL_FIPS_PROVIDER_MARKER "').", n);
+        return 0;
+    }
+
+    /*
+     * Map the designated provider name to its config section via the *actual*
+     * providers section (the value of the 'providers' line in openssl_init),
+     * not a hardcoded "provider_sect". The lookup is scoped to that section
+     * only -- a top-level key of the same name must not resolve it.
+     */
+    provsect = get_section_quiet(fips_conf, prov_sect);
+    fips_sect = section_get0_value(provsect, fips_name);
+    if (fips_sect == NULL) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "FIPS provider '%s' is designated in ["
+                       OSSL_AZL_FIPS_PROVIDER_SECTION "] but is not registered in "
+                       "[%s].", fips_name, prov_sect);
+        return 0;
+    }
+
+    /*
+     * The [provider_sect] key is the provider name. A redundant 'identity'
+     * that restates that name is fine; an aliasing 'identity' would load the
+     * provider under a different name than we designated, defeating the
+     * exactly-one check, so reject it.
+     */
+    identity = section_get0_value(get_section_quiet(fips_conf, fips_sect),
+                                  "identity");
+    if (identity != NULL && strcmp(identity, fips_name) != 0) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "FIPS provider section '%s' aliases its identity "
+                       "to '%s'; the designated FIPS provider must load "
+                       "under its [%s] name '%s'.",
+                       fips_sect, identity, prov_sect, fips_name);
+        return 0;
+    }
+
+    /*
+     * Alias-collision guard. The designated-identity check above only inspects
+     * the designated section. But ANOTHER entry in [prov_sect] -- with a
+     * different key -- can set 'identity = <fips_name>', which makes
+     * provider_conf_load() activate THAT entry's module under the designated
+     * name during provider_conf_init()'s ordinary providers loop, which runs
+     * BEFORE our forced, module-path-pinned activation. Fedora's fips-force
+     * patch then turns the pinned activation into a no-op success
+     * (prov_already_activated() -> the provider name is already active ->
+     * returns 1) WITHOUT loading the designated module path -- so the aliased
+     * module silently stands in for the one the drop-in designated, defeating
+     * the whole point of pinning the module path.
+     *
+     * Defend by requiring that exactly one [prov_sect] entry resolves to
+     * fips_name. An entry resolves via its section's 'identity' if present,
+     * otherwise via its own dot-stripped key (which is how provider_conf_load()
+     * derives the activation name). More than one match is a collision and
+     * fails closed.
+     */
+    for (j = 0; j < sk_CONF_VALUE_num(provsect); j++) {
+        const char *ename;
+
+        pval = sk_CONF_VALUE_value(provsect, j);
+        ename = section_get0_value(get_section_quiet(fips_conf, pval->value),
+                                   "identity");
+        if (ename == NULL)
+            ename = skip_dot(pval->name);
+        if (strcmp(ename, fips_name) == 0)
+            aliases++;
+    }
+    if (aliases != 1) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "%d [%s] entries resolve to the designated FIPS "
+                       "provider name '%s' (expected exactly one); another "
+                       "entry aliases its identity to the designated provider.",
+                       aliases, prov_sect, fips_name);
+        return 0;
+    }
+
+    /*
+     * Read the property-query strictness knob from the [azl_fips_provider]
+     * section only. Absent -> enforcing (the safe default). An invalid value
+     * or more than one logical mode entry fails closed rather than allowing
+     * include order to choose the effective policy.
+     */
+    if (mode_entries > 1) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "The [" OSSL_AZL_FIPS_PROVIDER_SECTION "] section "
+                       "contains %d '" OSSL_AZL_FIPS_PROP_QUERY_KEY "' "
+                       "entries (expected at most one).",
+                       mode_entries);
+        return 0;
+    }
+
+    if (mode == NULL) {
+        fips_query_enforcing = 1;       /* key absent: keep the default */
+    } else if (strcmp(mode, OSSL_AZL_FIPS_PROP_QUERY_ENFORCING) == 0) {
+        fips_query_enforcing = 1;
+    } else if (strcmp(mode, OSSL_AZL_FIPS_PROP_QUERY_PREFERRED) == 0) {
+        fips_query_enforcing = 0;
+    } else {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "Invalid '" OSSL_AZL_FIPS_PROP_QUERY_KEY "' value "
+                       "'%s' in [" OSSL_AZL_FIPS_PROVIDER_SECTION "] "
+                       "(expected '" OSSL_AZL_FIPS_PROP_QUERY_ENFORCING
+                       "' or '" OSSL_AZL_FIPS_PROP_QUERY_PREFERRED "').",
+                       mode);
+        return 0;
+    }
+
+    *name_out = fips_name;
+    *sect_out = fips_sect;
+    *enforcing_out = fips_query_enforcing;
+    return 1;
+}
+
+/*
+ * When the kernel is in FIPS mode, activate the single designated FIPS
+ * provider and enforce that exactly one FIPS provider is designated.
+ *
+ * The designation is read from the ambient configuration (cnf) -- the fully
+ * parsed openssl.cnf, which already pulls in every installed provider drop-in
+ * through its openssl.d include.
+ *
+ * Returns 1 on success (the designated FIPS provider and the base provider are
+ * loaded and active, and default properties require FIPS), or 0 on any
+ * failure.
+ */
+static int provider_conf_activate_fips(OSSL_LIB_CTX *libctx, const CONF *cnf,
+                                       const char *prov_sect)
+{
+    const char *fips_name = NULL;
+    const char *fips_sect = NULL;
+    const char *fips_path = NULL;
+    STACK_OF(CONF_VALUE) *fips_provconf;
+    int fips_query_enforcing = 1;
+
+    OSSL_TRACE(CONF, "Kernel FIPS mode active; selecting designated FIPS provider\n");
+
+    if (!ossl_prov_conf_select_fips(cnf, prov_sect, &fips_name, &fips_sect,
+                                    &fips_query_enforcing))
+        return 0;
+
+    OSSL_TRACE2(CONF, "Activating designated FIPS provider '%s' (section '%s')\n",
+                fips_name, fips_sect);
+
+    /*
+     * Resolve the designated provider's module path from its drop-in section so
+     * that the forced activation below loads the *configured* module rather
+     * than resolving the provider by bare name from the default module
+     * directory. A drop-in that omits 'module' (the common case -- the provider
+     * is found by name on the default search path) leaves fips_path NULL, which
+     * is fine.
+     */
+    fips_provconf = NCONF_get_section(cnf, fips_sect);
+    if (fips_provconf == NULL) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "FIPS provider section '%s' not found.", fips_sect);
+        return 0;
+    }
+    fips_path = section_get0_value(fips_provconf, "module");
+
+    /*
+     * Force the designated FIPS provider active. The kernel FIPS flag -- not
+     * the drop-in's 'activate' knob -- is the authority here, so we activate
+     * unconditionally and treat *any* failure as fatal.
+     *
+     * We pass the configured module path explicitly rather than letting the
+     * activation resolve the provider by bare name. provider_conf_activate()
+     * reports a *non-fatal* failure (return 0) when a configured activation
+     * fails to load its module; without the explicit path, a subsequent forced
+     * activation would fall back to loading a same-named provider from the
+     * default module directory -- silently substituting a different (and
+     * possibly non-validated) module for the one the drop-in designated. By
+     * pinning the path and requiring a return of 1, a module that cannot be
+     * loaded fails closed instead of being silently bypassed.
+     *
+     * Pass the provider section and ambient CONF as well as the pinned path.
+     * If its configured activate=1 attempt failed, this forced attempt is a
+     * retry and must retain the same integrity and security parameters rather
+     * than loading the module with defaults.
+     */
+    if (provider_conf_activate(libctx, fips_name, fips_sect, fips_path, 0,
+                               cnf) != 1) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "Failed to activate FIPS provider '%s'.", fips_name);
+        return 0;
+    }
+
+    if (provider_conf_activate(libctx, "base", NULL, NULL, 0, NULL) != 1)
+        return 0;
+
+    /*
+     * enforcing -> fips=yes (mandatory); preferred -> ?fips=yes (optional,
+     * allows fallback to a non-FIPS implementation). Merge (rather than
+     * replace) the default property query so that any default properties an
+     * application configured via its own alg_section are preserved and
+     * composed with our FIPS designation; our token wins on conflict.
+     */
+    if (evp_default_properties_merge(libctx,
+            fips_query_enforcing ? "fips=yes" : "?fips=yes", 1) != 1)
+        return 0;
+
+    OSSL_TRACE1(CONF, "FIPS provider active; default property query is '%s'\n",
+                fips_query_enforcing ? "fips=yes" : "?fips=yes");
+
+    return 1;
+}
+
 static int provider_conf_init(CONF_IMODULE *md, const CONF *cnf)
 {
     STACK_OF(CONF_VALUE) *elist;
@@ -424,28 +773,22 @@ static int provider_conf_init(CONF_IMODULE *md, const CONF *cnf)
             return 0;
     }
 
-    if (ossl_get_kernel_fips_flag() != 0) { /* XXX from provider_conf_load */
+    if (ossl_get_kernel_fips_flag() != 0) {
         OSSL_LIB_CTX *libctx = NCONF_get0_libctx((CONF *)cnf);
-#  define FIPS_LOCAL_CONF           OPENSSLDIR "/fips_local.cnf"
-
-        if (access(FIPS_LOCAL_CONF, R_OK) == 0) {
-            CONF *fips_conf = NCONF_new_ex(libctx, NCONF_default());
-            if (NCONF_load(fips_conf, FIPS_LOCAL_CONF, NULL) <= 0)
-                return 0;
 
-            if (provider_conf_load(libctx, "fips", "fips_sect", fips_conf) != 1) {
-                NCONF_free(fips_conf);
-                return 0;
-            }
-            NCONF_free(fips_conf);
-        } else {
-            if (provider_conf_activate(libctx, "fips", NULL, NULL, 0, NULL) != 1)
-                return 0;
-        }
-        if (provider_conf_activate(libctx, "base", NULL, NULL, 0, NULL) != 1)
-            return 0;
-        if (EVP_default_properties_enable_fips(libctx, 1) != 1)
+        if (!provider_conf_activate_fips(libctx, cnf, CONF_imodule_get_value(md))) {
+            /*
+             * The kernel is in FIPS mode but the designated FIPS provider could
+             * not be activated. This must be fatal regardless of the config's
+             * config_diagnostics setting: otherwise CONF_modules_load_file_ex()
+             * swallows the module return code under
+             * CONF_MFLAGS_IGNORE_RETURN_CODES and OpenSSL would come up without
+             * FIPS enforcement. Forcing diagnostics on makes the failure
+             * propagate so OPENSSL_init_crypto() fails closed.
+             */
+            OSSL_LIB_CTX_set_conf_diagnostics(libctx, 1);
             return 0;
+        }
     }
 
     return 1;
