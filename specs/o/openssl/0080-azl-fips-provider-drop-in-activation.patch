index c0f1d00..95e2b70 100644
--- a/include/internal/provider.h
+++ b/include/internal/provider.h
@@ -117,6 +117,38 @@ void ossl_provider_deinit_child(OSSL_LIB_CTX *ctx);
 /* FIPS flag access */
 int ossl_get_kernel_fips_flag(void);
 
+/*
+ * Validate a FIPS provider drop-in configuration and select the single
+ * designated FIPS provider.
+ *
+ * Pure with respect to the supplied CONF: it loads no provider module, so it
+ * is safe to unit-test without a FIPS provider present.
+ *
+ * Parameters:
+ *   fips_conf  - the parsed configuration to inspect
+ *   prov_sect  - name of the providers section (the value of the 'providers'
+ *                line in openssl_init, e.g. "provider_sect"); the designated
+ *                provider is mapped to its config section via this section only
+ *
+ * Returns 1 on success and sets:
+ *   *name_out       - the designated provider's name (dot-stripped)
+ *   *sect_out       - its config section name (its entry's value in prov_sect)
+ *                     (both borrowed from fips_conf; keep it alive, don't free)
+ *   *enforcing_out  - 1 = enforcing ("fips=yes"), 0 = preferred ("?fips=yes")
+ *
+ * Returns 0 (and raises an error) on any misconfiguration:
+ *   - no [azl_fips_provider] section
+ *   - not exactly one designated provider
+ *   - a designated name absent from the prov_sect section
+ *   - an aliasing 'identity' in the provider's section
+ *   - an invalid property-query mode
+ */
+struct conf_st;
+int ossl_prov_conf_select_fips(const struct conf_st *fips_conf,
+                               const char *prov_sect,
+                               const char **name_out, const char **sect_out,
+                               int *enforcing_out);
+
 # ifdef __cplusplus
 }
 # endif
