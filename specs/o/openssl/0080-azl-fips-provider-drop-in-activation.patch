diff --git a/test/prov_conf_fips_activate_test.c b/test/prov_conf_fips_activate_test.c
new file mode 100644
index 0000000..2d223ac
--- /dev/null
+++ b/test/prov_conf_fips_activate_test.c
@@ -0,0 +1,208 @@
+/*
+ * Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+ *
+ * Licensed under the Apache License 2.0 (the "License").  You may not use
+ * this file except in compliance with the License.  You can obtain a copy
+ * in the file LICENSE in the source distribution or at
+ * https://www.openssl.org/source/license.html
+ */
+
+/*
+ * Exercises the config-driven FIPS provider activation path in provider_conf.c
+ * with the kernel FIPS flag forced on (the recipe sets OPENSSL_FORCE_FIPS_MODE).
+ * Uses the built-in "null" provider as the designated FIPS provider, so no
+ * loadable module is required.
+ */
+
+#include <openssl/conf.h>
+#include <openssl/evp.h>
+#include <openssl/provider.h>
+#include "crypto/evp.h"
+#include "testutil.h"
+
+static char *good_cnf = NULL;
+static char *nodesig_cnf = NULL;
+static char *ambiguous_cnf = NULL;
+static char *unloadable_cnf = NULL;
+static char *merge_enforcing_cnf = NULL;
+static char *merge_preferred_cnf = NULL;
+
+/*
+ * A single valid designation activates the designated provider and forces the
+ * FIPS default property (enforcing -> fips=yes).
+ */
+static int test_designated_activates(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int testresult = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+
+    if (!TEST_true(OSSL_LIB_CTX_load_config(ctx, good_cnf)))
+        goto err;
+    if (!TEST_true(OSSL_PROVIDER_available(ctx, "null")))
+        goto err;
+    if (!TEST_true(EVP_default_properties_is_fips_enabled(ctx)))
+        goto err;
+
+    testresult = 1;
+ err:
+    OSSL_LIB_CTX_free(ctx);
+    return testresult;
+}
+
+/*
+ * With config_diagnostics = 0 (the shipped default that normally swallows
+ * module errors via CONF_MFLAGS_IGNORE_RETURN_CODES), a missing designation
+ * under kernel FIPS mode must still make config load FAIL. This proves
+ * provider_conf_init()'s forced OSSL_LIB_CTX_set_conf_diagnostics() propagates
+ * the failure so OpenSSL fails closed rather than coming up without FIPS.
+ */
+static int test_no_designation_fails_closed(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int testresult = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+
+    if (!TEST_false(OSSL_LIB_CTX_load_config(ctx, nodesig_cnf)))
+        goto err;
+
+    testresult = 1;
+ err:
+    OSSL_LIB_CTX_free(ctx);
+    return testresult;
+}
+
+/*
+ * Two entries carry the designation marker. Designating more than one FIPS
+ * provider is ambiguous and must fail closed under kernel FIPS mode.
+ */
+static int test_ambiguous_designation_fails(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int testresult = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+
+    if (!TEST_false(OSSL_LIB_CTX_load_config(ctx, ambiguous_cnf)))
+        goto err;
+
+    testresult = 1;
+ err:
+    OSSL_LIB_CTX_free(ctx);
+    return testresult;
+}
+
+/*
+ * The designated FIPS provider names a module that cannot be loaded. Activation
+ * must fail closed rather than coming up without the FIPS provider.
+ */
+static int test_unloadable_provider_fails(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int testresult = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+
+    if (!TEST_false(OSSL_LIB_CTX_load_config(ctx, unloadable_cnf)))
+        goto err;
+
+    testresult = 1;
+ err:
+    OSSL_LIB_CTX_free(ctx);
+    return testresult;
+}
+
+/*
+ * Merge (not replace) semantics: an application configures a default property
+ * (app.prop=1) via alg_section, which is processed before the FIPS drop-in. Our
+ * activation must merge the FIPS designation onto the existing query so BOTH
+ * the application's property and the FIPS token survive. Regression guard for
+ * the preferred-mode path, which previously called EVP_set_default_properties()
+ * and clobbered the application's query.
+ */
+static int check_merge_preserves_app_prop(const char *cnf, int optional)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    char *propstr = NULL;
+    int testresult = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+
+    if (!TEST_true(OSSL_LIB_CTX_load_config(ctx, cnf)))
+        goto err;
+    if (!TEST_true(OSSL_PROVIDER_available(ctx, "null")))
+        goto err;
+    if (!TEST_ptr(propstr = evp_get_global_properties_str(ctx, 1)))
+        goto err;
+    /*
+     * The application's alg_section property (app.prop) must survive the merge.
+     */
+    if (!TEST_ptr(strstr(propstr, "app.prop")))
+        goto err;
+    /*
+     * The mode-correct FIPS token must also survive: enforcing yields the
+     * mandatory "fips=yes", preferred yields the optional "?fips=yes". A bare
+     * strstr(propstr, "fips") cannot tell them apart (it also matches a negated
+     * "-fips"), so the '?' optional flag -- the whole point of preferred mode --
+     * would go unverified. Check the exact token instead. Because "fips=yes" is
+     * a substring of "?fips=yes", enforcing additionally asserts the '?' form is
+     * absent, pinning mandatory vs optional.
+     */
+    if (optional) {
+        if (!TEST_ptr(strstr(propstr, "?fips=yes")))
+            goto err;
+    } else {
+        if (!TEST_ptr(strstr(propstr, "fips=yes"))
+                || !TEST_ptr_null(strstr(propstr, "?fips=yes")))
+            goto err;
+    }
+
+    testresult = 1;
+ err:
+    OPENSSL_free(propstr);
+    OSSL_LIB_CTX_free(ctx);
+    return testresult;
+}
+
+static int test_merge_preserves_app_prop_enforcing(void)
+{
+    return check_merge_preserves_app_prop(merge_enforcing_cnf, 0);
+}
+
+static int test_merge_preserves_app_prop_preferred(void)
+{
+    return check_merge_preserves_app_prop(merge_preferred_cnf, 1);
+}
+
+OPT_TEST_DECLARE_USAGE("good_conf no_designation_conf ambiguous_conf unloadable_conf merge_enforcing_conf merge_preferred_conf\n")
+
+int setup_tests(void)
+{
+    if (!test_skip_common_options()) {
+        TEST_error("Error parsing test options\n");
+        return 0;
+    }
+
+    if (!TEST_ptr(good_cnf = test_get_argument(0))
+            || !TEST_ptr(nodesig_cnf = test_get_argument(1))
+            || !TEST_ptr(ambiguous_cnf = test_get_argument(2))
+            || !TEST_ptr(unloadable_cnf = test_get_argument(3))
+            || !TEST_ptr(merge_enforcing_cnf = test_get_argument(4))
+            || !TEST_ptr(merge_preferred_cnf = test_get_argument(5)))
+        return 0;
+
+    ADD_TEST(test_designated_activates);
+    ADD_TEST(test_no_designation_fails_closed);
+    ADD_TEST(test_ambiguous_designation_fails);
+    ADD_TEST(test_unloadable_provider_fails);
+    ADD_TEST(test_merge_preserves_app_prop_enforcing);
+    ADD_TEST(test_merge_preserves_app_prop_preferred);
+    return 1;
+}
