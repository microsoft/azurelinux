@@ -0,0 +1,89 @@
+/*
+ * Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+ *
+ * Licensed under the Apache License 2.0 (the "License").  You may not use
+ * this file except in compliance with the License.  You can obtain a copy
+ * in the file LICENSE in the source distribution or at
+ * https://www.openssl.org/source/license.html
+ */
+
+/*
+ * Exercises the config-driven FIPS provider path with the kernel FIPS flag OFF
+ * (the recipe does NOT set OPENSSL_FORCE_FIPS_MODE, and the build host is not in
+ * kernel FIPS mode). The whole [azl_fips_provider] mechanism must be inert:
+ * configs that would fail closed under kernel FIPS mode load normally, and no
+ * FIPS default property is forced. This is a separate binary from the
+ * activation test because the kernel FIPS flag is read once per process.
+ */
+
+#include <openssl/conf.h>
+#include <openssl/evp.h>
+#include "testutil.h"
+
+static char *good_cnf = NULL;
+static char *nodesig_cnf = NULL;
+
+/*
+ * A missing designation is fatal only under kernel FIPS mode. With the kernel
+ * flag off, the same config that fails closed in the activation test loads
+ * fine and does not force FIPS.
+ */
+static int test_no_designation_ok_when_fips_off(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int testresult = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+
+    if (!TEST_true(OSSL_LIB_CTX_load_config(ctx, nodesig_cnf)))
+        goto err;
+    if (!TEST_false(EVP_default_properties_is_fips_enabled(ctx)))
+        goto err;
+
+    testresult = 1;
+ err:
+    OSSL_LIB_CTX_free(ctx);
+    return testresult;
+}
+
+/*
+ * A valid designation is ignored when the kernel is not in FIPS mode: the
+ * provider is not force-activated and the FIPS default property is not set.
+ */
+static int test_designation_inert_when_fips_off(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int testresult = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+
+    if (!TEST_true(OSSL_LIB_CTX_load_config(ctx, good_cnf)))
+        goto err;
+    if (!TEST_false(EVP_default_properties_is_fips_enabled(ctx)))
+        goto err;
+
+    testresult = 1;
+ err:
+    OSSL_LIB_CTX_free(ctx);
+    return testresult;
+}
+
+OPT_TEST_DECLARE_USAGE("good_conf no_designation_conf\n")
+
+int setup_tests(void)
+{
+    if (!test_skip_common_options()) {
+        TEST_error("Error parsing test options\n");
+        return 0;
+    }
+
+    if (!TEST_ptr(good_cnf = test_get_argument(0))
+            || !TEST_ptr(nodesig_cnf = test_get_argument(1)))
+        return 0;
+
+    ADD_TEST(test_no_designation_ok_when_fips_off);
+    ADD_TEST(test_designation_inert_when_fips_off);
+    return 1;
+}
diff --git a/test/prov_conf_fips_substitution.cnf b/test/prov_conf_fips_substitution.cnf
new file mode 100644
index 0000000..d7996b3
--- /dev/null
+++ b/test/prov_conf_fips_substitution.cnf
@@ -0,0 +1,27 @@
+openssl_conf = openssl_init
+
+# Deliberately 0: the shipped default that would normally swallow module errors.
+config_diagnostics = 0
+
+[openssl_init]
+providers = provider_sect
+
+# activate = 1 so the generic provider loop attempts to LOAD the drop-in from its
+# configured (bogus) module path. That load soft-fails. The bug was that the
+# forced FIPS activation then retried the provider by bare name, resolving a
+# same-named module from the default module directory -- silently substituting a
+# different, possibly non-validated module for the one the drop-in designated.
+# The forced activation must instead pin the configured path and fail closed.
+[provider_sect]
+myfips = myfips_sect
+
+[myfips_sect]
+module = /nonexistent/myfips.so
+activate = 1
+
+# Designated FIPS provider points at a module that cannot be loaded. Under kernel
+# FIPS mode, activation must fail closed even though a loadable, same-named decoy
+# (myfips.so) is present on the default module search path.
+[azl_fips_provider]
+myfips = azl-fips-module
+azl_fips_prop_query_mode = enforcing
diff --git a/test/prov_conf_fips_test.c b/test/prov_conf_fips_test.c
new file mode 100644
index 0000000..b7c46cf
--- /dev/null
+++ b/test/prov_conf_fips_test.c
@@ -0,0 +1,330 @@
+/*
+ * Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+ *
+ * Licensed under the Apache License 2.0 (the "License").  You may not use
+ * this file except in compliance with the License.  You can obtain a copy
+ * in the file LICENSE in the source distribution or at
+ * https://www.openssl.org/source/license.html
+ */
+
+/*
+ * Unit tests for the FIPS provider drop-in validation performed by
+ * ossl_prov_conf_select_fips() (crypto/provider_conf.c). These exercise the
+ * "designate exactly one FIPS provider" and property-query-mode parsing logic
+ * without loading a provider module, so no FIPS provider needs to be present.
+ */
+
+#include <openssl/bio.h>
+#include <openssl/conf.h>
+#include <openssl/err.h>
+#include "internal/provider.h"
+#include "testutil.h"
+
+/* Load an in-memory config string into a fresh CONF. */
+static CONF *conf_from_string(const char *str)
+{
+    CONF *conf = NCONF_new(NULL);
+    BIO *bio = BIO_new_mem_buf(str, -1);
+    long eline = 0;
+
+    if (conf == NULL || bio == NULL || NCONF_load_bio(conf, bio, &eline) <= 0) {
+        NCONF_free(conf);
+        BIO_free(bio);
+        return NULL;
+    }
+    BIO_free(bio);
+    return conf;
+}
+
+/*
+ * Drive ossl_prov_conf_select_fips() with a config string and compare against
+ * the expected outcome. On expected success, also check the selected provider
+ * name and the enforcing flag. Errors left on the stack by failure cases are
+ * cleared so they do not bleed into later tests.
+ */
+static int check_select(const char *cfg, const char *prov_sect, int expect_ok,
+                        const char *expect_name, int expect_enforcing)
+{
+    CONF *conf = conf_from_string(cfg);
+    const char *name = NULL;
+    const char *sect = NULL;
+    int enforcing = -1;
+    int rc, testresult = 0;
+
+    if (!TEST_ptr(conf))
+        goto err;
+
+    rc = ossl_prov_conf_select_fips(conf, prov_sect, &name, &sect, &enforcing);
+    if (!TEST_int_eq(rc, expect_ok))
+        goto err;
+
+    if (expect_ok) {
+        if (!TEST_str_eq(name, expect_name)
+                || !TEST_ptr(sect)
+                || !TEST_int_eq(enforcing, expect_enforcing))
+            goto err;
+    } else {
+        ERR_clear_error();
+    }
+
+    testresult = 1;
+ err:
+    NCONF_free(conf);
+    return testresult;
+}
+
+/* A well-formed drop-in with a single designated, registered provider. */
+#define BASE_PROVIDER_SECT \
+    "[provider_sect]\n" \
+    "fips = fips_sect\n" \
+    "[fips_sect]\n" \
+    "activate = 1\n"
+
+static int test_enforcing_explicit(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "azl_fips_prop_query_mode = enforcing\n"
+                        BASE_PROVIDER_SECT,
+                        "provider_sect", 1, "fips", 1);
+}
+
+static int test_preferred(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "azl_fips_prop_query_mode = preferred\n"
+                        BASE_PROVIDER_SECT,
+                        "provider_sect", 1, "fips", 0);
+}
+
+/* Absent mode key defaults to enforcing. */
+static int test_mode_default(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        BASE_PROVIDER_SECT,
+                        "provider_sect", 1, "fips", 1);
+}
+
+static int test_invalid_mode(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "azl_fips_prop_query_mode = sometimes\n"
+                        BASE_PROVIDER_SECT,
+                        "provider_sect", 0, NULL, 0);
+}
+
+/*
+ * Dotted uniquifiers allow merged drop-ins to retain duplicate logical keys.
+ * Conflicting mode entries must fail closed instead of letting include order
+ * silently choose between enforcing and preferred.
+ */
+static int test_ambiguous_mode(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "0.azl_fips_prop_query_mode = enforcing\n"
+                        "1.azl_fips_prop_query_mode = preferred\n"
+                        BASE_PROVIDER_SECT,
+                        "provider_sect", 0, NULL, 0);
+}
+
+/* No [azl_fips_provider] section at all. */
+static int test_missing_section(void)
+{
+    return check_select(BASE_PROVIDER_SECT, "provider_sect", 0, NULL, 0);
+}
+
+/* A [azl_fips_provider] section that designates nothing (only the mode key). */
+static int test_zero_designations(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "azl_fips_prop_query_mode = enforcing\n"
+                        BASE_PROVIDER_SECT,
+                        "provider_sect", 0, NULL, 0);
+}
+
+/* Two providers both marked azl-fips-module -> ambiguous, must fail. */
+static int test_two_designations(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "symcrypt = azl-fips-module\n"
+                        "[provider_sect]\n"
+                        "fips = fips_sect\n"
+                        "symcrypt = symcrypt_sect\n"
+                        "[fips_sect]\n"
+                        "activate = 1\n"
+                        "[symcrypt_sect]\n"
+                        "activate = 1\n",
+                        "provider_sect", 0, NULL, 0);
+}
+
+/* Designated name is absent from [provider_sect]. */
+static int test_unregistered_name(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "[provider_sect]\n"
+                        "default = default_sect\n"
+                        "[default_sect]\n"
+                        "activate = 1\n",
+                        "provider_sect", 0, NULL, 0);
+}
+
+/* A redundant 'identity' that restates the designated name is allowed. */
+static int test_redundant_identity(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "[provider_sect]\n"
+                        "fips = fips_sect\n"
+                        "[fips_sect]\n"
+                        "activate = 1\n"
+                        "identity = fips\n",
+                        "provider_sect", 1, "fips", 1);
+}
+
+/* An aliasing 'identity' (differs from the designated name) must fail. */
+static int test_aliasing_identity(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "[provider_sect]\n"
+                        "fips = fips_sect\n"
+                        "[fips_sect]\n"
+                        "activate = 1\n"
+                        "identity = something_else\n",
+                        "provider_sect", 0, NULL, 0);
+}
+
+/*
+ * The providers section is named by the 'providers' line in openssl_init, not
+ * hardwired to "provider_sect". Selection must honor the caller-supplied name
+ * (here "my_providers") when mapping the designated provider to its section.
+ */
+static int test_custom_providers_section(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "[my_providers]\n"
+                        "fips = fips_sect\n"
+                        "[fips_sect]\n"
+                        "activate = 1\n",
+                        "my_providers", 1, "fips", 1);
+}
+
+/*
+ * The name->section map must be scoped to the providers section only. A stray
+ * top-level 'fips = ...' must NOT satisfy an unregistered designation via
+ * NCONF_get_string()'s [default]-section fallback.
+ */
+static int test_name_map_no_default_fallback(void)
+{
+    return check_select("fips = fips_sect\n"
+                        "[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "[provider_sect]\n"
+                        "default = default_sect\n"
+                        "[default_sect]\n"
+                        "activate = 1\n"
+                        "[fips_sect]\n"
+                        "activate = 1\n",
+                        "provider_sect", 0, NULL, 0);
+}
+
+/*
+ * The property-query mode must be read from [azl_fips_provider] only. A stray
+ * top-level 'azl_fips_prop_query_mode = preferred' must NOT downgrade the
+ * enforcing default via the [default]-section fallback.
+ */
+static int test_mode_no_default_fallback(void)
+{
+    return check_select("azl_fips_prop_query_mode = preferred\n"
+                        "[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        BASE_PROVIDER_SECT,
+                        "provider_sect", 1, "fips", 1);
+}
+
+/*
+ * Dotted uniquifiers on the designation key (and its [provider_sect] entry)
+ * are stripped, so the provider is selected and named correctly.
+ */
+static int test_dotted_designation(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "0.fips = azl-fips-module\n"
+                        "[provider_sect]\n"
+                        "0.fips = fips_sect\n"
+                        "[fips_sect]\n"
+                        "activate = 1\n",
+                        "provider_sect", 1, "fips", 1);
+}
+
+/*
+ * Alias collision: a second provider entry ('decoy') sets identity = the
+ * designated name ('fips'). During provider_conf_init()'s providers loop that
+ * decoy activates its own module UNDER the name 'fips' before our forced,
+ * module-path-pinned activation runs; Fedora's fips-force then makes the pinned
+ * activation a no-op success, so the decoy would silently stand in for the
+ * designated module. Selection must reject this and fail closed.
+ */
+static int test_alias_collision(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "[provider_sect]\n"
+                        "decoy = decoy_sect\n"
+                        "fips = fips_sect\n"
+                        "[decoy_sect]\n"
+                        "activate = 1\n"
+                        "identity = fips\n"
+                        "[fips_sect]\n"
+                        "activate = 1\n",
+                        "provider_sect", 0, NULL, 0);
+}
+
+/*
+ * The alias-collision guard must not over-reject: a well-formed config may list
+ * OTHER, differently-named providers alongside the designated FIPS provider.
+ * Only entries resolving to the designated name collide; an unrelated provider
+ * (its own distinct name, no aliasing identity) must be allowed.
+ */
+static int test_other_provider_ok(void)
+{
+    return check_select("[azl_fips_provider]\n"
+                        "fips = azl-fips-module\n"
+                        "[provider_sect]\n"
+                        "default = default_sect\n"
+                        "fips = fips_sect\n"
+                        "[default_sect]\n"
+                        "activate = 1\n"
+                        "[fips_sect]\n"
+                        "activate = 1\n",
+                        "provider_sect", 1, "fips", 1);
+}
+
+int setup_tests(void)
+{
+    ADD_TEST(test_enforcing_explicit);
+    ADD_TEST(test_preferred);
+    ADD_TEST(test_mode_default);
+    ADD_TEST(test_invalid_mode);
+    ADD_TEST(test_ambiguous_mode);
+    ADD_TEST(test_missing_section);
+    ADD_TEST(test_zero_designations);
+    ADD_TEST(test_two_designations);
+    ADD_TEST(test_unregistered_name);
+    ADD_TEST(test_redundant_identity);
+    ADD_TEST(test_aliasing_identity);
+    ADD_TEST(test_custom_providers_section);
+    ADD_TEST(test_name_map_no_default_fallback);
+    ADD_TEST(test_mode_no_default_fallback);
+    ADD_TEST(test_dotted_designation);
+    ADD_TEST(test_alias_collision);
+    ADD_TEST(test_other_provider_ok);
+    return 1;
+}
diff --git a/test/prov_conf_fips_unloadable.cnf b/test/prov_conf_fips_unloadable.cnf
new file mode 100644
index 0000000..5a35d44
--- /dev/null
+++ b/test/prov_conf_fips_unloadable.cnf
@@ -0,0 +1,24 @@
+openssl_conf = openssl_init
+
+# Deliberately 0: proves the failure propagates even when errors are ignored.
+config_diagnostics = 0
+
+[openssl_init]
+providers = provider_sect
+
+# activate = 0 so the generic provider loop only registers the drop-in without
+# loading it; the load failure must surface from the forced FIPS activation
+# path (which forces diagnostics on), not the generic loop (whose error is
+# swallowed under config_diagnostics = 0).
+[provider_sect]
+brokenfips = brokenfips_sect
+
+[brokenfips_sect]
+module = /nonexistent/azl-broken-fips.so
+activate = 0
+
+# The designated FIPS provider points at a module that cannot be loaded, so
+# activation must fail closed under kernel FIPS mode.
+[azl_fips_provider]
+brokenfips = azl-fips-module
+azl_fips_prop_query_mode = enforcing
