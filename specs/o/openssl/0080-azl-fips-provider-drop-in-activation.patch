+             srctop_file("test", "prov_conf_fips_unloadable.cnf"),
+             srctop_file("test", "prov_conf_fips_merge_enforcing.cnf"),
+             srctop_file("test", "prov_conf_fips_merge_preferred.cnf")])),
+   "config-driven FIPS activation and fail-closed under forced kernel FIPS");
diff --git a/test/recipes/03-test_prov_conf_fips_off.t b/test/recipes/03-test_prov_conf_fips_off.t
new file mode 100644
index 0000000..fc3a16f
--- /dev/null
+++ b/test/recipes/03-test_prov_conf_fips_off.t
@@ -0,0 +1,41 @@
+#! /usr/bin/env perl
+# Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+#
+# Licensed under the Apache License 2.0 (the "License").  You may not use
+# this file except in compliance with the License.  You can obtain a copy
+# in the file LICENSE in the source distribution or at
+# https://www.openssl.org/source/license.html
+
+use strict;
+use warnings;
+
+use OpenSSL::Test qw/:DEFAULT srctop_file/;
+
+setup("test_prov_conf_fips_off");
+
+# Deliberately do NOT set OPENSSL_FORCE_FIPS_MODE: this process must run with the
+# kernel FIPS flag off, so the [azl_fips_provider] mechanism must be inert.
+delete $ENV{OPENSSL_FORCE_FIPS_MODE};
+
+# OPENSSL_FORCE_FIPS_MODE only forces the flag ON; there is no force-OFF hook, so
+# with the env var unset the kernel FIPS flag falls back to
+# /proc/sys/crypto/fips_enabled. On a FIPS-enabled build host we therefore cannot
+# create the "kernel not in FIPS mode" condition this recipe requires, and the
+# inert assertions would spuriously fail. Skip there to keep %check deterministic.
+my $host_fips = 0;
+if (open(my $fh, '<', '/proc/sys/crypto/fips_enabled')) {
+    my $val = <$fh>;
+    close($fh);
+    $host_fips = 1 if defined $val && $val =~ /^\s*1/;
+}
+
+plan skip_all =>
+    "host kernel is in FIPS mode; cannot exercise the inert (non-FIPS) path"
+    if $host_fips;
+
+plan tests => 1;
+
+ok(run(test(["prov_conf_fips_off_test",
+             srctop_file("test", "prov_conf_fips_good.cnf"),
+             srctop_file("test", "prov_conf_fips_nodesig.cnf")])),
+   "FIPS designation mechanism is inert when the kernel is not in FIPS mode");
diff --git a/test/recipes/03-test_prov_conf_fips_realinit.t b/test/recipes/03-test_prov_conf_fips_realinit.t
new file mode 100644
index 0000000..a1387c5
--- /dev/null
+++ b/test/recipes/03-test_prov_conf_fips_realinit.t
@@ -0,0 +1,55 @@
+#! /usr/bin/env perl
+# Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+#
+# Licensed under the Apache License 2.0 (the "License").  You may not use
+# this file except in compliance with the License.  You can obtain a copy
+# in the file LICENSE in the source distribution or at
+# https://www.openssl.org/source/license.html
+
+use strict;
+use warnings;
+use OpenSSL::Test qw/:DEFAULT srctop_file/;
+
+setup("test_prov_conf_fips_realinit");
+
+# This recipe exists specifically to cover the fail-closed *delivery* path that
+# the C-driver suites structurally cannot reach.
+#
+# The C tests load config via OSSL_LIB_CTX_load_config(), i.e.
+# CONF_modules_load_file_ex(..., flags=0). With flags == 0 the
+# CONF_MFLAGS_IGNORE_RETURN_CODES bit is never set, so the return-code-swallow
+# in CONF_modules_load_file_ex ("if (IGNORE_RETURN_CODES && !diagnostics) ret =
+# 1;") is unreachable there. Those tests therefore only prove that the engine
+# *decides* to fail (select/activate returns 0); they cannot prove the failure
+# is *delivered* to the caller.
+#
+# The real process init path (OPENSSL_init_crypto -> DEFAULT_CONF_MFLAGS) DOES
+# set IGNORE_RETURN_CODES. On that path a decided FIPS failure would be silently
+# swallowed -- the host would come up without FIPS (fail open) -- unless the
+# forced-activation code turns config diagnostics on mid-load so the swallow is
+# skipped. This recipe drives that exact path by shelling to apps/openssl and
+# asserts the process fails closed.
+#
+# Regression value: remove the diagnostics-forcing and this goes RED (openssl
+# starts, exits 0) while every C-driver test stays green.
+plan tests => 1;
+
+# The kernel FIPS flag is read once per process from this env var, so the run
+# behaves as if the kernel were in FIPS mode.
+$ENV{OPENSSL_FORCE_FIPS_MODE} = 1;
+
+# Reuse the missing-designation drop-in: it activates the built-in null provider
+# (no loadable module required, so this is deterministic and never skips) but
+# provides no [azl_fips_provider] designation, so forced FIPS activation must
+# fail. Crucially the file sets config_diagnostics = 0 -- the shipped default
+# that, together with IGNORE_RETURN_CODES on the real init path, would swallow
+# the error. Only the forced diagnostics override makes this fail closed.
+$ENV{OPENSSL_CONF} = srctop_file("test", "prov_conf_fips_nodesig.cnf");
+
+# `openssl list -providers` triggers full library initialization through the
+# real config-load path. Fail-closed means startup fails and the command exits
+# non-zero. On code without the diagnostics-forcing fix, IGNORE_RETURN_CODES
+# swallows the failure, the command starts non-FIPS and exits 0 -- which this
+# assertion catches.
+ok(!run(app(["openssl", "list", "-providers"])),
+   "missing FIPS designation under kernel FIPS mode fails closed on the real init path");
diff --git a/test/recipes/03-test_prov_conf_fips_substitution.t b/test/recipes/03-test_prov_conf_fips_substitution.t
new file mode 100644
index 0000000..703a42a
--- /dev/null
+++ b/test/recipes/03-test_prov_conf_fips_substitution.t
@@ -0,0 +1,47 @@
+#! /usr/bin/env perl
+# Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+#
+# Licensed under the Apache License 2.0 (the "License").  You may not use
+# this file except in compliance with the License.  You can obtain a copy
+# in the file LICENSE in the source distribution or at
+# https://www.openssl.org/source/license.html
+
+use strict;
+use warnings;
+use File::Copy;
+use File::Spec::Functions qw/catdir catfile/;
+use OpenSSL::Test qw/:DEFAULT srctop_file bldtop_file result_dir/;
+
+setup("test_prov_conf_fips_substitution");
+
+# This regression needs a loadable, same-named decoy module on the default
+# search path. Reuse the built legacy provider as the decoy; skip if it is not
+# built (e.g. no-legacy / no-module / static builds).
+my $decoy_src = bldtop_file("providers", "legacy.so");
+
+plan skip_all => "loadable legacy provider module not built"
+    unless -f $decoy_src;
+
+plan tests => 1;
+
+# Plant the decoy on the default module search path as "myfips.so" -- the bare
+# name the pre-fix code would fall back to when the designated provider's
+# configured (bogus) module path fails to load.
+my $moddir = catdir(result_dir(), "mods");
+mkdir $moddir unless -d $moddir;
+my $decoy = catfile($moddir, "myfips.so");
+copy($decoy_src, $decoy) or die "cannot plant decoy module: $!";
+
+# The kernel FIPS flag is read once per process from this env var, so the run
+# behaves as if the kernel were in FIPS mode.
+$ENV{OPENSSL_FORCE_FIPS_MODE} = 1;
+$ENV{OPENSSL_MODULES} = $moddir;
+$ENV{OPENSSL_CONF} = srctop_file("test", "prov_conf_fips_substitution.cnf");
+
+# Fail-closed: the designated FIPS provider's configured module cannot load, and
+# the forced activation must pin that path rather than retrying by bare name. So
+# startup fails and `openssl list -providers` exits non-zero. On the pre-fix
+# code the bare-name retry loads the planted decoy and the command exits 0 --
+# this assertion is what catches that silent substitution.
+ok(!run(app(["openssl", "list", "-providers"])),
+   "designated FIPS provider with unloadable module fails closed; no bare-name substitution");
