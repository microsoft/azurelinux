+/*
+ * Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+ *
+ * Licensed under the Apache License 2.0 (the "License").  You may not use
+ * this file except in compliance with the License.  You can obtain a copy
+ * in the file LICENSE in the source distribution or at
+ * https://www.openssl.org/source/license.html
+ */
+
+#include <stdio.h>
+#include <openssl/crypto.h>
+#include <openssl/err.h>
+#include <openssl/evp.h>
+#include <openssl/provider.h>
+
+int main(void)
+{
+    EVP_MD *sha256 = NULL;
+    int ok = 1;
+
+    if (OPENSSL_init_crypto(OPENSSL_INIT_LOAD_CONFIG, NULL)) {
+        fprintf(stderr, "kernel-FIPS initialization unexpectedly succeeded\n");
+        return 1;
+    }
+    ERR_clear_error();
+
+    if (OSSL_PROVIDER_available(NULL, "default")) {
+        fprintf(stderr, "default provider activated after initialization failure\n");
+        ok = 0;
+    }
+    ERR_clear_error();
+
+    sha256 = EVP_MD_fetch(NULL, "SHA2-256", NULL);
+    if (sha256 != NULL) {
+        fprintf(stderr, "SHA2-256 fetched after initialization failure\n");
+        ok = 0;
+    }
+    EVP_MD_free(sha256);
+
+    return ok ? 0 : 1;
+}
diff --git a/test/prov_conf_fips_registration_test.c b/test/prov_conf_fips_registration_test.c
new file mode 100644
index 0000000..8cf007f
--- /dev/null
+++ b/test/prov_conf_fips_registration_test.c
@@ -0,0 +1,510 @@
+/*
+ * Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+ *
+ * Licensed under the Apache License 2.0 (the "License").  You may not use
+ * this file except in compliance with the License.  You can obtain a copy
+ * in the file LICENSE in the source distribution or at
+ * https://www.openssl.org/source/license.html
+ */
+
+#include <string.h>
+#include <openssl/err.h>
+#include <openssl/evperr.h>
+#include <openssl/provider.h>
+#include "crypto/evp.h"
+#include "internal/provider.h"
+#include "testutil.h"
+
+static char *valid_dir;
+static char *valid_file;
+static char *hidden_dir;
+static char *hidden_file;
+static char *uppercase_dir;
+static char *uppercase_file;
+static char *empty_dir;
+static char *nonexistent_dir;
+static char *multiple_dir;
+static char *inactive_file;
+static char *bad_properties_file;
+static char *bad_identity_file;
+static char *soft_load_file;
+static char *missing_metadata_file;
+static char *missing_provider_file;
+static char *empty_provider_file;
+static char *missing_section_file;
+static char *empty_section_file;
+static char *missing_properties_file;
+static char *empty_properties_file;
+static char *duplicate_metadata_file;
+static char *dotted_identity_file;
+
+static int count_property_token(const char *properties, const char *token)
+{
+    const char *start = properties;
+    size_t token_len = strlen(token);
+    int count = 0;
+
+    while (start != NULL) {
+        const char *end = strchr(start, ',');
+        size_t len = end == NULL ? strlen(start) : (size_t)(end - start);
+
+        if (len == token_len && strncmp(start, token, len) == 0)
+            count++;
+        start = end == NULL ? NULL : end + 1;
+    }
+    return count;
+}
+
+static int check_last_error(int expected_reason, const char *expected_data)
+{
+    const char *data = NULL;
+    unsigned long error = ERR_peek_last_error_all(NULL, NULL, NULL, &data, NULL);
+
+    if (!TEST_ulong_ne(error, 0)
+            || (expected_reason != 0
+                && !TEST_int_eq(ERR_GET_REASON(error), expected_reason))
+            || !TEST_ptr(data)
+            || !TEST_true(strstr(data, expected_data) != NULL))
+        return 0;
+    return 1;
+}
+
+static int check_provider_initialized(OSSL_LIB_CTX *ctx, const char *name,
+                                      int expected)
+{
+    OSSL_PROVIDER *provider = ossl_provider_find(ctx, name, 1);
+    int initialized = provider != NULL
+                      && ossl_provider_get0_dispatch(provider) != NULL;
+    int ok = TEST_int_eq(initialized, expected);
+
+    ossl_provider_free(provider);
+    return ok;
+}
+
+static int check_no_registration_properties(OSSL_LIB_CTX *ctx)
+{
+    char *properties = evp_get_global_properties_str(ctx, 0);
+    int ok = properties == NULL
+             || (count_property_token(properties,
+                                      "?provider=symcryptprovider") == 0
+                 && count_property_token(properties, "?fips=yes") == 0);
+
+    OPENSSL_free(properties);
+    return TEST_true(ok);
+}
+
+static int check_registration_path(const char *dir, const char *expected)
+{
+    char *actual = ossl_provider_conf_find_fips_registration_path(dir);
+    int ok = TEST_ptr(actual) && TEST_str_eq(actual, expected);
+
+    OPENSSL_free(actual);
+    return ok;
+}
+
+static int test_find_valid_registration(void)
+{
+    return check_registration_path(valid_dir, valid_file);
+}
+
+static int test_find_hidden_registration(void)
+{
+    return check_registration_path(hidden_dir, hidden_file);
+}
+
+static int test_find_uppercase_registration(void)
+{
+    return check_registration_path(uppercase_dir, uppercase_file);
+}
+
+static int check_registration_failure(const char *dir, int expected_reason,
+                                      const char *expected_data)
+{
+    char *registration = ossl_provider_conf_find_fips_registration_path(dir);
+    int ok = TEST_ptr_null(registration)
+             && check_last_error(expected_reason, expected_data);
+
+    OPENSSL_free(registration);
+    ERR_clear_error();
+    return ok;
+}
+
+static int test_find_missing_registration(void)
+{
+    return check_registration_failure(empty_dir, ERR_R_INIT_FAIL,
+                                      "no FIPS provider registration");
+}
+
+static int test_find_nonexistent_directory(void)
+{
+    return check_registration_failure(nonexistent_dir, 0,
+                                      "reading FIPS provider registration directory");
+}
+
+static int test_find_multiple_registrations(void)
+{
+    return check_registration_failure(multiple_dir, ERR_R_INIT_FAIL,
+                                      "multiple FIPS provider registrations");
+}
+
+static int check_fips_state(OSSL_LIB_CTX *ctx)
+{
+    char *properties = evp_get_global_properties_str(ctx, 0);
+    int ok = TEST_true(OSSL_PROVIDER_available(ctx, "symcryptprovider"))
+             && TEST_true(OSSL_PROVIDER_available(ctx, "base"))
+             && TEST_ptr(properties)
+             && TEST_int_eq(count_property_token(
+                                properties,
+                                "?provider=symcryptprovider"),
+                            1)
+             && TEST_int_eq(count_property_token(properties, "?fips=yes"), 1);
+
+    OPENSSL_free(properties);
+    return ok;
+}
+
+static int check_activation(const char *registration, int expected)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int activated, ok = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+    activated = ossl_provider_conf_activate_fips(ctx, registration);
+    if (!TEST_int_eq(activated, expected))
+        goto end;
+    if (expected && !check_fips_state(ctx))
+        goto end;
+    ok = 1;
+
+ end:
+    ERR_clear_error();
+    OSSL_LIB_CTX_free(ctx);
+    return ok;
+}
+
+static int test_activate_valid_registration(void)
+{
+    return check_activation(valid_file, 1);
+}
+
+static int test_reject_inactive_registration(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int ok = 0;
+
+    if (!TEST_ptr(ctx)
+            || !TEST_false(
+                   ossl_provider_conf_activate_fips(ctx, inactive_file))
+            || !check_last_error(
+                   ERR_R_INIT_FAIL,
+                   "FIPS provider 'symcryptprovider' was not activated "
+                   "by its registration")
+            || !check_provider_initialized(ctx, "symcryptprovider", 0)
+            || !check_provider_initialized(ctx, "base", 0)
+            || !check_no_registration_properties(ctx))
+        goto end;
+    ok = 1;
+
+ end:
+    ERR_clear_error();
+    OSSL_LIB_CTX_free(ctx);
+    return ok;
+}
+
+static int test_reject_bad_properties(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    unsigned long error;
+    int ok = 0;
+
+    if (!TEST_ptr(ctx)
+            || !TEST_false(
+                   ossl_provider_conf_activate_fips(ctx, bad_properties_file)))
+        goto end;
+    error = ERR_peek_last_error();
+    if (!TEST_int_eq(ERR_GET_LIB(error), ERR_LIB_EVP)
+            || !TEST_int_eq(ERR_GET_REASON(error),
+                            EVP_R_DEFAULT_QUERY_PARSE_ERROR)
+            || !check_provider_initialized(ctx, "symcryptprovider", 1)
+            || !check_provider_initialized(ctx, "base", 1)
+            || !check_no_registration_properties(ctx))
+        goto end;
+    ok = 1;
+
+ end:
+    ERR_clear_error();
+    OSSL_LIB_CTX_free(ctx);
+    return ok;
+}
+
+static int test_reject_bad_identity(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int ok = 0;
+
+    if (!TEST_ptr(ctx)
+            || !TEST_false(
+                   ossl_provider_conf_activate_fips(ctx, bad_identity_file))
+            || !check_last_error(
+                   ERR_R_INIT_FAIL,
+                   "FIPS provider 'symcryptprovider' was not activated "
+                   "by its registration")
+            || !check_provider_initialized(ctx, "symcryptprovider", 0)
+            || !check_provider_initialized(ctx, "impostor", 1)
+            || !check_provider_initialized(ctx, "base", 0)
+            || !check_no_registration_properties(ctx))
+        goto end;
+    ok = 1;
+
+ end:
+    ERR_clear_error();
+    OSSL_LIB_CTX_free(ctx);
+    return ok;
+}
+
+static int test_reject_unavailable_soft_load(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int ok = 0;
+
+    if (!TEST_ptr(ctx)
+            || !TEST_false(
+                   ossl_provider_conf_activate_fips(ctx, soft_load_file))
+            || !check_last_error(
+                   ERR_R_INIT_FAIL,
+                   "FIPS provider 'symcryptprovider' was not activated "
+                   "by its registration")
+            || !check_provider_initialized(ctx, "symcryptprovider", 0)
+            || !check_provider_initialized(ctx, "base", 0)
+            || !check_no_registration_properties(ctx))
+        goto end;
+    ok = 1;
+
+ end:
+    ERR_clear_error();
+    OSSL_LIB_CTX_free(ctx);
+    return ok;
+}
+
+static int check_activation_error(const char *registration,
+                                  const char *expected_data)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int ok = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+    if (!TEST_false(ossl_provider_conf_activate_fips(ctx, registration))
+            || !check_last_error(ERR_R_INIT_FAIL, expected_data))
+        goto end;
+    ok = 1;
+
+ end:
+    ERR_clear_error();
+    OSSL_LIB_CTX_free(ctx);
+    return ok;
+}
+
+static int test_reject_missing_metadata(void)
+{
+    return check_activation_error(missing_metadata_file,
+                                  "missing section [azl_fips_provider]");
+}
+
+static int test_reject_missing_provider(void)
+{
+    return check_activation_error(missing_provider_file,
+                                  "required FIPS provider directive 'provider'");
+}
+
+static int test_reject_empty_provider(void)
+{
+    return check_activation_error(empty_provider_file,
+                                  "required FIPS provider directive 'provider'");
+}
+
+static int test_reject_missing_section(void)
+{
+    return check_activation_error(missing_section_file,
+                                  "required FIPS provider directive 'section'");
+}
+
+static int test_reject_empty_section(void)
+{
+    return check_activation_error(empty_section_file,
+                                  "required FIPS provider directive 'section'");
+}
+
+static int test_reject_missing_properties(void)
+{
+    return check_activation_error(
+        missing_properties_file,
+        "required FIPS provider directive 'additional_default_properties'");
+}
+
+static int test_reject_empty_properties(void)
+{
+    return check_activation_error(
+        empty_properties_file,
+        "required FIPS provider directive 'additional_default_properties'");
+}
+
+static int test_reject_duplicate_metadata(void)
+{
+    return check_activation_error(duplicate_metadata_file,
+                                  "duplicate FIPS provider directive 'provider'");
+}
+
+static int test_reject_dotted_provider(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int ok = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+    if (!TEST_false(
+            ossl_provider_conf_activate_fips(ctx, dotted_identity_file))
+            || !check_last_error(
+                   ERR_R_PASSED_INVALID_ARGUMENT,
+                   "FIPS provider name 'vendor.symcryptprovider' "
+                   "must not contain '.'")
+            || !check_provider_initialized(ctx, "vendor.symcryptprovider", 0)
+            || !check_provider_initialized(ctx, "base", 0)
+            || !check_no_registration_properties(ctx))
+        goto end;
+    ok = 1;
+
+ end:
+    ERR_clear_error();
+    OSSL_LIB_CTX_free(ctx);
+    return ok;
+}
+
+static int test_repeated_activation(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int ok = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+    if (!TEST_true(ossl_provider_conf_activate_fips(ctx, valid_file))
+            || !TEST_true(ossl_provider_conf_activate_fips(ctx, valid_file))
+            || !check_fips_state(ctx))
+        goto end;
+    ok = 1;
+
+ end:
+    ERR_clear_error();
+    OSSL_LIB_CTX_free(ctx);
+    return ok;
+}
+
+static int test_library_context_isolation(void)
+{
+    OSSL_LIB_CTX *ctx_a = OSSL_LIB_CTX_new();
+    OSSL_LIB_CTX *ctx_b = OSSL_LIB_CTX_new();
+    OSSL_PROVIDER *provider_a = NULL;
+    OSSL_PROVIDER *provider_b = NULL;
+    int ok = 0;
+
+    if (!TEST_ptr(ctx_a) || !TEST_ptr(ctx_b))
+        goto end;
+
+    if (!TEST_true(ossl_provider_conf_activate_fips(ctx_a, valid_file))
+            || !check_fips_state(ctx_a))
+        goto end;
+
+    if (!check_provider_initialized(ctx_b, "symcryptprovider", 0)
+            || !check_provider_initialized(ctx_b, "base", 0)
+            || !check_no_registration_properties(ctx_b))
+        goto end;
+
+    if (!TEST_true(ossl_provider_conf_activate_fips(ctx_b, valid_file))
+            || !check_fips_state(ctx_b)
+            || !check_fips_state(ctx_a))
+        goto end;
+
+    provider_a = ossl_provider_find(ctx_a, "symcryptprovider", 1);
+    provider_b = ossl_provider_find(ctx_b, "symcryptprovider", 1);
+    if (!TEST_ptr(provider_a)
+            || !TEST_ptr(provider_b)
+            || !TEST_ptr_ne(provider_a, provider_b))
+        goto end;
+
+    if (!TEST_true(ossl_provider_conf_activate_fips(ctx_a, valid_file))
+            || !check_fips_state(ctx_a)
+            || !check_fips_state(ctx_b))
+        goto end;
+    ok = 1;
+
+ end:
+    ossl_provider_free(provider_a);
+    ossl_provider_free(provider_b);
+    ERR_clear_error();
+    OSSL_LIB_CTX_free(ctx_a);
+    OSSL_LIB_CTX_free(ctx_b);
+    return ok;
+}
+
+OPT_TEST_DECLARE_USAGE("valid_dir valid_file hidden_dir hidden_file "
+                       "uppercase_dir uppercase_file empty_dir nonexistent_dir "
+                       "multiple_dir inactive_file bad_properties_file "
+                       "bad_identity_file soft_load_file missing_metadata_file "
+                       "missing_provider_file empty_provider_file "
+                       "missing_section_file empty_section_file "
+                       "missing_properties_file empty_properties_file "
+                       "duplicate_metadata_file dotted_identity_file\n")
+
+int setup_tests(void)
+{
+    if (!test_skip_common_options())
+        return 0;
+    if (!TEST_ptr(valid_dir = test_get_argument(0))
+            || !TEST_ptr(valid_file = test_get_argument(1))
+            || !TEST_ptr(hidden_dir = test_get_argument(2))
+            || !TEST_ptr(hidden_file = test_get_argument(3))
+            || !TEST_ptr(uppercase_dir = test_get_argument(4))
+            || !TEST_ptr(uppercase_file = test_get_argument(5))
+            || !TEST_ptr(empty_dir = test_get_argument(6))
+            || !TEST_ptr(nonexistent_dir = test_get_argument(7))
+            || !TEST_ptr(multiple_dir = test_get_argument(8))
+            || !TEST_ptr(inactive_file = test_get_argument(9))
+            || !TEST_ptr(bad_properties_file = test_get_argument(10))
+            || !TEST_ptr(bad_identity_file = test_get_argument(11))
+            || !TEST_ptr(soft_load_file = test_get_argument(12))
+            || !TEST_ptr(missing_metadata_file = test_get_argument(13))
+            || !TEST_ptr(missing_provider_file = test_get_argument(14))
+            || !TEST_ptr(empty_provider_file = test_get_argument(15))
+            || !TEST_ptr(missing_section_file = test_get_argument(16))
+            || !TEST_ptr(empty_section_file = test_get_argument(17))
+            || !TEST_ptr(missing_properties_file = test_get_argument(18))
+            || !TEST_ptr(empty_properties_file = test_get_argument(19))
+            || !TEST_ptr(duplicate_metadata_file = test_get_argument(20))
+            || !TEST_ptr(dotted_identity_file = test_get_argument(21)))
+        return 0;
+
+    ADD_TEST(test_find_valid_registration);
+    ADD_TEST(test_find_hidden_registration);
+    ADD_TEST(test_find_uppercase_registration);
+    ADD_TEST(test_find_missing_registration);
+    ADD_TEST(test_find_nonexistent_directory);
+    ADD_TEST(test_find_multiple_registrations);
+    ADD_TEST(test_activate_valid_registration);
+    ADD_TEST(test_reject_inactive_registration);
+    ADD_TEST(test_reject_bad_properties);
+    ADD_TEST(test_reject_bad_identity);
+    ADD_TEST(test_reject_unavailable_soft_load);
+    ADD_TEST(test_reject_missing_metadata);
+    ADD_TEST(test_reject_missing_provider);
+    ADD_TEST(test_reject_empty_provider);
+    ADD_TEST(test_reject_missing_section);
+    ADD_TEST(test_reject_empty_section);
+    ADD_TEST(test_reject_missing_properties);
+    ADD_TEST(test_reject_empty_properties);
+    ADD_TEST(test_reject_duplicate_metadata);
+    ADD_TEST(test_reject_dotted_provider);
+    ADD_TEST(test_repeated_activation);
+    ADD_TEST(test_library_context_isolation);
+    return 1;
+}
