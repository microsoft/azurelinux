+             srctop_file("test", "prov_conf_fips_valid", "symcrypt.cnf"),
+             srctop_dir("test", "prov_conf_fips_hidden"),
+             srctop_file("test", "prov_conf_fips_hidden", ".symcrypt.cnf"),
+             srctop_dir("test", "prov_conf_fips_uppercase"),
+             srctop_file("test", "prov_conf_fips_uppercase", "symcrypt.CNF"),
+             $empty,
+             $nonexistent,
+             srctop_dir("test", "prov_conf_fips_multiple"),
+             srctop_file("test", "prov_conf_fips_inactive", "symcrypt.cnf"),
+             srctop_file("test", "prov_conf_fips_bad_properties",
+                          "symcrypt.cnf"),
+             srctop_file("test", "prov_conf_fips_bad_identity",
+                          "symcrypt.cnf"),
+             srctop_file("test", "prov_conf_fips_soft_load",
+                          "symcrypt.cnf"),
+             srctop_file("test", "prov_conf_fips_metadata",
+                          "missing-section.cnf"),
+             srctop_file("test", "prov_conf_fips_metadata",
+                          "missing-provider.cnf"),
+             srctop_file("test", "prov_conf_fips_metadata",
+                          "empty-provider.cnf"),
+             srctop_file("test", "prov_conf_fips_metadata",
+                          "missing-config-section.cnf"),
+             srctop_file("test", "prov_conf_fips_metadata",
+                          "empty-config-section.cnf"),
+             srctop_file("test", "prov_conf_fips_metadata",
+                          "missing-properties.cnf"),
+             srctop_file("test", "prov_conf_fips_metadata",
+                          "empty-properties.cnf"),
+             srctop_file("test", "prov_conf_fips_metadata",
+                          "duplicate-provider.cnf"),
+             srctop_file("test", "prov_conf_fips_dotted_identity",
+                          "symcrypt.cnf")])),
+   "FIPS provider registration discovery and activation");
diff --git a/test/recipes/03-test_prov_conf_symcrypt.t b/test/recipes/03-test_prov_conf_symcrypt.t
new file mode 100644
index 0000000..f17daa6
--- /dev/null
+++ b/test/recipes/03-test_prov_conf_symcrypt.t
@@ -0,0 +1,39 @@
+#! /usr/bin/env perl
+# Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+#
+# Licensed under the Apache License 2.0 (the "License").  You may not use
+# this file except in compliance with the License.  You can obtain a copy
+# in the file LICENSE in the source distribution or at
+# https://www.openssl.org/source/license.html
+
+use strict;
+use warnings;
+use Cwd qw(abs_path);
+use OpenSSL::Test qw/:DEFAULT bldtop_dir srctop_file/;
+
+setup("test_prov_conf_symcrypt");
+
+delete $ENV{OPENSSL_FORCE_FIPS_MODE};
+
+my $host_fips = 0;
+if (open(my $fh, '<', '/proc/sys/crypto/fips_enabled')) {
+    my $val = <$fh>;
+    close($fh);
+    $host_fips = 1 if defined $val && $val =~ /^\s*1/;
+}
+
+plan skip_all =>
+    "host kernel is in FIPS mode; cannot isolate explicit registration"
+    if $host_fips;
+
+plan tests => 1;
+
+$ENV{OPENSSL_MODULES} = abs_path(bldtop_dir("test"));
+
+ok(run(test(["prov_conf_symcrypt_test",
+             srctop_file("test", "prov_conf_symcrypt_active.cnf"),
+             srctop_file("test", "prov_conf_symcrypt_missing.cnf"),
+             srctop_file("test", "prov_conf_symcrypt_app.cnf"),
+             srctop_file("test", "prov_conf_fips_valid", "symcrypt.cnf"),
+             "1"])),
+   "explicit FIPS registration activates and prefers its provider");
