diff --git a/test/prov_conf_symcrypt_test.c b/test/prov_conf_symcrypt_test.c
new file mode 100644
index 0000000..1bfcb4f
--- /dev/null
+++ b/test/prov_conf_symcrypt_test.c
@@ -0,0 +1,208 @@
+/*
+ * Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+ *
+ * Licensed under the Apache License 2.0 (the "License").  You may not use
+ * this file except in compliance with the License.  You can obtain a copy
+ * in the file LICENSE in the source distribution or at
+ * https://www.openssl.org/source/license.html
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <openssl/conf.h>
+#include <openssl/err.h>
+#include <openssl/evp.h>
+#include <openssl/provider.h>
+#include "crypto/evp.h"
+#include "internal/provider.h"
+#include "testutil.h"
+
+/*
+ * These tests exercise registration activation independently from the fixed
+ * production directory, parametrized by whether the registration is applied:
+ *
+ *   - Registration loads the provider even when the ambient configuration
+ *     does not mention it.
+ *   - The registration properties merge with application defaults.
+ *   - Outside kernel FIPS mode, the ordinary SymCrypt configuration activates
+ *     SymCrypt without changing default properties.
+ *   - Later unrelated provider configuration loads remain safe.
+ */
+
+static char *symcrypt_cnf = NULL;
+static char *unrelated_cnf = NULL;
+static char *app_cnf = NULL;
+static char *registration_cnf = NULL;
+static int apply_fips_registration = 0;
+
+static int has_property_token(const char *properties, const char *token)
+{
+    const char *start = properties;
+    size_t token_len = strlen(token);
+
+    while (start != NULL) {
+        const char *end = strchr(start, ',');
+        size_t len = end == NULL ? strlen(start) : (size_t)(end - start);
+
+        if (len == token_len && strncmp(start, token, len) == 0)
+            return 1;
+        start = end == NULL ? NULL : end + 1;
+    }
+    return 0;
+}
+
+/*
+ * Verify the default properties: the app-configured token is preserved, the
+ * SymCrypt and FIPS preferences are merged iff the registration is applied.
+ */
+static int check_properties(OSSL_LIB_CTX *ctx, int expect_app,
+                            int expect_symcrypt, int expect_fips)
+{
+    char *propstr = evp_get_global_properties_str(ctx, 0);
+    int testresult = 0;
+
+    if (!TEST_ptr(propstr))
+        return 0;
+    TEST_info("default properties: %s", propstr);
+
+    if (!TEST_int_eq(has_property_token(propstr, "app.prop=1"), expect_app))
+        goto err;
+    if (!TEST_int_eq(has_property_token(propstr,
+                                        "?provider=symcryptprovider"),
+                     expect_symcrypt))
+        goto err;
+    if (!TEST_int_eq(has_property_token(propstr, "?fips=yes"), expect_fips))
+        goto err;
+
+    testresult = 1;
+ err:
+    OPENSSL_free(propstr);
+    return testresult;
+}
+
+/*
+ * An ambient config that activates SymCrypt: the provider is available, the
+ * SymCrypt (and, with registration, FIPS + base) preferences are applied.
+ */
+static int test_standard_configuration(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int testresult = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+    if (apply_fips_registration
+            && !TEST_true(ossl_provider_conf_activate_fips(ctx,
+                                                           registration_cnf)))
+        goto err;
+    if (!TEST_true(OSSL_LIB_CTX_load_config(ctx, symcrypt_cnf)))
+        goto err;
+    if (!TEST_true(OSSL_PROVIDER_available(ctx, "symcryptprovider")))
+        goto err;
+    if (apply_fips_registration
+            && !TEST_true(OSSL_PROVIDER_available(ctx, "base")))
+        goto err;
+    if (!check_properties(ctx, 0, apply_fips_registration,
+                          apply_fips_registration))
+        goto err;
+
+    testresult = 1;
+ err:
+    OSSL_LIB_CTX_free(ctx);
+    return testresult;
+}
+
+/*
+ * Registration loading does not depend on the ambient configuration including
+ * the ordinary SymCrypt drop-in.
+ */
+static int test_registration_without_ambient_provider(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int testresult = 0;
+
+    if (!TEST_ptr(ctx))
+        return 0;
+    if (!TEST_true(OSSL_LIB_CTX_load_config(ctx, app_cnf)))
+        goto err;
+    if (apply_fips_registration
+            && !TEST_true(ossl_provider_conf_activate_fips(ctx,
+                                                           registration_cnf)))
+        goto err;
+    if (!TEST_true(OSSL_LIB_CTX_load_config(ctx, unrelated_cnf)))
+        goto err;
+    if (apply_fips_registration) {
+        if (!TEST_true(OSSL_PROVIDER_available(ctx, "symcryptprovider")))
+            goto err;
+        if (!TEST_true(OSSL_PROVIDER_available(ctx, "base")))
+            goto err;
+        if (!check_properties(ctx, 1, 1, 1))
+            goto err;
+    } else {
+        if (!TEST_false(OSSL_PROVIDER_available(ctx, "symcryptprovider")))
+            goto err;
+        if (!check_properties(ctx, 1, 0, 0))
+            goto err;
+    }
+
+    testresult = 1;
+ err:
+    OSSL_LIB_CTX_free(ctx);
+    return testresult;
+}
+
+/*
+ * Once registration has succeeded, a later unrelated provider configuration
+ * load does not disturb the activated provider or its properties.
+ */
+static int test_unrelated_load_is_safe(void)
+{
+    OSSL_LIB_CTX *ctx = OSSL_LIB_CTX_new();
+    int testresult = 0;
+
+    if (!TEST_ptr(ctx))
+        goto err;
+    if (apply_fips_registration
+            && !TEST_true(ossl_provider_conf_activate_fips(ctx,
+                                                           registration_cnf)))
+        goto err;
+    if (!TEST_true(OSSL_LIB_CTX_load_config(ctx, symcrypt_cnf)))
+        goto err;
+    if (!TEST_true(OSSL_LIB_CTX_load_config(ctx, unrelated_cnf)))
+        goto err;
+    if (!TEST_true(OSSL_PROVIDER_available(ctx, "symcryptprovider")))
+        goto err;
+    if (!check_properties(ctx, 0, apply_fips_registration,
+                          apply_fips_registration))
+        goto err;
+
+    testresult = 1;
+ err:
+    OSSL_LIB_CTX_free(ctx);
+    return testresult;
+}
+
+OPT_TEST_DECLARE_USAGE("symcrypt_cnf unrelated_cnf app_cnf registration_cnf "
+                       "apply_fips_registration\n")
+
+int setup_tests(void)
+{
+    if (!test_skip_common_options()) {
+        TEST_error("Error parsing test options\n");
+        return 0;
+    }
+
+    if (!TEST_ptr(symcrypt_cnf = test_get_argument(0))
+            || !TEST_ptr(unrelated_cnf = test_get_argument(1))
+            || !TEST_ptr(app_cnf = test_get_argument(2))
+            || !TEST_ptr(registration_cnf = test_get_argument(3))
+            || !TEST_ptr(test_get_argument(4)))
+        return 0;
+
+    apply_fips_registration = atoi(test_get_argument(4)) != 0;
+
+    ADD_TEST(test_standard_configuration);
+    ADD_TEST(test_registration_without_ambient_provider);
+    ADD_TEST(test_unrelated_load_is_safe);
+    return 1;
+}
diff --git a/test/recipes/03-test_prov_conf_fips_realinit.t b/test/recipes/03-test_prov_conf_fips_realinit.t
new file mode 100644
index 0000000..04e54ce
--- /dev/null
+++ b/test/recipes/03-test_prov_conf_fips_realinit.t
@@ -0,0 +1,36 @@
+#! /usr/bin/env perl
+# Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+#
+# Licensed under the Apache License 2.0 (the "License").  You may not use
+# this file except in compliance with the License.  You can obtain a copy
+# in the file LICENSE in the source distribution or at
+# https://www.openssl.org/source/license.html
+
+use strict;
+use warnings;
+use Cwd qw(abs_path);
+use OpenSSL::Test qw/:DEFAULT bldtop_dir srctop_file/;
+
+setup("test_prov_conf_fips_realinit");
+
+my $registration_dir = "/etc/pki/tls/azl-openssl-fips-provider.d";
+my $has_registration = 0;
+
+if (opendir(my $dh, $registration_dir)) {
+    $has_registration = grep { /\.cnf\z/i } readdir($dh);
+    closedir($dh);
+}
+
+plan skip_all =>
+    "host has a production FIPS provider registration"
+    if $has_registration;
+
+plan tests => 1;
+
+$ENV{OPENSSL_FORCE_FIPS_MODE} = 1;
+$ENV{OPENSSL_CONF} =
+    abs_path(srctop_file("test", "prov_conf_fips_realinit.cnf"));
+$ENV{OPENSSL_MODULES} = abs_path(bldtop_dir("test"));
+
+ok(run(test(["prov_conf_fips_realinit_test"])),
+   "failed kernel-FIPS initialization cannot activate fallbacks");
