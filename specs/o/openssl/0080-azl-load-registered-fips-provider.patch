 #include "crypto/context.h"
 
@@ -400,10 +402,196 @@ static int provider_conf_load(OSSL_LIB_CTX *libctx, const char *name,
     return ok >= 0;
 }
 
+# define AZL_FIPS_PROVIDER_CONF_DIR \
+    OPENSSLDIR "/azl-openssl-fips-provider.d"
+# define AZL_FIPS_PROVIDER_SECTION "azl_fips_provider"
+# define AZL_FIPS_PROVIDER_NAME "provider"
+# define AZL_FIPS_PROVIDER_CONFIG_SECTION "section"
+# define AZL_FIPS_PROVIDER_PROPERTIES "additional_default_properties"
+
+static int section_get0_required_unique_value(
+    const STACK_OF(CONF_VALUE) *section, const char *key, const char **result)
+{
+    int i;
+
+    *result = NULL;
+    for (i = 0; i < sk_CONF_VALUE_num(section); i++) {
+        const CONF_VALUE *value = sk_CONF_VALUE_value(section, i);
+
+        if (value->name != NULL && strcmp(skip_dot(value->name), key) == 0) {
+            if (*result != NULL) {
+                ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                               "duplicate FIPS provider directive '%s'", key);
+                return 0;
+            }
+            *result = value->value;
+        }
+    }
+
+    if (*result == NULL || **result == '\0') {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "missing or empty required FIPS provider directive '%s'",
+                       key);
+        return 0;
+    }
+    return 1;
+}
+
+char *ossl_provider_conf_find_fips_registration_path(const char *dir)
+{
+    const char *name;
+    char *registration = NULL;
+    OPENSSL_DIR_CTX *dirctx = NULL;
+
+    while ((name = OPENSSL_DIR_read(&dirctx, dir)) != NULL) {
+        char *path;
+        size_t path_len;
+
+        /*
+         * Count every case-insensitive .cnf name, including hidden files.
+         * Package-manager and editor backups do not have this suffix.
+         */
+        if (!HAS_CASE_SUFFIX(name, ".cnf"))
+            continue;
+
+        /* More than one candidate makes provider selection ambiguous. */
+        if (registration != NULL) {
+            ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                           "multiple FIPS provider registrations in %s",
+                           dir);
+            goto err;
+        }
+
+        path_len = strlen(dir) + strlen(name) + 2;
+        path = OPENSSL_malloc(path_len);
+        if (path == NULL)
+            goto err;
+        OPENSSL_strlcpy(path, dir, path_len);
+        OPENSSL_strlcat(path, "/", path_len);
+        OPENSSL_strlcat(path, name, path_len);
+        registration = path;
+    }
+
+    /* NULL with nonzero errno distinguishes a read error from normal EOF. */
+    if (errno != 0) {
+        ERR_raise_data(ERR_LIB_SYS, errno,
+                       "reading FIPS provider registration directory %s",
+                       dir);
+        goto err;
+    }
+
+    if (dirctx != NULL) {
+        int close_ok = OPENSSL_DIR_end(&dirctx);
+
+        dirctx = NULL;
+        if (!close_ok) {
+            ERR_raise_data(ERR_LIB_SYS, errno,
+                           "closing FIPS provider registration directory %s",
+                           dir);
+            goto err;
+        }
+    }
+    /* Success requires exactly one candidate; the caller owns its path. */
+    if (registration == NULL) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "no FIPS provider registration in %s", dir);
+        goto err;
+    }
+    return registration;
+
+ err:
+    if (dirctx != NULL)
+        OPENSSL_DIR_end(&dirctx);
+    OPENSSL_free(registration);
+    return NULL;
+}
+
+int ossl_provider_conf_activate_fips(OSSL_LIB_CTX *libctx,
+                                     const char *registration_path)
+{
+    PROVIDER_CONF_GLOBAL *pcgbl
+        = ossl_lib_ctx_get_data(libctx, OSSL_LIB_CTX_PROVIDER_CONF_INDEX);
+    STACK_OF(CONF_VALUE) *metadata;
+    CONF *registration_conf = NULL;
+    const char *provider, *section, *properties;
+    int active, ok = 0;
+
+    if (pcgbl == NULL) {
+        ERR_raise(ERR_LIB_CRYPTO, ERR_R_INTERNAL_ERROR);
+        return 0;
+    }
+
+    registration_conf = NCONF_new_ex(libctx, NCONF_default());
+    if (registration_conf == NULL
+            || NCONF_load(registration_conf, registration_path, NULL) <= 0)
+        goto end;
+
+    metadata = NCONF_get_section(registration_conf,
+                                 AZL_FIPS_PROVIDER_SECTION);
+    if (metadata == NULL) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "FIPS provider registration %s is missing section [%s]",
+                       registration_path, AZL_FIPS_PROVIDER_SECTION);
+        goto end;
+    }
+    if (!section_get0_required_unique_value(metadata, AZL_FIPS_PROVIDER_NAME,
+                                            &provider)
+            || !section_get0_required_unique_value(
+                   metadata, AZL_FIPS_PROVIDER_CONFIG_SECTION, &section)
+            || !section_get0_required_unique_value(
+                   metadata, AZL_FIPS_PROVIDER_PROPERTIES, &properties))
+        goto end;
+    if (strchr(provider, '.') != NULL) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_PASSED_INVALID_ARGUMENT,
+                       "FIPS provider name '%s' must not contain '.'",
+                       provider);
+        goto end;
+    }
+    if (provider_conf_load(libctx, provider, section, registration_conf) != 1)
+        goto end;
+    if (!CRYPTO_THREAD_read_lock(pcgbl->lock)) {
+        ERR_raise(ERR_LIB_CRYPTO, ERR_R_UNABLE_TO_GET_READ_LOCK);
+        goto end;
+    }
+    active = prov_already_activated(provider, pcgbl->activated_providers);
+    CRYPTO_THREAD_unlock(pcgbl->lock);
+    if (!active) {
+        ERR_raise_data(ERR_LIB_CRYPTO, ERR_R_INIT_FAIL,
+                       "FIPS provider '%s' was not activated by its registration",
+                       provider);
+        goto end;
+    }
+
+    if (provider_conf_activate(libctx, "base", NULL, NULL, 0, NULL) != 1)
+        goto end;
+    if (evp_default_properties_merge(libctx, properties, 0) != 1)
+        goto end;
+    ok = 1;
+
+ end:
+    NCONF_free(registration_conf);
+    return ok;
+}
+
+static int activate_azl_fips_provider(OSSL_LIB_CTX *libctx)
+{
+    char *registration_path
+        = ossl_provider_conf_find_fips_registration_path(
+              AZL_FIPS_PROVIDER_CONF_DIR);
+    int ok = 0;
+
+    if (registration_path != NULL)
+        ok = ossl_provider_conf_activate_fips(libctx, registration_path);
+    OPENSSL_free(registration_path);
+    return ok;
+}
+
 static int provider_conf_init(CONF_IMODULE *md, const CONF *cnf)
 {
     STACK_OF(CONF_VALUE) *elist;
     CONF_VALUE *cval;
+    OSSL_LIB_CTX *libctx = NCONF_get0_libctx((CONF *)cnf);
+    int in_kernel_fips = ossl_get_kernel_fips_flag() != 0;
     int i;
 
     OSSL_TRACE1(CONF, "Loading providers module: section %s\n",
@@ -417,34 +605,20 @@ static int provider_conf_init(CONF_IMODULE *md, const CONF *cnf)
         return 0;
     }
 
-    for (i = 0; i < sk_CONF_VALUE_num(elist); i++) {
-        cval = sk_CONF_VALUE_value(elist, i);
-        if (!provider_conf_load(NCONF_get0_libctx((CONF *)cnf),
-                                cval->name, cval->value, cnf))
-            return 0;
+    /*
+     * Load the registered FIPS provider before ambient providers so an
+     * ambient same-name alias cannot satisfy the activation check.
+     */
+    if (in_kernel_fips
+            && (!ossl_provider_disable_fallback_loading(libctx)
+                || !activate_azl_fips_provider(libctx))) {
+        OSSL_LIB_CTX_set_conf_diagnostics(libctx, 1);
+        return 0;
     }
 
-    if (ossl_get_kernel_fips_flag() != 0) { /* XXX from provider_conf_load */
-        OSSL_LIB_CTX *libctx = NCONF_get0_libctx((CONF *)cnf);
-#  define FIPS_LOCAL_CONF           OPENSSLDIR "/fips_local.cnf"
-
-        if (access(FIPS_LOCAL_CONF, R_OK) == 0) {
-            CONF *fips_conf = NCONF_new_ex(libctx, NCONF_default());
-            if (NCONF_load(fips_conf, FIPS_LOCAL_CONF, NULL) <= 0)
-                return 0;
-
-            if (provider_conf_load(libctx, "fips", "fips_sect", fips_conf) != 1) {
-                NCONF_free(fips_conf);
-                return 0;
-            }
-            NCONF_free(fips_conf);
-        } else {
-            if (provider_conf_activate(libctx, "fips", NULL, NULL, 0, NULL) != 1)
-                return 0;
-        }
-        if (provider_conf_activate(libctx, "base", NULL, NULL, 0, NULL) != 1)
-            return 0;
-        if (EVP_default_properties_enable_fips(libctx, 1) != 1)
+    for (i = 0; i < sk_CONF_VALUE_num(elist); i++) {
+        cval = sk_CONF_VALUE_value(elist, i);
+        if (!provider_conf_load(libctx, cval->name, cval->value, cnf))
             return 0;
     }
 
