+
+use strict;
+use warnings;
+use Cwd qw(abs_path);
+use OpenSSL::Test qw/:DEFAULT bldtop_dir result_dir srctop_dir srctop_file/;
+
+setup("test_prov_conf_fips_registration");
+
+plan tests => 1;
+
+delete $ENV{OPENSSL_FORCE_FIPS_MODE};
+$ENV{OPENSSL_MODULES} = abs_path(bldtop_dir("test"));
+
+my $empty = result_dir("prov_conf_fips_empty");
