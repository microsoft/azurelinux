From b1a8a98d0f37a2837d018af676e502f57156cc68 Mon Sep 17 00:00:00 2001
From: Kalev Lember <klember@redhat.com>
Date: Tue, 8 Nov 2022 17:02:19 +0100
Subject: [PATCH 1/2] Fedora: Drop dependencies required for benchmarking

Drop criterion that is only required for benchmarking, which we don't do
during package builds.

[Fix: updated for librsvg 2.59.1]
Signed-off-by: Kleis Auke Wolthuizen <fedora@kleisauke.nl>
---
 Cargo.toml      | 1 -
 rsvg/Cargo.toml | 1 -
 2 files changed, 2 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 0cf66ff..b18ba69 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -43,7 +43,6 @@ cast = "0.3.0"
 chrono = { version = "0.4.23", default-features = false }
 clap = "4.0.17"
 clap_complete = "4.0.5"
-criterion = "0.7"
 cssparser = "0.35.0"
 cssparser-color = "0.3.0"
 data-url = "0.3.0"
diff --git a/rsvg/Cargo.toml b/rsvg/Cargo.toml
index 708cb85..dac11fb 100644
--- a/rsvg/Cargo.toml
+++ b/rsvg/Cargo.toml
@@ -83,7 +83,6 @@ yeslogic-fontconfig-sys = { workspace = true, optional = true }

 [dev-dependencies]
 chrono = { workspace = true, features = ["clock", "std"] }
-criterion.workspace = true
 lopdf.workspace = true
 matches.workspace = true
 png.workspace = true
-- 
2.52.0

