+static void
+rpc_rdma_process_transport_expires(RDMAXPRT *rdma_xprt, int expire_ms, int *timeout_ms)
+{
+	struct clnt_req *cc;
+	struct opr_rbtree_node *n_node;
+	struct rpc_dplx_rec *rec;
