+	if (ret) {
+		__warnx(TIRPC_DEBUG_FLAG_ERROR, "%s post_recv failed rdma_xprt %p "
+			"cbc %p error %d", __func__, rdma_xprt, cbc, ret);
+
+		cbc->cbc_flags = CBC_FLAG_RELEASE;
+
+		/* Release sentinel ref */
