From cbf0790457521c5d442bdd4817af7fca78b32d3b Mon Sep 17 00:00:00 2001
From: Thien Trung Vuong <tvuong@microsoft.com>
Date: Thu, 29 Oct 2026 13:34:17 -0700
Subject: [PATCH] libsolv: preserve rpm-md file publication time for snapshot
 consumers

Keep the rpm-md <time file="..."> attribute as SOLVABLE_FILETIME rather than losing it during primary.xml import. It is distinct from the existing package build time, and absent attributes must remain absent so consumers can treat file time as optional.

Use the same nonzero strtoull pattern as the neighboring build-time parser. Add an rpm-md CTest that checks both timestamps and a package with no file time. This builds on the original downstream file-time patch by Matt Bearup; it does not change LIBSOLV_TOOLVERSION or the upstream version.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 ext/repo_rpmmd.c           |   3 ++
 src/knownid.h              |   1 +
 test/CMakeLists.txt        |  10 +++-
 test/test_rpmmd_filetime.c | 107 +++++++++++++++++++++++++++++++++++++
 4 files changed, 120 insertions(+), 1 deletion(-)
 create mode 100644 test/test_rpmmd_filetime.c

diff --git a/ext/repo_rpmmd.c b/ext/repo_rpmmd.c
index e749879..6b3ddce 100644
--- a/ext/repo_rpmmd.c
+++ b/ext/repo_rpmmd.c
@@ -849,6 +849,9 @@ startElement(struct solv_xmlparser *xmlp, int state, const char *name, const cha
         str = solv_xmlparser_find_attr("build", atts);
         if (str && (ti = strtoull(str, 0, 10)) != 0)
           repodata_set_num(pd->data, handle, SOLVABLE_BUILDTIME, ti);
+        str = solv_xmlparser_find_attr("file", atts);
+        if (str && (ti = strtoull(str, 0, 10)) != 0)
+          repodata_set_num(pd->data, handle, SOLVABLE_FILETIME, ti);
 	break;
       }
     case STATE_SIZE:
diff --git a/src/knownid.h b/src/knownid.h
index 3d558af..abad692 100644
--- a/src/knownid.h
+++ b/src/knownid.h
@@ -274,6 +274,7 @@ KNOWNID(UPDATE_COLLECTIONLIST,		"update:collectionlist"),	/* list of UPDATE_COLL
 KNOWNID(SOLVABLE_MULTIARCH,		"solvable:multiarch"),		/* debian multi-arch field */
 KNOWNID(SOLVABLE_SIGNATUREDATA,		"solvable:signaturedata"),	/* conda */
 KNOWNID(SOLVABLE_ORDERWITHREQUIRES,	"solvable:orderwithrequires"),	/* rpm */
+KNOWNID(SOLVABLE_FILETIME,		"solvable:filetime"),		/* file publish time from rpm-md <time file="..."> */
 
 KNOWNID(ID_NUM_INTERNAL,		0)
 
diff --git a/test/CMakeLists.txt b/test/CMakeLists.txt
index 8a5cd8a..9fda423 100644
--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -18,4 +18,12 @@ FOREACH(tcdir testcases libsolv-zypptestcases)
             ENDIF ()
         ENDFOREACH ()
     ENDIF ()
-ENDFOREACH ()
\ No newline at end of file
+ENDFOREACH ()
+
+# Standalone regression test: verify the rpm-md <time file="..."/> attribute
+# is retained as solvable:filetime. repo_add_rpmmd is only built with RPMMD.
+IF (ENABLE_RPMMD)
+    ADD_EXECUTABLE (test_rpmmd_filetime test_rpmmd_filetime.c)
+    TARGET_LINK_LIBRARIES (test_rpmmd_filetime libsolvext libsolv ${SYSTEM_LIBRARIES})
+    ADD_TEST (rpmmd_filetime ${CMAKE_CURRENT_BINARY_DIR}/test_rpmmd_filetime)
+ENDIF (ENABLE_RPMMD)
diff --git a/test/test_rpmmd_filetime.c b/test/test_rpmmd_filetime.c
new file mode 100644
index 0000000..103c521
--- /dev/null
+++ b/test/test_rpmmd_filetime.c
@@ -0,0 +1,107 @@
+#include <stdio.h>
+#include <string.h>
+
+#include "pool.h"
+#include "repo.h"
+#include "repo_rpmmd.h"
+#include "solv_xfopen.h"
+#include "knownid.h"
+
+static const char primary_xml[] =
+"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+"<metadata xmlns=\"http://linux.duke.edu/metadata/common\""
+" xmlns:rpm=\"http://linux.duke.edu/metadata/rpm\" packages=\"2\">\n"
+"  <package type=\"rpm\">\n"
+"    <name>published</name>\n"
+"    <arch>x86_64</arch>\n"
+"    <version epoch=\"0\" ver=\"1.0\" rel=\"1\"/>\n"
+"    <time file=\"1740000000\" build=\"1730000000\"/>\n"
+"  </package>\n"
+"  <package type=\"rpm\">\n"
+"    <name>without-filetime</name>\n"
+"    <arch>x86_64</arch>\n"
+"    <version epoch=\"0\" ver=\"1.0\" rel=\"1\"/>\n"
+"    <time build=\"1730000000\"/>\n"
+"  </package>\n"
+"</metadata>\n";
+
+int
+main(int argc, char **argv)
+{
+  Pool *pool;
+  Repo *repo;
+  FILE *fp;
+  Id p;
+  Solvable *s;
+  int nsolv = 0, found_published = 0, found_missing = 0;
+
+  (void)argc;
+  (void)argv;
+
+  pool = pool_create();
+  repo = repo_create(pool, "test");
+
+  fp = solv_fmemopen(primary_xml, sizeof(primary_xml) - 1, "r");
+  if (!fp)
+    {
+      fprintf(stderr, "FAIL: solv_fmemopen failed\n");
+      pool_free(pool);
+      return 1;
+    }
+  if (repo_add_rpmmd(repo, fp, 0, 0) != 0)
+    {
+      fprintf(stderr, "FAIL: repo_add_rpmmd: %s\n", pool_errstr(pool));
+      fclose(fp);
+      pool_free(pool);
+      return 1;
+    }
+  fclose(fp);
+
+  FOR_REPO_SOLVABLES(repo, p, s)
+    {
+      nsolv++;
+      if (solvable_lookup_num(s, SOLVABLE_BUILDTIME, 0) != 1730000000ULL)
+        {
+          fprintf(stderr, "FAIL: build time was not retained\n");
+          pool_free(pool);
+          return 1;
+        }
+      if (!strcmp(pool_id2str(pool, s->name), "published"))
+        {
+          found_published = 1;
+          if (solvable_lookup_num(s, SOLVABLE_FILETIME, 0) != 1740000000ULL ||
+              !solvable_lookup_type(s, SOLVABLE_FILETIME))
+            {
+              fprintf(stderr, "FAIL: file publication time was not retained\n");
+              pool_free(pool);
+              return 1;
+            }
+        }
+      else if (!strcmp(pool_id2str(pool, s->name), "without-filetime"))
+        {
+          found_missing = 1;
+          if (solvable_lookup_type(s, SOLVABLE_FILETIME))
+            {
+              fprintf(stderr, "FAIL: missing file time unexpectedly present\n");
+              pool_free(pool);
+              return 1;
+            }
+        }
+      else
+        {
+          fprintf(stderr, "FAIL: unexpected package\n");
+          pool_free(pool);
+          return 1;
+        }
+    }
+  if (nsolv != 2 || !found_published || !found_missing)
+    {
+      fprintf(stderr, "FAIL: expected both rpm-md packages\n");
+      pool_free(pool);
+      return 1;
+    }
+
+  puts("PASS: publication time retained independently of build time");
+  pool_free(pool);
+  return 0;
+}
