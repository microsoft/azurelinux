diff -up firefox-149.0/toolkit/components/terminator/nsTerminator.cpp.pgo firefox-149.0/toolkit/components/terminator/nsTerminator.cpp
--- firefox-149.0/toolkit/components/terminator/nsTerminator.cpp.pgo	2026-03-18 19:54:05.000000000 +0100
+++ firefox-149.0/toolkit/components/terminator/nsTerminator.cpp	2026-03-19 16:01:55.737755729 +0100
@@ -338,6 +338,11 @@ void nsTerminator::StartWatchdog() {
   }
 #endif
 
+  // Disable watchdog for PGO train builds - writting profile information at
+  // exit may take time and it is better to make build hang rather than
+  // silently produce poorly performing binary.
+  crashAfterMS = INT32_MAX;
+
   UniquePtr<Options> options(new Options());
   // Guarantee that crashAfterTicks is non-zero
   options->crashAfterTicks = std::max(1, crashAfterMS / HEARTBEAT_INTERVAL_MS);
