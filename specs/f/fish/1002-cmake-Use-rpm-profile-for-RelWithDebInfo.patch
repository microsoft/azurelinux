From a637acaa9e5f33129de47929be3f9654b5d40736 Mon Sep 17 00:00:00 2001
From: Neal Gompa <ngompa@fedoraproject.org>
Date: Sat, 28 Mar 2026 07:14:02 -0400
Subject: [PATCH 1002/1003] cmake: Use rpm profile for RelWithDebInfo

This matches what we expect for packaging Rust software.
---
 CMakeLists.txt   | 2 +-
 cmake/Rust.cmake | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c40c82d31..88d90ca87 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -64,7 +64,7 @@ add_custom_target(
                 ${Rust_CARGO}
                     build --bin fish
                     $<$<CONFIG:Release>:--release>
-                    $<$<CONFIG:RelWithDebInfo>:--profile=release-with-debug>
+                    $<$<CONFIG:RelWithDebInfo>:--profile=rpm>
                     --target ${Rust_CARGO_TARGET}
                     --no-default-features
                     --features=${FISH_CARGO_FEATURES}
diff --git a/cmake/Rust.cmake b/cmake/Rust.cmake
index 0be10db9c..59f583514 100644
--- a/cmake/Rust.cmake
+++ b/cmake/Rust.cmake
@@ -18,7 +18,7 @@ else()
     set(rust_target_dir "${FISH_RUST_BUILD_DIR}/${Rust_CARGO_HOST_TARGET}")
 endif()
 
-set(rust_profile $<IF:$<CONFIG:Debug>,debug,$<IF:$<CONFIG:RelWithDebInfo>,release-with-debug,release>>)
+set(rust_profile $<IF:$<CONFIG:Debug>,debug,$<IF:$<CONFIG:RelWithDebInfo>,rpm,release>>)
 
 if (NOT DEFINED WITH_MESSAGE_LOCALIZATION) # Don't check for legacy options if the new one is defined, to help bisecting.
     if(DEFINED WITH_GETTEXT)
-- 
2.53.0

