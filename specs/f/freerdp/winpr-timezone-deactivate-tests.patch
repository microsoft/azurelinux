From 09fb47ae8298ef89a82737be85586b7b68eae6ae Mon Sep 17 00:00:00 2001
From: Armin Novak <armin.novak@thincast.com>
Date: Tue, 10 Nov 2026 18:45:56 +0100
Subject: [PATCH] [winpr,timezone] deactivate tests

When -DWITH_TIMEZONE_COMPILED=OFF deactivate timezone tests.
These will fail if there is no package installed (e.g. package builder
tests et al)
---
 winpr/libwinpr/timezone/test/CMakeLists.txt | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/winpr/libwinpr/timezone/test/CMakeLists.txt b/winpr/libwinpr/timezone/test/CMakeLists.txt
index a666d9e851e6..dd1f9c638405 100644
--- a/winpr/libwinpr/timezone/test/CMakeLists.txt
+++ b/winpr/libwinpr/timezone/test/CMakeLists.txt
@@ -5,9 +5,13 @@ disable_warnings_for_directory(${CMAKE_CURRENT_BINARY_DIR})
 
 set(${MODULE_PREFIX}_DRIVER ${MODULE_NAME}.c)
 
-set(${MODULE_PREFIX}_TESTS TestTimeZoneBrowser.c TestTimeZoneIanaAlias.c TestTimeZoneNestedName.c)
+set(TESTS TestTimeZoneBrowser.c)
 
-create_test_sourcelist(${MODULE_PREFIX}_SRCS ${${MODULE_PREFIX}_DRIVER} ${${MODULE_PREFIX}_TESTS})
+if(WITH_TIMEZONE_COMPILED)
+  list(APPEND TESTS TestTimeZoneIanaAlias.c TestTimeZoneNestedName.c)
+endif()
+
+create_test_sourcelist(${MODULE_PREFIX}_SRCS ${${MODULE_PREFIX}_DRIVER} ${TESTS})
 
 add_executable(${MODULE_NAME} ${${MODULE_PREFIX}_SRCS})
 
@@ -21,7 +25,7 @@ endif()
 
 set_target_properties(${MODULE_NAME} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${TESTING_OUTPUT_DIRECTORY}")
 
-foreach(test ${${MODULE_PREFIX}_TESTS})
+foreach(test ${TESTS})
   get_filename_component(TestName ${test} NAME_WE)
   add_test(NAME ${TestName} COMMAND ${MODULE_NAME} ${TestName})
 endforeach()
