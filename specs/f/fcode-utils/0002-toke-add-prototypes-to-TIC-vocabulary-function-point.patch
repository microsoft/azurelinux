From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Peter Lemenkov <lemenkov@gmail.com>
Date: Wed, 6 May 2026 16:33:30 +0200
Subject: [PATCH] toke: add prototypes to TIC vocabulary function pointers for
 GCC 15

GCC 15 enforces strict prototypes; the K&R-style empty `()` parameter
lists in the tic_*_hdr_t function pointer fields and a few related
function declarations no longer compile. Type the funct/ign_func slots
with their actual parameter unions (tic_param_t for active processing,
tic_bool_param_t for "ignoring" callbacks), update the matching
function signatures in conditl.c, macros.c, and scanner.c, and cast
ifunc in DUFNC_FWT_PARM / DUALFUNC_FWT_TIC so dual-purpose functions
(process_remark, FWORD_EXEC_FUNC) can still land in the bool-typed
ign_func slot. push_source's res_func is similarly typed as
void(*)(_PTR), with a cast at the macros.c call site.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>

diff --git a/toke/conditl.c b/toke/conditl.c
index 842a8f6..3705bc3 100644
--- a/toke/conditl.c
+++ b/toke/conditl.c
@@ -624,7 +624,7 @@ static void conditional_word_in_line( bool alr_ign,
  *
  **************************************************************************** */
 
-static void if_exists( tic_param_t pfield )
+static void if_exists( tic_bool_param_t pfield )
 {
     bool alr_ign = *pfield.bool_ptr;
     conditional_word_in_line( alr_ign, true, exists_in_current );
diff --git a/toke/macros.c b/toke/macros.c
index a3afb9e..b424d88 100644
--- a/toke/macros.c
+++ b/toke/macros.c
@@ -210,7 +210,7 @@ static void macro_recursion_error( tic_param_t pfield)
  *
  **************************************************************************** */
 
-typedef void (*vfunct)();  /*  Pointer to function returning void  */
+typedef void (*vfunct)(tic_param_t);  /*  Pointer to function returning void  */
 static vfunct sav_mac_funct ;
 
 
@@ -248,7 +248,7 @@ static void eval_mac_string( tic_param_t pfield)
     sav_mac_funct = *tic_found->funct;
     (*tic_found).funct = macro_recursion_error;
     (*tic_found).ign_func = macro_recursion_error;
-    push_source( mac_string_recovery, tic_found, false);
+    push_source( (void (*)(_PTR))mac_string_recovery, tic_found, false);
     report_multiline = false;  /*  Must be done AFTER call to push_source()
                                 *      because  report_multiline  is part of
                                 *      the state that  push_source()  saves.
@@ -455,7 +455,7 @@ static void print_if_mac_err( bool failure, char *func_cpy)
 /*  This pointer is exported to this file only  */
 extern tic_hdr_t *tokz_esc_vocab ;
 
-void add_user_macro( void)
+void add_user_macro( tic_param_t pfield)
 {
     char *macroname;
     char *macrobody;
