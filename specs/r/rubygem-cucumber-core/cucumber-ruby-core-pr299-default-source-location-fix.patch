From ea70ba63b9bebf7583246b2bcb15bd32558a6ab2 Mon Sep 17 00:00:00 2001
From: Luke Hill <lukehill_uk@hotmail.com>
Date: Fri, 8 Aug 2025 08:48:22 +0100
Subject: [PATCH 1/3] Add fix to default source location

---
 CHANGELOG.md                                   | 4 ++++
 lib/cucumber/core/test/action/defined.rb       | 2 +-
 spec/cucumber/core/test/action/defined_spec.rb | 2 +-
 spec/cucumber/core/test/location_spec.rb       | 4 ++--
 4 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/lib/cucumber/core/test/action.rb b/lib/cucumber/core/test/action.rb
index ca90d0a4..a0dc8e02 100644
--- a/lib/cucumber/core/test/action.rb
+++ b/lib/cucumber/core/test/action.rb
@@ -9,7 +9,7 @@
       class Action
         def initialize(location = nil, &block)
           raise ArgumentError, "Passing a block to execute the action is mandatory." unless block
-          @location = location ? location : Test::Location.new(*block.source_location)
+          @location = location ? location : Test::Location.new(*block.source_location[0..1])
           @block = block
           @timer = Timer.new
         end
diff --git a/spec/cucumber/core/test/action_spec.rb b/spec/cucumber/core/test/action_spec.rb
index 497f898c..8a5f5dcf 100644
--- a/spec/cucumber/core/test/action_spec.rb
+++ b/spec/cucumber/core/test/action_spec.rb
@@ -30,7 +30,7 @@
 
             it "returns the location of the block passed to the constructor" do
               action = Action.new(&block)
-              expect( action.location ).to eq Test::Location.new(*block.source_location)
+              expect( action.location ).to eq Test::Location.new(*block.source_location[0..1])
             end
           end
 
