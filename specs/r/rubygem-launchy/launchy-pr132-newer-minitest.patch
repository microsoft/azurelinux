diff --git a/spec/cli_spec.rb b/spec/cli_spec.rb
index 61c57c6..5913ba1 100644
--- a/spec/cli_spec.rb
+++ b/spec/cli_spec.rb
@@ -21,9 +21,9 @@ def cli_test( argv, env, exit_val, stderr_regex, stdout_regex )
     begin
       Launchy::Cli.new.run( argv, env )
     rescue SystemExit => se
-      se.status.must_equal exit_val
-      $stderr.string.must_match stderr_regex if stderr_regex
