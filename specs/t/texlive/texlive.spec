%package microtype
Provides: tex-microtype = %{tl_version}
License: LPPL-1.3c
Summary: Subliminal refinements towards typographical perfection
Version: svn66587
Requires: texlive-base
Requires: texlive-kpathsea-bin, tex-kpathsea
Requires: tex(keyval.sty)
