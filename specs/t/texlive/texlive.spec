License: GPL-1.0-or-later
Summary: A LaTeX package for configuring presentation fonts
Version: svn42428
Requires: texlive-base
Requires: texlive-kpathsea-bin, tex-kpathsea
Requires: tex(ifthen.sty)
Requires: tex(cmbright.sty)
