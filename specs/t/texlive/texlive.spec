%package hyphen-armenian
Provides: tex-hyphen-armenian = %{tl_version}
License: LPPL-1.3c
Summary: Armenian hyphenation patterns
Version: svn58652
Requires: texlive-base
Requires: texlive-kpathsea-bin, tex-kpathsea
Requires(post,postun): coreutils
Requires: texlive-hyphen-base
Requires: texlive-hyph-utf8

%description hyphen-armenian
Hyphenation patterns for Armenian for Unicode engines.

%post hyphen-armenian
if [ $1 -gt 0 ] ; then
sed --follow-symlinks -i '/armenian.*/d' %{_texdir}/texmf-dist/tex/generic/config/language.dat
echo "armenian loadhyph-hy.tex" >> %{_texdir}/texmf-dist/tex/generic/config/language.dat
sed --follow-symlinks -i '/\\addlanguage{armenian}.*/d' %{_texdir}/texmf-dist/tex/generic/config/language.def
echo "\addlanguage{armenian}{loadhyph-hy.tex}{}{1}{2}" >> %{_texdir}/texmf-dist/tex/generic/config/language.def
fi
:

%postun hyphen-armenian
if [ $1 == 0 ] ; then
sed --follow-symlinks -i '/armenian.*/d' %{_texdir}/texmf-dist/tex/generic/config/language.dat > /dev/null 2>&1
sed --follow-symlinks -i '/\\addlanguage{armenian}.*/d' %{_texdir}/texmf-dist/tex/generic/config/language.def > /dev/null 2>&1
fi
:

