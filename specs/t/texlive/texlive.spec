%package hyphen-macedonian
Summary: Macedonian hyphenation patterns
Version: svn58652
License: Borceux
Requires: texlive-base texlive-kpathsea
Requires: texlive-hyphen-base
Requires: texlive-hyph-utf8
Requires(post,postun): coreutils
Provides: tex(hyph-mk.tex) = %{tl_version}
Provides: tex(loadhyph-mk.tex) = %{tl_version}

%description hyphen-macedonian
Hyphenation patterns for Macedonian.

%post hyphen-macedonian
if [ $1 -gt 0 ] ; then
sed --follow-symlinks -i '/macedonian.*/d' %{_texdir}/texmf-dist/tex/generic/config/language.dat
echo "macedonian loadhyph-mk.tex" >> %{_texdir}/texmf-dist/tex/generic/config/language.dat
sed --follow-symlinks -i '/\\addlanguage{macedonian}.*/d' %{_texdir}/texmf-dist/tex/generic/config/language.def
echo "\addlanguage{macedonian}{loadhyph-mk.tex}{}{2}{2}" >> %{_texdir}/texmf-dist/tex/generic/config/language.def
fi
:

%postun hyphen-macedonian
if [ $1 == 0 ] ; then
sed --follow-symlinks -i '/macedonian.*/d' %{_texdir}/texmf-dist/tex/generic/config/language.dat > /dev/null 2>&1
sed --follow-symlinks -i '/\\addlanguage{macedonian}.*/d' %{_texdir}/texmf-dist/tex/generic/config/language.def > /dev/null 2>&1
fi
:

