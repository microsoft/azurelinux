Provides: tex(biolist.sty) = %{tl_version}
Provides: tex(boldline.sty) = %{tl_version}
Provides: tex(cassete.cls) = %{tl_version}
Provides: tex(classif2.sty) = %{tl_version}
Provides: tex(dline-shipunov.sty) = %{tl_version}
