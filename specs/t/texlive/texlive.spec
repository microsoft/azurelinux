%package hyph-utf8
Provides: tex-hyph-utf8 = %{tl_version}
License: CC0-1.0
Summary: Hyphenation patterns expressed in UTF-8
Version: svn61719
Requires: texlive-base
Requires: texlive-kpathsea-bin, tex-kpathsea
Provides: tex(conv-utf8-ec.tex) = %{tl_version}
