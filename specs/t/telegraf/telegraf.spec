URL:            %{gourl}
Source0:        %{gosource}
# Generated by go-vendor-tools
Source1:        %{archivename}-vendor.tar.bz2
Source2:        go-vendor-tools.toml
# AzL: declarative system user (created at install time, before files are unpacked).
Source3:        %{name}.sysusers
# AzL: optional environment file referenced by the unit (EnvironmentFile=-/etc/default/telegraf).
Source4:        %{name}.default

BuildRequires:  go-vendor-tools
# AzL: for the systemd unit + sysusers scriptlet macros below.
BuildRequires:  systemd-rpm-macros

# AzL: %%{?systemd_requires} adds correctly-ordered Requires(post/preun/postun) for the unit
# scriptlets; %%{?sysusers_requires_compat} pulls the pre-time deps %%sysusers_create_compat
