Vendor:         Microsoft Corporation
Distribution:   Azure Linux
%global srcname antlr4-runtime
%global pypiname antlr4-python3-runtime

Name:           python-%{srcname}
Version:        4.9.3
Release:        1%{?dist}
Summary:        ANTLR 4 runtime for Python 3

License:        BSD-3-Clause
URL:            https://www.antlr.org
Source0:        https://files.pythonhosted.org/packages/source/a/%{pypiname}/%{pypiname}-%{version}.tar.gz
# The PyPI sdist does not bundle a license file; ship the upstream BSD-3-Clause
# LICENSE.txt taken verbatim from the antlr/antlr4 repo at tag 4.9.3.
Source1:        LICENSE.txt

BuildArch:      noarch
BuildRequires:  python3-devel
BuildRequires:  python3-pip
BuildRequires:  python3-setuptools
BuildRequires:  python3-wheel
BuildRequires:  pyproject-rpm-macros

%global _description %{expand:
The ANTLR 4 Python 3 runtime is the library required to execute parsers and
lexers generated by the ANTLR 4 parser generator with the Python 3 target. It
provides the runtime classes (input streams, token streams, the prediction
engine, error handling, and parse-tree utilities) that generated recognizers
depend on.}

%description %_description

%package -n python3-%{srcname}
Summary:        %{summary}
%{?python_provide:%python_provide python3-%{srcname}}
# Allow dependants to require the upstream PyPI distribution name as well.
Provides:       python3-%{pypiname} = %{version}-%{release}

%description -n python3-%{srcname} %_description

%prep
%autosetup -n %{pypiname}-%{version}
# Place the separately-shipped license into the source tree so %%license can use it.
cp -p %{SOURCE1} LICENSE.txt

%generate_buildrequires
%pyproject_buildrequires

%build
%pyproject_wheel

%install
%pyproject_install
%pyproject_save_files antlr4

%files -n python3-%{srcname} -f %{pyproject_files}
%license LICENSE.txt
%doc README.txt
%{_bindir}/pygrun

%changelog
* Wed Jun 03 2026 Andy Zaugg <azaugg@linkedin.com> - 4.9.3-1
- Initial Azure Linux import from the source project (license: same as "License" tag).
- License verified.
